<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Study Hub - Nền tảng học tập thông minh dành cho học sinh THPT. Ghi chú, Flashcard, Lịch học, Nhóm học tập." />
  <title>@ViewData["Title"] - Study Hub</title>

  <!-- Bootstrap 5 CSS -->
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous" />

  <!-- Bootstrap Icons -->
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <!-- Study Hub Custom CSS -->
  <link rel="stylesheet" href="~/css/site.css" />

  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-wrapper">

  <!-- ── Sidebar Backdrop (Mobile) ── -->
  <div id="sidebar-backdrop"></div>

  <!-- ═══════════════════════════════════════════════
       SIDEBAR
  ═══════════════════════════════════════════════ -->
  <aside id="app-sidebar" role="navigation" aria-label="Điều hướng chính">

    <!-- Brand Header -->
    <div class="sidebar-brand">
      <div class="d-flex align-items-center gap-3">
        <div class="sidebar-brand-logo">
          <i class="bi bi-book-fill fs-5"></i>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2">
            <span class="fw-black text-slate-900 fs-6 tracking-tight">Study Hub</span>
            <span class="subject-badge"
                  style="background:#eef2ff;color:#4338ca;border:1px solid #c7d2fe;font-size:9px;">THPT</span>
          </div>
          <p class="text-xs text-slate-500 mb-0" style="font-size:11px;">Học tập &amp; Rèn luyện</p>
        </div>
      </div>
      <button id="sidebar-close-btn"
              class="btn-icon-sh d-lg-none"
              aria-label="Đóng menu">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav">
      <div class="sidebar-nav-label">Menu chính</div>

      <a asp-page="/Index" class="sidebar-nav-item" id="sidebar-nav-dashboard">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-grid-1x2 nav-icon"></i>
          <span>Tổng quan</span>
        </div>
      </a>

      <a asp-page="/Notes" class="sidebar-nav-item" id="sidebar-nav-notes">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-file-earmark-text nav-icon"></i>
          <span>Ghi chú &amp; Tài liệu</span>
        </div>
        <span class="sidebar-nav-badge">8</span>
      </a>

      <a asp-page="/Flashcards" class="sidebar-nav-item" id="sidebar-nav-flashcards">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-layers nav-icon"></i>
          <span>Thẻ ghi nhớ (Flashcard)</span>
        </div>
        <span class="sidebar-nav-badge">5</span>
      </a>

      <a asp-page="/Calendar" class="sidebar-nav-item" id="sidebar-nav-calendar">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-calendar3 nav-icon"></i>
          <span>Lịch học cá nhân</span>
        </div>
        <span class="sidebar-nav-badge">6</span>
      </a>

      <a asp-page="/Groups" class="sidebar-nav-item" id="sidebar-nav-groups">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-people nav-icon"></i>
          <span>Nhóm học tập</span>
        </div>
        <span class="sidebar-nav-badge">3</span>
      </a>

      <a asp-page="/Grades" class="sidebar-nav-item" id="sidebar-nav-grades">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-mortarboard nav-icon"></i>
          <span>Điểm số &amp; Mục tiêu</span>
        </div>
        <span class="sidebar-nav-badge">8.4</span>
      </a>

      <a asp-page="/Settings" class="sidebar-nav-item" id="sidebar-nav-settings">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-gear nav-icon"></i>
          <span>Cài đặt hệ thống</span>
        </div>
      </a>
    </nav>

    <!-- Streak Card -->
    <div class="streak-card">
      <div class="d-flex align-items-center gap-2">
        <div class="streak-icon-wrap">
          <i class="bi bi-fire fs-5" style="color:#d97706;"></i>
        </div>
        <div>
          <p class="mb-0 fw-bold" style="font-size:12px; color:var(--sh-slate-900);">Chuỗi học tập</p>
          <p class="mb-0" style="font-size:11px; color:var(--sh-amber-800); font-weight:500;">5 ngày liên tiếp!</p>
        </div>
      </div>
      <span class="streak-badge">🔥 x5</span>
    </div>

    <!-- User Profile -->
    <div class="sidebar-user">
      <div class="sidebar-user-card">
        <div class="d-flex align-items-center gap-2 overflow-hidden">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80"
               alt="Nguyễn Minh Anh"
               class="sidebar-user-avatar" />
          <div class="overflow-hidden">
            <p class="mb-0 fw-bold truncate" style="font-size:12px; color:var(--sh-slate-900);">Nguyễn Minh Anh</p>
            <p class="mb-0 truncate" style="font-size:10px; color:var(--sh-slate-500);">Lớp 11A1 (Chuyên Tự Nhiên)</p>
          </div>
        </div>
        <button id="sidebar-logout-btn"
                class="btn-icon-sh danger"
                title="Đăng xuất">
          <i class="bi bi-box-arrow-right"></i>
        </button>
      </div>
    </div>
  </aside>
  <!-- ── /SIDEBAR ── -->

  <!-- ═══════════════════════════════════════════════
       MAIN CONTENT AREA
  ═══════════════════════════════════════════════ -->
  <div class="main-content-offset d-flex flex-column min-vh-100">

    <!-- ── TOP BAR ── -->
    <header id="app-topbar">
      <!-- Left: Hamburger + Title -->
      <div class="d-flex align-items-center gap-3">
        <button id="topbar-hamburger-btn"
                class="btn-icon-sh d-lg-none"
                title="Mở menu"
                aria-label="Mở menu điều hướng">
          <i class="bi bi-list fs-5"></i>
        </button>
        <div>
          <h1 class="mb-0 fw-bold tracking-tight" style="font-size:16px; color:var(--sh-slate-900);">
            @(ViewData["PageTitle"] ?? "Bảng điều khiển học tập")
          </h1>
          <p class="mb-0 d-none d-sm-block" style="font-size:11px; color:var(--sh-slate-500);">
            @Html.Raw(ViewData["PageSubtitle"] ?? "Tổng hợp tiến độ &amp; hoạt động hôm nay")
          </p>
        </div>
      </div>

      <!-- Right: Search + Actions + User -->
      <div class="d-flex align-items-center gap-2 gap-sm-3">

        <!-- Search Bar (md+) -->
        <div class="topbar-search d-none d-md-block">
          <i class="bi bi-search search-icon" style="font-size:13px;"></i>
          <input id="topbar-search-input"
                 type="text"
                 placeholder="Tìm ghi chú, thẻ, sự kiện..." />
        </div>

        <!-- Quick Add Dropdown -->
        <div class="position-relative">
          <button id="topbar-quick-add-btn"
                  class="btn-primary-sh"
                  type="button">
            <i class="bi bi-plus-lg"></i>
            <span class="d-none d-sm-inline">Tạo mới</span>
          </button>
          <div id="quick-add-menu"
               class="sh-dropdown position-absolute end-0 mt-2"
               style="display:none; min-width:210px; z-index:1050;">
            <div class="px-3 py-1"
                 style="font-size:10px;font-weight:700;color:var(--sh-slate-400);text-transform:uppercase;letter-spacing:.06em;">
              Thêm nhanh
            </div>
            <a asp-page="/Notes" class="sh-dropdown-item">
              <i class="bi bi-file-earmark-plus" style="color:var(--sh-indigo-600);"></i>
              Thêm ghi chú mới
            </a>
            <a asp-page="/Flashcards" class="sh-dropdown-item">
              <i class="bi bi-layers" style="color:var(--sh-emerald-600);"></i>
              Tạo bộ Flashcard
            </a>
            <a asp-page="/Calendar" class="sh-dropdown-item">
              <i class="bi bi-calendar-plus" style="color:var(--sh-amber-600);"></i>
              Lên lịch học / Kiểm tra
            </a>
            <div style="height:1px;background:var(--sh-slate-100);margin:4px 0;"></div>
            <a asp-page="/Grades" class="sh-dropdown-item">
              <i class="bi bi-journal-plus" style="color:var(--sh-rose-600);"></i>
              Nhập điểm bài thi
            </a>
          </div>
        </div>

        <!-- Notifications -->
        <div class="position-relative">
          <button id="topbar-notifications-btn"
                  class="btn-icon-sh position-relative"
                  title="Thông báo">
            <i class="bi bi-bell fs-6"></i>
            <span class="notif-dot" id="notif-indicator"></span>
          </button>

          <div id="notifications-menu"
               class="sh-dropdown position-absolute end-0 mt-2"
               style="display:none; width:340px; z-index:1050;">
            <div class="d-flex align-items-center justify-content-between px-3 py-2"
                 style="border-bottom:1px solid var(--sh-slate-100);">
              <div class="d-flex align-items-center gap-2">
                <span class="fw-bold" style="font-size:12px;">Thông báo học tập</span>
                <span id="notif-count-badge"
                      class="px-2 py-0 rounded-full fw-bold"
                      style="font-size:10px;background:var(--sh-rose-100);color:var(--sh-rose-700);">2 mới</span>
              </div>
              <button id="mark-all-read-btn"
                      class="btn-icon-sh"
                      style="font-size:11px; width:auto; height:auto; padding:4px 8px; color:var(--sh-indigo-600);">
                <i class="bi bi-check-all me-1"></i>Đã xem tất cả
              </button>
            </div>

            <div style="max-height:280px; overflow-y:auto;">
              <div class="p-3 d-flex gap-3 notif-item-unread"
                   style="font-size:12px; background:rgba(79,70,229,0.04);">
                <div class="p-2 rounded-3 flex-shrink-0" style="background:var(--sh-rose-50); color:var(--sh-rose-600); height:fit-content;">
                  <i class="bi bi-alarm"></i>
                </div>
                <div class="flex-grow-1">
                  <p class="mb-0 fw-semibold" style="color:var(--sh-slate-900);">Kiểm tra 15 phút Vật lý</p>
                  <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500);">Thứ Sáu, 11/09 lúc 08:45</p>
                </div>
                <span class="notif-dot-item flex-shrink-0 mt-2"
                      style="width:8px;height:8px;background:var(--sh-indigo-600);border-radius:50%;display:block;"></span>
              </div>
              <div class="p-3 d-flex gap-3 notif-item-unread"
                   style="font-size:12px; background:rgba(79,70,229,0.04); border-top:1px solid var(--sh-slate-100);">
                <div class="p-2 rounded-3 flex-shrink-0" style="background:var(--sh-indigo-50); color:var(--sh-indigo-600); height:fit-content;">
                  <i class="bi bi-people"></i>
                </div>
                <div class="flex-grow-1">
                  <p class="mb-0 fw-semibold" style="color:var(--sh-slate-900);">Nhóm Toán Chuyên sâu 11A1</p>
                  <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500);">Nguyễn Minh Anh vừa đăng thông báo mới</p>
                </div>
                <span class="notif-dot-item flex-shrink-0 mt-2"
                      style="width:8px;height:8px;background:var(--sh-indigo-600);border-radius:50%;display:block;"></span>
              </div>
              <div class="p-3 d-flex gap-3"
                   style="font-size:12px; border-top:1px solid var(--sh-slate-100);">
                <div class="p-2 rounded-3 flex-shrink-0" style="background:var(--sh-emerald-50); color:var(--sh-emerald-600); height:fit-content;">
                  <i class="bi bi-check-circle"></i>
                </div>
                <div class="flex-grow-1">
                  <p class="mb-0 fw-semibold" style="color:var(--sh-slate-700);">Nhắc nhở học tập: Lượng giác</p>
                  <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500);">Hoàn thành 1 thẻ flashcard còn dở</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- User Avatar -->
        <div class="d-flex align-items-center gap-2 ps-2"
             style="border-left:1px solid var(--sh-slate-200);">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80"
               alt="Avatar"
               class="rounded-circle object-fit-cover"
               style="width:32px;height:32px;border:2px solid var(--sh-indigo-100);" />
          <div class="d-none d-xl-block">
            <p class="mb-0 fw-bold" style="font-size:12px; color:var(--sh-slate-900);">Nguyễn Minh Anh</p>
            <p class="mb-0" style="font-size:10px; color:var(--sh-slate-500);">Lớp 11A1</p>
          </div>
        </div>
      </div>
    </header>
    <!-- ── /TOP BAR ── -->

    <!-- ── PAGE CONTENT ── -->
    <main class="flex-grow-1 p-3 p-sm-4 p-lg-5">
      @RenderBody()
    </main>
    <!-- ── /PAGE CONTENT ── -->

  </div>
  <!-- ── /MAIN CONTENT AREA ── -->

  <!-- ── Toast Container ── -->
  <div id="toast-container" class="sh-toast-container" aria-live="polite"></div>

  <!-- ── Logout Confirm Modal ── -->
  <div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="logoutModalLabel" style="font-size:14px;">
            Đăng xuất khỏi Study Hub?
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" style="font-size:12px; color:var(--sh-slate-600);">
          Bạn có chắc chắn muốn đăng xuất khỏi phiên học tập hiện tại? Dữ liệu ghi nhớ của bạn đã được lưu.
        </div>
        <div class="modal-footer gap-2">
          <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Ở lại</button>
          <button type="button" id="confirm-logout-btn"
                  class="btn-primary-sh"
                  style="background:var(--sh-rose-600);">
            <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Delete Confirm Modal ── -->
  <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" style="font-size:14px;">Xác nhận xóa</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p id="delete-confirm-message" style="font-size:12px; color:var(--sh-slate-600);">
            Bạn có chắc muốn xóa mục này?
          </p>
        </div>
        <div class="modal-footer gap-2">
          <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy bỏ</button>
          <button type="button" id="confirm-delete-btn"
                  class="btn-primary-sh"
                  style="background:var(--sh-rose-600);">
            <i class="bi bi-trash3 me-1"></i>Xóa
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmVl6dNqyPMFKbzVbQq+rS4BVQP"
          crossorigin="anonymous"></script>

  <!-- Study Hub JS -->
  <script src="~/js/site.js"></script>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
