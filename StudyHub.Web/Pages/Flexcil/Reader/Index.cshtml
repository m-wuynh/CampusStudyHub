@page "{id:int}"
@model StudyHub.Web.Pages.Flexcil.Reader.IndexModel
@{
	Layout = null;
	ViewData["Title"] = Model.Document?.FileName;
}
<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="pdf-url"
          content="@Model.Document?.FilePath" />

	<meta name="document-id"
		  content="@Model.Document?.Id" />

    <title>
        @Model.Document?.FileName - Study Hub
    </title>

    <link rel="stylesheet"
          href="~/css/flexcil/reader/reader.css" />

	<link rel="stylesheet"
		  href="~/css/flexcil/reader/annotation.css" />

	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>

<body>
	@Html.AntiForgeryToken()
<div class="flexcil-reader">

    <!-- ================= TOOLBAR ================= -->

    <header class="reader-toolbar">

        <!-- LEFT -->

        <div class="reader-toolbar-left">

            <a asp-page="/Flexcil/Documents/Index"
               class="reader-button"
               title="Quay lại">

                <i class="bi bi-arrow-left"></i>

            </a>

            <span class="document-name">
                @Model.Document?.FileName
            </span>

        </div>


        <!-- CENTER -->

        <div class="reader-toolbar-center">

            <button type="button"
                    id="previousPage"
                    class="reader-button"
                    title="Trang trước">

                <i class="bi bi-chevron-left"></i>

            </button>


            <div class="page-info">

                <input type="number"
                       id="pageNumber"
                       value="1"
                       min="1" />

                <span>/</span>

                <span id="pageCount">
                    0
                </span>

            </div>


            <button type="button"
                    id="nextPage"
                    class="reader-button"
                    title="Trang sau">

                <i class="bi bi-chevron-right"></i>

            </button>

        </div>


        <!-- RIGHT -->

        <div class="reader-toolbar-right">

            <button type="button"
                    id="zoomOut"
                    class="reader-button"
                    title="Thu nhỏ">

                <i class="bi bi-dash"></i>

            </button>


            <span id="zoomLevel"
                  class="zoom-level">
                100%
            </span>


            <button type="button"
                    id="zoomIn"
                    class="reader-button"
                    title="Phóng to">

                <i class="bi bi-plus"></i>

            </button>


            <button type="button"
                    id="fitWidth"
                    class="reader-button"
                    title="Vừa chiều rộng">

                <i class="bi bi-arrows-angle-expand"></i>

            </button>

				<button type="button"
						id="penTool"
						class="reader-button"
						title="Bút">

					<i class="bi bi-pencil"></i>

				</button>

				<button type="button"
						id="eraserTool"
						class="reader-button"
						title="Tẩy">

					<i class="bi bi-eraser"></i>

				</button>

				<button type="button"
						id="highlightTool"
						class="reader-button"
						title="Highlight">

					<i class="bi bi-highlighter"></i>

				</button>

				<button type="button"
						id="undoTool"
						class="reader-button"
						title="Hoàn tác"
						disabled>
					<i class="bi bi-arrow-counterclockwise"></i>
				</button>

				<button type="button"
						id="redoTool"
						class="reader-button"
						title="Làm lại"
						disabled>
					<i class="bi bi-arrow-clockwise"></i>
				</button>
        </div>

    </header>


    <!-- ================= READER ================= -->

    <main class="reader-content">

        <!-- Loading -->

        <div id="pdfLoading"
             class="pdf-loading">

            <div class="loading-spinner"></div>

            <span>
                Đang tải tài liệu...
            </span>

        </div>


        <!-- Error -->

        <div id="pdfError"
             class="pdf-error"
             hidden>

            <div class="pdf-error-icon">
                <i class="bi bi-file-earmark-x"></i>
            </div>

            <h3>
                Không thể mở tài liệu
            </h3>

            <p id="pdfErrorMessage">
                Đã xảy ra lỗi khi tải PDF.
            </p>

        </div>


        <!-- PDF -->

        <div id="pdfContainer"
             class="pdf-container">

        </div>

    </main>

</div>


<script type="module"
        src="~/js/flexcil/pdf/pdf-reader.js">
</script>

</body>

</html>
