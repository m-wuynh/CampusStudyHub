@page "/Groups/{groupId}"
@model GroupDetailsModel
@{
    ViewData["Title"] = Model.Group.Name;
    ViewData["PageTitle"] = "Chi tiết nhóm học tập";
    ViewData["PageSubtitle"] = "Trao đổi, học tập và chia sẻ tài liệu cùng các thành viên";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div id="group-details-page" data-group-id="@Model.Group.Id" style="max-width:1180px;margin:0 auto;">
  <a asp-page="/Groups" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-3"
     style="font-size:12px;color:var(--sh-slate-600);">
    <i class="bi bi-arrow-left"></i>Quay lại danh sách nhóm
  </a>

  <section class="sh-card overflow-hidden mb-4">
    <div class="p-4 p-md-5" style="background:linear-gradient(135deg,#eef2ff,#e0e7ff);">
      <div class="d-flex flex-column flex-md-row justify-content-between gap-4">
        <div>
          <span class="subject-badge @Model.Group.SubjectCssClass">@Model.Group.Subject</span>
          <h1 class="fw-black mt-3 mb-2" style="font-size:clamp(22px,4vw,32px);color:var(--sh-slate-900);">
            @Model.Group.Name
          </h1>
          <p class="mb-0" style="max-width:720px;font-size:13px;color:var(--sh-slate-600);line-height:1.7;">
            @Model.Group.Description
          </p>
        </div>
        <div class="d-flex align-items-start gap-2 flex-md-column">
          <span class="subject-badge" style="background:#fff;color:var(--sh-indigo-700);border:1px solid var(--sh-indigo-200);">
            <i class="bi bi-people me-1"></i>@Model.Group.MemberCount thành viên
          </span>
          <span class="subject-badge" style="background:var(--sh-emerald-50);color:var(--sh-emerald-700);border:1px solid var(--sh-emerald-200);">
            <i class="bi bi-check-circle me-1"></i>Đã tham gia
          </span>
        </div>
      </div>
    </div>
  </section>

  <div class="row g-4">
    <div class="col-12 col-lg-8">
      <section class="sh-card p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h2 class="fw-bold mb-0" style="font-size:15px;color:var(--sh-slate-900);">
            <i class="bi bi-megaphone me-2" style="color:var(--sh-indigo-600);"></i>Thông báo nhóm
          </h2>
          <button type="button" class="btn-secondary-sh" onclick="showToast('Tính năng đăng thông báo sẽ được bổ sung!', 'info')">
            <i class="bi bi-plus-lg"></i>Đăng thông báo
          </button>
        </div>

        <article class="p-3 rounded-3 mb-3" style="background:var(--sh-indigo-50);border:1px solid var(--sh-indigo-200);">
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                 style="width:32px;height:32px;background:var(--sh-indigo-600);color:#fff;font-size:11px;">MA</div>
            <div>
              <p class="fw-bold mb-0" style="font-size:12px;color:var(--sh-indigo-900);">Nguyễn Minh Anh</p>
              <p class="mb-0" style="font-size:10px;color:var(--sh-slate-500);">Trưởng nhóm · hôm nay</p>
            </div>
          </div>
          <h3 class="fw-bold mb-1" style="font-size:13px;color:var(--sh-indigo-900);">Lịch học nhóm tuần này</h3>
          <p class="mb-0" style="font-size:12px;color:var(--sh-indigo-700);line-height:1.6;">
            Cả nhóm họp vào Chủ nhật lúc 14:00 tại phòng học nhóm A12. Mọi người chuẩn bị nội dung đang vướng để cùng trao đổi.
          </p>
        </article>

        <article class="p-3 rounded-3" style="background:var(--sh-slate-50);border:1px solid var(--sh-slate-200);">
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                 style="width:32px;height:32px;background:var(--sh-emerald-600);color:#fff;font-size:11px;">TB</div>
            <div>
              <p class="fw-bold mb-0" style="font-size:12px;color:var(--sh-slate-900);">Trần Văn Bình</p>
              <p class="mb-0" style="font-size:10px;color:var(--sh-slate-500);">Thành viên · 2 ngày trước</p>
            </div>
          </div>
          <h3 class="fw-bold mb-1" style="font-size:13px;color:var(--sh-slate-900);">Tài liệu ôn tập mới</h3>
          <p class="mb-0" style="font-size:12px;color:var(--sh-slate-600);line-height:1.6;">
            Mình đã tổng hợp bài tập theo chủ đề và đáp án. Mọi người xem trong phần tài liệu chung nhé.
          </p>
        </article>
      </section>

      <section class="sh-card p-4">
        <h2 class="fw-bold mb-3" style="font-size:15px;color:var(--sh-slate-900);">
          <i class="bi bi-calendar-check me-2" style="color:var(--sh-emerald-600);"></i>Lịch hoạt động
        </h2>
        <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background:var(--sh-slate-50);">
          <div class="text-center rounded-3 px-3 py-2" style="background:#fff;border:1px solid var(--sh-slate-200);">
            <strong class="d-block" style="font-size:18px;color:var(--sh-indigo-700);">14:00</strong>
            <span style="font-size:10px;color:var(--sh-slate-500);">Chủ nhật</span>
          </div>
          <div>
            <p class="fw-bold mb-1" style="font-size:13px;color:var(--sh-slate-900);">Buổi học nhóm hàng tuần</p>
            <p class="mb-0" style="font-size:11px;color:var(--sh-slate-500);">Phòng học nhóm A12 · Thời lượng 90 phút</p>
          </div>
        </div>
      </section>
    </div>

    <div class="col-12 col-lg-4">
      <section class="sh-card p-4 mb-4">
        <h2 class="fw-bold mb-3" style="font-size:15px;color:var(--sh-slate-900);">Thành viên</h2>
        @foreach (var member in new[] {
          new { Initials = "MA", Name = "Nguyễn Minh Anh", Role = "Trưởng nhóm", Color = "var(--sh-indigo-600)" },
          new { Initials = "TB", Name = "Trần Văn Bình", Role = "Thành viên", Color = "var(--sh-emerald-600)" },
          new { Initials = "LC", Name = "Lê Thị Cẩm", Role = "Thành viên", Color = "var(--sh-amber-500)" }
        })
        {
          <div class="d-flex align-items-center gap-2 py-2">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                 style="width:34px;height:34px;background:@member.Color;color:#fff;font-size:10px;">@member.Initials</div>
            <div>
              <p class="fw-bold mb-0" style="font-size:12px;color:var(--sh-slate-900);">@member.Name</p>
              <p class="mb-0" style="font-size:10px;color:var(--sh-slate-500);">@member.Role</p>
            </div>
          </div>
        }
        @if (Model.Group.MemberCount > 3)
        {
          <p class="mb-0 mt-2" style="font-size:11px;color:var(--sh-slate-500);">
            Và @(Model.Group.MemberCount - 3) thành viên khác
          </p>
        }
      </section>

      <section class="sh-card p-4">
        <h2 class="fw-bold mb-3" style="font-size:15px;color:var(--sh-slate-900);">Tài liệu chung</h2>
        <a asp-page="/Notes" class="d-flex align-items-center gap-2 p-3 rounded-3 text-decoration-none mb-2"
           style="background:var(--sh-slate-50);border:1px solid var(--sh-slate-200);">
          <i class="bi bi-file-earmark-text" style="color:var(--sh-indigo-600);"></i>
          <span style="font-size:11px;color:var(--sh-slate-700);">Ghi chú và tài liệu nhóm</span>
        </a>
        <a asp-page="/Flashcards" class="d-flex align-items-center gap-2 p-3 rounded-3 text-decoration-none"
           style="background:var(--sh-slate-50);border:1px solid var(--sh-slate-200);">
          <i class="bi bi-layers" style="color:var(--sh-emerald-600);"></i>
          <span style="font-size:11px;color:var(--sh-slate-700);">Bộ thẻ ghi nhớ</span>
        </a>
      </section>
    </div>
  </div>

  <button id="group-chat-launcher" class="group-chat-launcher" type="button"
          aria-controls="group-chatbox" aria-expanded="false">
    <i class="bi bi-chat-dots-fill"></i><span>Chat nhóm</span>
  </button>

  <aside id="group-chatbox" class="group-chatbox" aria-label="Chat nhóm" hidden>
    <header class="group-chatbox-header">
      <div>
        <strong>Chat nhóm</strong>
        <span><i class="group-chat-online-dot"></i>Đang hoạt động</span>
      </div>
      <button id="group-chat-close" type="button" aria-label="Đóng chat"><i class="bi bi-x-lg"></i></button>
    </header>
    <div id="group-chatbox-messages" class="group-chat-messages" aria-live="polite"></div>
    <form id="group-chatbox-form" class="group-chatbox-form">
      <textarea id="group-chatbox-input" rows="1" maxlength="1000"
                placeholder="Nhập tin nhắn..." aria-label="Nội dung tin nhắn"></textarea>
      <button type="submit" aria-label="Gửi tin nhắn"><i class="bi bi-send-fill"></i></button>
    </form>
  </aside>
</div>

@section Scripts {
  <script src="~/js/group-details.js" asp-append-version="true"></script>
}
