@model StudyHub.Web.ViewModels.Grades.GradesSubjectViewModel
@using System.Globalization
@using StudyHub.BLL.Constants
@using StudyHub.BLL.Services.Grades
@{
    var data = Model.Data;
    var pageData = data.Page;
    var subject = data.Subject;
    var ladder = data.Ladder;
    var subjectName = subject?.SubjectName ?? ladder?.SubjectName ?? "Môn học";
    var subjectId = subject?.UserSubjectId ?? ladder!.UserSubjectId;
    var inv = CultureInfo.InvariantCulture;

    ViewData["Title"]        = $"Chi tiết môn · {subjectName}";
    ViewData["PageTitle"]    = "Điểm số & Mục tiêu học tập";
    ViewData["PageSubtitle"] = "Chi tiết môn: điểm theo cột, điểm cần đạt, mục tiêu và hoạt động";
    Layout = "_GradesLayout";
    ViewData["GradesNav"] = "grades";
    ViewData["NavGradeBookId"] = pageData.SelectedGradeBookId;
    ViewData["CurrentGradeBookId"] = pageData.SelectedGradeBookId;

    var shownAvg = GradeCalculator.RoundForDisplay(subject?.CurrentAverage10);
    var avgBand = shownAvg is null ? "is-empty"
        : shownAvg < GradeConstants.ScoreWarningBelow ? "is-low"
        : shownAvg < GradeConstants.ScoreGoodFrom ? "is-mid"
        : "is-high";
    var totalWeight = pageData.Columns.Sum(c => c.Weight);
    var coveredWeight = totalWeight - data.RemainingWeight;
    var coveredPct = totalWeight > 0 ? (int)Math.Floor(coveredWeight / totalWeight * 100) : 0;
    var defaultTarget = data.FocusGoal?.TargetValue ?? 8.0m;
}

<nav aria-label="breadcrumb" class="sv-breadcrumb mb-2">
    <a asp-controller="Grades" asp-action="Index" asp-route-gradeBookId="@pageData.SelectedGradeBookId">Bảng điểm</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">@subjectName</span>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h3 class="sv-section-title mb-2">@subjectName</h3>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (subject != null) {
                <span class="sv-pill is-neutral">Hệ số môn @(subject.CreditWeight.ToString("0.##"))</span>
                <span class="sv-score-pill @avgBand">ĐTB @(shownAvg?.ToString("0.0") ?? "chưa có")</span>
            }
            @if (data.FocusGoal != null) {
                <span class="sv-pill">Mục tiêu đang theo @(data.FocusGoal.TargetValue.ToString("0.0"))</span>
            }
            @if (pageData.GradeBook != null && subject != null) {
                <span class="sv-pill is-neutral">@pageData.GradeBook.Name</span>
            }
        </div>
    </div>
    @if (ladder != null) {
        <a asp-controller="Grades" asp-action="Journey" asp-route-id="@subjectId" class="btn-secondary-sh">
            <i class="bi bi-graph-up me-1"></i> Xem hành trình
        </a>
    }
</div>

@if (subject == null) {
    <div class="sh-card p-4 mb-4" style="font-size:13px; color:var(--sh-slate-600);">
        <i class="bi bi-info-circle me-1"></i>
        Môn này không thuộc sổ điểm nào (dữ liệu cũ) nên không có bảng điểm. Bạn vẫn xem và chỉnh được các mục tiêu bên dưới.
    </div>
} else {
    <div class="sv-detail-grid mb-4">
        <!-- Điểm theo cột -->
        <section class="sv-card">
            <h4 class="sv-card-title">Điểm theo cột đánh giá</h4>
            <div class="table-responsive">
                <table class="table align-middle mb-3 sv-detail-table">
                    <thead>
                        <tr><th scope="col">Cột</th><th scope="col">Hệ số</th><th scope="col">Điểm</th><th scope="col" class="text-end">Điểm × hệ số</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var column in pageData.Columns) {
                            var scores = subject.Entries.Where(e => e.GradeColumnId == column.GradeColumnId).Select(e => e.Score).ToList();
                            <tr>
                                <td class="fw-semibold">@column.Name</td>
                                <td>@(column.Weight.ToString("0.##"))</td>
                                @if (scores.Any()) {
                                    <td>@(string.Join("; ", scores.Select(x => x.ToString("0.##", inv))))</td>
                                    <td class="text-end">@(scores.Sum(x => x * column.Weight).ToString("0.##", inv))</td>
                                } else {
                                    <td class="text-muted">Chưa có điểm</td>
                                    <td class="text-end text-muted">—</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (data.KnownWeight > 0) {
                <div class="sv-formula mb-3">
                    ĐTB = @(data.KnownWeightedSum.ToString("0.##", inv)) / @(data.KnownWeight.ToString("0.##", inv))
                    = <strong>@(subject.CurrentAverage10?.ToString("0.00", inv))</strong>
                    → hiển thị <strong>@(shownAvg?.ToString("0.0", inv))</strong>
                </div>
            } else {
                <div class="sv-formula mb-3">Môn chưa có điểm nào.</div>
            }
            <div class="d-flex justify-content-between mb-1" style="font-size:12px; color:var(--sh-slate-500);">
                <span>Cột đã có điểm</span>
                <span>@(coveredWeight.ToString("0.##", inv)) / @(totalWeight.ToString("0.##", inv)) hệ số (@(coveredPct)%)</span>
            </div>
            <div class="sv-progress"><span class="is-violet" style="width:@(coveredPct)%;"></span></div>
        </section>

        <!-- Tính điểm cần đạt -->
        <section class="sv-card">
            <h4 class="sv-card-title">Cần bao nhiêu điểm ở các cột còn trống?</h4>
            @if (data.RemainingWeight > 0) {
                <div id="required-score-calc"
                     data-sum="@(data.KnownWeightedSum.ToString(inv))"
                     data-known="@(data.KnownWeight.ToString(inv))"
                     data-remaining="@(data.RemainingWeight.ToString(inv))">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <label for="required-target" class="mb-0" style="font-size:13px; color:var(--sh-slate-600);">Muốn đạt ĐTB</label>
                        <input id="required-target" type="number" min="0.1" max="10" step="0.1" class="sh-input" style="width:96px;"
                               value="@(defaultTarget.ToString("0.0", inv))" />
                    </div>
                    <div class="sv-required-box mb-3" aria-live="polite">
                        <div class="sv-required-label">Điểm tối thiểu ở mỗi cột còn trống</div>
                        <div class="sv-required-value" id="required-score-value">—</div>
                        <div class="sv-required-note" id="required-score-note"></div>
                    </div>
                    <div class="border-top pt-3">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <label for="trial-score" class="mb-0" style="font-size:13px; color:var(--sh-slate-600);">Thử điểm cho các cột còn trống</label>
                            <input id="trial-score" type="number" min="0" max="10" step="0.5" class="sh-input" style="width:96px;"
                                   value="@(defaultTarget.ToString("0.0", inv))" />
                        </div>
                        <div style="font-size:13px;" aria-live="polite">
                            ĐTB dự kiến <strong id="trial-avg">—</strong> → hiển thị <strong id="trial-shown">—</strong>
                            <span id="trial-status" class="sv-pill is-neutral ms-1"></span>
                        </div>
                    </div>
                    <p class="mt-3 mb-0" style="font-size:11px; color:var(--sh-slate-500);">
                        Tính theo đúng công thức của bảng điểm: Σ(điểm × hệ số) / Σ hệ số, làm tròn 2 chữ số, so mục tiêu bằng ĐTB làm tròn 1 chữ số.
                        Giả định mỗi cột còn trống có một điểm.
                    </p>
                </div>
            } else {
                <p class="mb-0" style="font-size:13px; color:var(--sh-slate-600);">
                    Môn đã có điểm ở mọi cột. ĐTB chỉ thay đổi khi bạn thêm hoặc sửa điểm trong
                    <a asp-controller="Grades" asp-action="Index" asp-route-gradeBookId="@pageData.SelectedGradeBookId">Bảng điểm</a>.
                </p>
            }
        </section>
    </div>
}

<!-- Mục tiêu và hoạt động của môn -->
@if (ladder != null) {
    <partial name="Partials/_GoalLadderPartial" model="ladder" />
} else {
    <div class="sh-card text-center py-5 px-3 mb-4">
        <div style="font-size:40px; margin-bottom:8px;">🎯</div>
        <h4 class="fw-bold" style="font-size:15px; color:var(--sh-slate-800);">Môn này chưa có mục tiêu</h4>
        <p class="text-muted" style="font-size:13px;">Đặt mục tiêu gốc để theo dõi tiến độ và hành trình của môn.</p>
        <button type="button" class="btn-primary-sh" onclick="openAddGoalForSubject(@subjectId)">
            <i class="bi bi-trophy me-1"></i> Đặt mục tiêu
        </button>
    </div>
}

<!-- ═══ MODALS ═══ -->
<partial name="Partials/_GoalModals" model="pageData" />

<!-- ═══ JSON SERVER STATE ═══ -->
<partial name="Partials/_GradesJsonStatePartial" model="pageData" />
