@model StudyHub.BLL.DTOs.YearGradeSummaryDto

<!-- ── Stats Row ── -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card text-center">
      <div class="fw-black" style="font-size:32px; color:var(--sh-indigo-600);" id="stat-avg">@(Model.CurrentAverage10?.ToString("0.0") ?? "-")</div>
      <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">ĐTB Chung</p>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card text-center">
      <div class="fw-black" style="font-size:32px; color:var(--sh-emerald-600);">@(Model.HighestScore?.ToString("0.0") ?? "-")</div>
      <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Điểm cao nhất</p>
      <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-slate-400);">@(Model.HighestSubjectName)</p>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card text-center">
      <div class="fw-black" style="font-size:32px; color:var(--sh-amber-600);">@(Model.LowestScore?.ToString("0.0") ?? "-")</div>
      <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Điểm thấp nhất</p>
      <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-slate-400);">@(Model.LowestSubjectName)</p>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card text-center">
      <div class="fw-black" style="font-size:32px; color:var(--sh-rose-600);">@Model.SubjectsBelowTarget</div>
      <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Môn dưới mục tiêu</p>
      <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-rose-600);">Cần cải thiện</p>
    </div>
  </div>
</div>

