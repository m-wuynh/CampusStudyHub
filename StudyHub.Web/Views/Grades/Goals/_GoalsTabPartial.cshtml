@model StudyHub.BLL.DTOs.GradesPageDto
@using StudyHub.BLL.DTOs

<!-- ═══ GOALS TAB ═══ -->
<div id="goals-tab" style="display:none;">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
      <h3 class="sv-section-title">Mục tiêu học tập – Goal Ladder</h3>
      <p class="sv-section-sub">Thiết lập mục tiêu học tập cố định và theo dõi tiến độ thực hiện theo từng môn học.</p>
    </div>
    @if(Model.SubjectDetails.Any() || Model.GoalLadders.Any() || (Model.AllSubjects != null && Model.AllSubjects.Any())) {
      <div class="d-flex gap-2 flex-wrap">
        @if (Model.GoalLadders.Any(l => !l.IsDetached && l.HasBaseGoal)) {
          <button type="button" class="btn-secondary-sh" data-bs-toggle="modal" data-bs-target="#addGoalModal" onclick="resetAddGoalModal('rung')">
            <i class="bi bi-bar-chart-steps me-1"></i> Thêm bậc
          </button>
        }
        <button type="button" class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addGoalModal" onclick="resetAddGoalModal('base')">
          <i class="bi bi-plus-lg me-1"></i> Đặt mục tiêu mới
        </button>
      </div>
    }
  </div>

  @if (!Model.GoalLadders.Any()) {
    <div class="sh-card text-center py-5 px-3">
      <div style="font-size:48px; margin-bottom:12px;">🎯</div>
      <h4 class="fw-bold" style="font-size:16px; color:var(--sh-slate-800);">Chưa có mục tiêu nào</h4>
      <p class="text-muted" style="font-size:13px;">Hãy đặt mục tiêu gốc điểm số đầu tiên để bắt đầu hành trình cải thiện kết quả học tập!</p>
      @if(Model.SubjectDetails.Any() || (Model.AllSubjects != null && Model.AllSubjects.Any())) {
        <button type="button" class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addGoalModal" onclick="resetAddGoalModal('base')">
          <i class="bi bi-trophy me-1"></i> Đặt mục tiêu đầu tiên
        </button>
      }
    </div>
  } else {
    ViewData["CurrentGradeBookId"] = Model.SelectedGradeBookId;
    @foreach (var ladder in Model.GoalLadders.Where(l => !l.IsDetached))
    {
      <partial name="Goals/_GoalLadderPartial" model="ladder" />
    }

    var detachedLadders = Model.GoalLadders.Where(l => l.IsDetached).ToList();
    @if (detachedLadders.Any()) {
      <div class="mt-4 mb-2">
        <h4 class="fw-bold mb-1" style="font-size:15px; color:var(--sh-slate-700);">Môn không thuộc sổ (dữ liệu cũ)</h4>
        <p class="text-muted mb-3" style="font-size:12px;">Các môn này không thuộc sổ điểm nào nên không thể thêm điểm hoặc mục tiêu mới. Bạn vẫn có thể sửa, xóa nấc hoặc xóa vĩnh viễn môn.</p>
      </div>
      @foreach (var ladder in detachedLadders)
      {
        <partial name="Goals/_GoalLadderPartial" model="ladder" />
      }
    }
  }
</div>

