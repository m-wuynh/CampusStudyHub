  async function toggleActivity(id, goalId, iconEl) {
    try {
      const resp = await fetch('/Grades/ToggleGoalActivity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
        body: JSON.stringify({ ActivityId: id })
      });
      const res = await resp.json();
      if (res.ok) {
        const row = iconEl ? iconEl.closest('.activity-row') : document.getElementById('activity-item-' + id);
        if (row) {
          const titleSpan = row.querySelector('.activity-title');
          const badgeSpan = row.querySelector('.activity-badge');
          if (res.isCompleted) {
            if (iconEl) {
              iconEl.className = 'bi bi-check-circle-fill text-success fs-5 cursor-pointer flex-shrink-0';
              iconEl.title = 'Nhấn để đổi trạng thái';
            }
            if (titleSpan) {
              titleSpan.className = 'text-truncate text-decoration-line-through text-muted activity-title';
              titleSpan.style.color = '';
            }
            if (badgeSpan) {
              badgeSpan.className = 'badge activity-badge activity-badge-done';
              badgeSpan.textContent = 'Đã xong';
            }
          } else {
            if (iconEl) {
              iconEl.className = 'bi bi-circle text-muted fs-5 cursor-pointer flex-shrink-0';
              iconEl.title = 'Nhấn để đánh dấu hoàn thành';
            }
            if (titleSpan) {
              titleSpan.className = 'text-truncate fw-medium activity-title';
              titleSpan.style.color = 'var(--sh-slate-800)';
            }
            if (badgeSpan) {
              badgeSpan.className = 'badge activity-badge activity-badge-todo';
              badgeSpan.textContent = 'To do';
            }
          }
        }
        // Cập nhật bộ đếm tiến độ hoàn thành dạng 1/3 hoàn thành
        if (goalId) {
          const list = document.getElementById('activities-list-' + goalId);
          const progressEl = document.getElementById('activity-progress-' + goalId);
          if (list && progressEl) {
            const allRows = list.querySelectorAll('.activity-row');
            const doneRows = list.querySelectorAll('.activity-row .bi-check-circle-fill');
            progressEl.textContent = `${doneRows.length}/${allRows.length} hoàn thành`;
          }
        }
      } else {
        alert("Lỗi: " + (res.error || res.message || "Không thể cập nhật"));
      }
    } catch (err) {
      alert("Lỗi kết nối khi cập nhật hoạt động.");
    }
  }

  // Common Date Validation for GradeBooks
  function validateAddGradeBook(form) {
      const start = document.getElementById('displayStartDate').value;
      const end = document.getElementById('displayEndDate').value;
      
      function parseDMY(str) {
          const parts = str.split('/');
          if(parts.length !== 3) return null;
          return new Date(parts[2], parts[1]-1, parts[0]);
      }
      
      const dStart = parseDMY(start);
      const dEnd = parseDMY(end);
      
      if(!dStart || !dEnd) {
          alert("Vui lòng nhập ngày theo định dạng dd/MM/yyyy");
          return false;
      }
      
      if(dStart >= dEnd) {
          alert("Ngày bắt đầu phải trước ngày kết thúc");
          return false;
      }
      
      document.getElementById('hiddenStartDate').value = dStart.toISOString().split('T')[0];
      document.getElementById('hiddenEndDate').value = dEnd.toISOString().split('T')[0];
      return true;
  }

  // ── Enter Grades Modal Logic ─────────────────────────────────
  const subjectData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.SubjectDetails ?? new List<SubjectGradeDetailDto>()));
  const columnData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(columns ?? new List<GradeColumnDto>()));

  let modalCurrentSubjectId = null;
  let modalScores = [];

  function openEnterGradesModal(targetSubjectId) {
      const modalEl = document.getElementById('enterGradesModal');
      if (!modalEl) return;
      const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);

      const selectEl = document.getElementById('modalSubjectSelect');
      selectEl.innerHTML = '';

      if (!subjectData || subjectData.length === 0) {
          selectEl.innerHTML = '<option value="">(Chưa có môn học nào)</option>';
          document.getElementById('modalColumnsContainer').innerHTML = '<div class="alert alert-info" style="font-size:13px;"><i class="bi bi-info-circle me-1"></i>Vui lòng thêm môn học vào bảng điểm trước khi nhập điểm.</div>';
          bsModal.show();
          return;
      }

      subjectData.forEach(sub => {
          const subId = sub.userSubjectId || sub.UserSubjectId;
          const subName = sub.subjectName || sub.SubjectName;
          const opt = document.createElement('option');
          opt.value = subId;
          opt.textContent = subName;
          selectEl.appendChild(opt);
      });

      let initialSubjectId = targetSubjectId;
      if (!initialSubjectId && subjectData.length > 0) {
          initialSubjectId = subjectData[0].userSubjectId || subjectData[0].UserSubjectId;
      }

      if (initialSubjectId) {
          selectEl.value = initialSubjectId;
          onModalSubjectChanged(initialSubjectId);
      }

      bsModal.show();
  }

  function onModalSubjectChanged(subjectId) {
      modalCurrentSubjectId = parseInt(subjectId);
      if (!modalCurrentSubjectId) {
          document.getElementById('modalColumnsContainer').innerHTML = '';
          return;
      }

      const subject = subjectData.find(s => (s.userSubjectId || s.UserSubjectId) == modalCurrentSubjectId);
      if (!subject) return;

      modalScores = [];
      const entries = subject.entries || subject.Entries || [];
      entries.forEach(e => {
          modalScores.push({
              id: e.id || e.Id || null,
              gradeColumnId: e.gradeColumnId || e.GradeColumnId,
              score: e.score !== undefined ? e.score : (e.Score !== undefined ? e.Score : 0)
          });
      });

      renderModalColumns();
  }

  function renderModalColumns() {
      const container = document.getElementById('modalColumnsContainer');
      container.innerHTML = '';

      if (!columnData || columnData.length === 0) {
          container.innerHTML = '<div class="alert alert-warning" style="font-size:13px;"><i class="bi bi-exclamation-triangle me-2"></i>Sổ điểm này chưa có cột đánh giá nào. Vui lòng thêm cột ở mục "Chỉnh sửa bảng".</div>';
          return;
      }

      columnData.forEach(col => {
          const colId = col.gradeColumnId || col.GradeColumnId;
          const colName = col.name || col.Name;
          const colWeight = col.weight || col.Weight;

          const colScores = modalScores.filter(s => s.gradeColumnId == colId);
          const scoresStr = colScores.map(s => s.score).join(', ');

          // Tô màu badge hệ số theo mức độ quan trọng:
          // hệ số 1 màu xám, hệ số 2 màu xanh dương, hệ số 3 màu cam, hệ số cao hơn màu đỏ
          const w = parseFloat(colWeight) || 1;
          let badgeClass = 'text-white';
          let badgeStyle = '';
          if (w <= 1) {
              badgeClass = 'bg-secondary text-white';
          } else if (w <= 2) {
              badgeClass = 'bg-primary text-white';
          } else if (w <= 3) {
              badgeClass = 'text-white';
              badgeStyle = 'background-color: #f97316;';
          } else {
              badgeClass = 'bg-danger text-white';
          }

          const card = document.createElement('div');
          card.className = 'card border rounded-3 p-3 bg-white shadow-sm';
          card.innerHTML = `
              <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                  <span class="fw-bold" style="font-size: 14px; color: var(--sh-slate-800);">${escapeHtml(colName)}</span>
                  <span class="badge ${badgeClass}" style="font-size: 11px; ${badgeStyle}">Hệ số ${colWeight}</span>
              </div>
              <input type="text" class="form-control sh-input" 
                     id="col-input-${colId}" 
                     value="${scoresStr}" 
                     style="font-size: 14px;">
          `;
          container.appendChild(card);
      });
  }

  async function saveModalGrades() {
      if (!modalCurrentSubjectId) {
          alert("Vui lòng chọn môn học.");
          return;
      }

      const btn = document.getElementById('btnSaveModalGrades');
      if (btn) btn.disabled = true;

      const entries = [];

      for (const col of (columnData || [])) {
          const colId = col.gradeColumnId || col.GradeColumnId;
          const colName = col.name || col.Name;
          const inputEl = document.getElementById('col-input-' + colId);
          if (!inputEl) continue;

          const rawVal = inputEl.value.trim();
          if (!rawVal) continue;

          const tokens = rawVal.split(',').map(t => t.trim()).filter(t => t.length > 0);
          const existingColEntries = modalScores.filter(s => s.gradeColumnId == colId);

          for (let i = 0; i < tokens.length; i++) {
              const token = tokens[i];
              const scoreNum = parseFloat(token);
              if (isNaN(scoreNum) || scoreNum < 0 || scoreNum > 10) {
                  alert(`Điểm "${token}" ở nhóm "${colName}" không hợp lệ. Điểm phải là số từ 0 đến 10.`);
                  if (btn) btn.disabled = false;
                  inputEl.focus();
                  return;
              }

              const existingEntry = existingColEntries[i];
              entries.push({
                  GradeEntryId: (existingEntry && existingEntry.id) ? existingEntry.id : null,
                  GradeColumnId: colId,
                  Score: scoreNum
              });
          }
      }

      const payload = {
          UserSubjectId: modalCurrentSubjectId,
          Entries: entries
      };

      try {
          const token = csrfToken || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
          const resp = await fetch('/Grades/SaveSubjectGrades', {
              method: 'POST',
              headers: {
                  'Content-Type': 'application/json',
                  'RequestVerificationToken': token || ''
              },
              body: JSON.stringify(payload)
          });

          const result = await resp.json();
          if (result.ok) {
              window.location.reload();
          } else {
              alert("Lỗi khi lưu điểm: " + (result.message || "Không xác định"));
              if (btn) btn.disabled = false;
          }
      } catch (e) {
          alert("Lỗi kết nối khi lưu điểm.");
          if (btn) btn.disabled = false;
      }
  }

  function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
</script>
