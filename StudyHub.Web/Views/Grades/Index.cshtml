@model StudyHub.Web.ViewModels.Grades.GradesIndexViewModel
@{
    ViewData["Title"]        = "Điểm số & Mục tiêu";
    ViewData["PageTitle"]    = "Điểm số & Mục tiêu học tập";
    ViewData["PageSubtitle"] = "Theo dõi điểm trung bình và biểu đồ tiến bộ";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var data = Model.Data;
}

<link rel="stylesheet" href="~/css/grades.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/violet-theme.css" asp-append-version="true" />

@Html.AntiForgeryToken()

<div id="grades-view" style="max-width:1280px; margin:0 auto;">
    @* Thông báo TempData (thành công / lỗi) *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="d-none js-tempdata-alert" data-type="error" data-message="@TempData["ErrorMessage"]"></div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="d-none js-tempdata-alert" data-type="success" data-message="@TempData["SuccessMessage"]"></div>
    }

    @{ ViewData["HasActiveGoals"] = data.GoalLadders.Any(l => !l.IsDetached && l.Goals.Any()); }
    <partial name="_GradeSummaryCardsPartial" model="data.Summary" />

    <!-- ── Tabs ── -->
    <ul class="nav sv-tabs mb-4" id="grades-tabs">
        <li class="nav-item">
            <button type="button" class="nav-link active" id="tab-btn-grades"
                    onclick="gradeTab(this,'grades-tab')">
                <i class="bi bi-table me-1"></i> Bảng điểm
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link" id="tab-btn-goals"
                    onclick="gradeTab(this,'goals-tab')">
                <i class="bi bi-bullseye me-1"></i> Mục tiêu học tập
            </button>
        </li>
    </ul>

    <!-- ═══ GRADES TAB ═══ -->
    <partial name="GradeTable/_GradeTablePartial" model="data" />

    <!-- ═══ GOALS TAB ═══ -->
    <partial name="Goals/_GoalsTabPartial" model="data" />

    <!-- ═══ MODALS ═══ -->
    <partial name="Modals/_GradeModals" model="data" />
    <partial name="Modals/_GoalModals" model="data" />

    <!-- ═══ JSON SERVER STATE ═══ -->
    <partial name="_GradesJsonStatePartial" model="data" />
</div>

@section Scripts {
    <script src="~/js/grades/grades-table.js" asp-append-version="true"></script>
    <script src="~/js/grades/goals.js" asp-append-version="true"></script>
}
