@model StudyHub.Web.ViewModels.Grades.GradesIndexViewModel
@using StudyHub.BLL.DTOs
@using StudyHub.BLL.Services.Grades
@{
    ViewData["Title"]        = "Điểm số & Mục tiêu";
    ViewData["PageTitle"]    = "Điểm số & Mục tiêu học tập";
    ViewData["PageSubtitle"] = "Theo dõi điểm trung bình và biểu đồ tiến bộ";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var data = Model.Data;
    var selectedGradeBook = data.GradeBooks.FirstOrDefault(t => t.GradeBookId == data.SelectedGradeBookId);
    var columns = data.Columns;
    var gradeBook = data.GradeBook;
}

<div id="grades-view" style="max-width:1280px; margin:0 auto;">

  @if (TempData["ErrorMessage"] != null)
  {
      <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert" style="font-size:13px; border-radius: 8px;">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
  }
  @if (TempData["SuccessMessage"] != null)
  {
      <div class="alert alert-success alert-dismissible fade show mb-3" role="alert" style="font-size:13px; border-radius: 8px;">
          <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
  }

  <!-- ── Stats Row ── -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-indigo-600);" id="stat-avg">@(data.Summary.CurrentAverage10?.ToString("0.0") ?? "-")</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">ĐTB Chung</p>
        @if (data.Summary.CurrentAverage10.HasValue) {
          <span class="mt-1 d-inline-block px-2 py-0 rounded-full fw-bold"
                style="font-size:10px; background:var(--sh-emerald-100); color:var(--sh-emerald-700);">
            @(data.Summary.CurrentAverage10 >= 8.0m ? "Học sinh Giỏi" : (data.Summary.CurrentAverage10 >= 6.5m ? "Khá" : "Trung bình"))
          </span>
        }
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-emerald-600);">@(data.Summary.HighestScore?.ToString("0.0") ?? "-")</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Điểm cao nhất</p>
        <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-slate-400);">@(data.Summary.HighestSubjectName)</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-amber-600);">@(data.Summary.LowestScore?.ToString("0.0") ?? "-")</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Điểm thấp nhất</p>
        <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-slate-400);">@(data.Summary.LowestSubjectName)</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-rose-600);">@data.Summary.SubjectsBelowTarget</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Môn dưới mục tiêu</p>
        <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-rose-600);">Cần cải thiện</p>
      </div>
    </div>
  </div>

  <!-- ── Tabs ── -->
  <ul class="nav nav-tabs mb-4" style="border-bottom:2px solid var(--sh-slate-200);">
    <li class="nav-item">
      <button class="nav-link active fw-bold px-4"
              style="font-size:12px; color:var(--sh-indigo-600); border-bottom:2px solid var(--sh-indigo-600); border-top:0; border-left:0; border-right:0; background:transparent;"
              onclick="gradeTab(this,'grades-tab')">
        📊 Bảng điểm
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link fw-semibold px-4"
              style="font-size:12px; color:var(--sh-slate-500); border:0; background:transparent;"
              onclick="gradeTab(this,'goals-tab')">
        🎯 Mục tiêu học tập
      </button>
    </li>
  </ul>

  <!-- ═══ GRADES TAB ═══ -->
  <div id="grades-tab">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
      
      @if (gradeBook != null) {
        <!-- VIEW MODE HEADER -->
        <div id="view-mode-header" class="mode-header" style="display: block;">
          <h3 class="fw-bold mb-0" style="font-size:15px; color:var(--sh-slate-900);">
            @gradeBook.Name
          </h3>
          <p class="mb-0" style="font-size:11px; color:var(--sh-slate-400);">@(selectedGradeBook?.Name ?? "")</p>
        </div>
        
        <!-- SCORE MODE HEADER -->
        <div id="score-mode-header" class="mode-header" style="display: none; width: 100%;">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
              <h3 class="fw-bold mb-0" style="font-size:15px; color:var(--sh-slate-900);">@gradeBook.Name <span class="badge bg-primary" style="font-size:10px; margin-left:4px;">Nhập điểm</span></h3>
              <p class="mb-0" style="font-size:11px; color:var(--sh-slate-400);">@(selectedGradeBook?.Name ?? "")</p>
            </div>
            <button type="button" class="btn-secondary-sh" style="padding: 4px 12px; font-size:12px;" onclick="setUiMode('view')"><i class="bi bi-arrow-left"></i> Quay lại</button>
          </div>
        </div>

        <!-- STRUCTURE MODE HEADER -->
        <div id="structure-mode-header" class="mode-header" style="display: none; width: 100%;">
          <div class="d-flex align-items-center gap-2 flex-wrap justify-content-between">
            <div class="d-flex align-items-center gap-2 m-0 flex-grow-1">
              <input type="text" id="gradebook-name-input" class="sh-input fw-bold" style="font-size:15px; max-width: 300px; padding: 4px 8px;" value="@gradeBook.Name" required maxlength="200" onchange="updateGradeBookName(@gradeBook.GradeBookId, this.value)" />
              <span id="gradebook-name-status" class="text-success" style="font-size:11px; display:none;"><i class="bi bi-check-circle"></i> Đã lưu</span>
              <button type="button" class="btn-secondary-sh ms-2" style="padding: 6px 14px; font-size:12px; white-space: nowrap;" onclick="setUiMode('view')">
                <i class="bi bi-arrow-left me-1"></i> Lưu và quay lại
              </button>
            </div>
            <button type="button" class="btn-icon-sh danger fw-bold" style="padding: 6px 14px; width: auto; font-size:12px; border-radius: 6px; white-space: nowrap;" data-bs-toggle="modal" data-bs-target="#deleteGradeBookModal">
                <i class="bi bi-trash3 me-1"></i> Xóa bảng điểm
            </button>
          </div>
        </div>
      } else {
        <div id="view-mode-header" class="mode-header" style="display: block;">
          <h3 class="fw-bold mb-0" style="font-size:15px; color:var(--sh-slate-900);">
            Chưa có bảng điểm
          </h3>
          <p class="mb-0" style="font-size:11px; color:var(--sh-slate-400);">@(selectedGradeBook?.Name ?? "")</p>
        </div>
      }

      <!-- VIEW MODE ACTIONS -->
      <div class="d-flex gap-2 flex-wrap align-items-center mode-header" id="view-mode-actions" style="display: flex !important;">
        <!-- GradeBook selector -->
        <form method="get" asp-action="Index" class="d-flex m-0">
          <select name="gradeBookId" class="sh-input" style="font-size:12px; width:auto; padding:6px 12px;" onchange="this.form.submit()">
            @if(!data.GradeBooks.Any()) {
              <option value="">Chưa có sổ điểm</option>
            }
            @foreach(var term in data.GradeBooks) {
              if (term.GradeBookId == data.SelectedGradeBookId) {
                <option value="@term.GradeBookId" selected>@term.Name</option>
              } else {
                <option value="@term.GradeBookId">@term.Name</option>
              }
            }
          </select>
        </form>
        <button class="btn-secondary-sh" style="padding: 6px 12px;" data-bs-toggle="modal" data-bs-target="#wizardGradeBookModal" title="Thêm sổ điểm">
          <i class="bi bi-calendar-plus"></i> Thêm sổ điểm
        </button>

        @if(data.SelectedGradeBookId.HasValue && gradeBook != null) {
          <button class="btn-primary-sh" style="padding: 6px 12px;" onclick="openEnterGradesModal()">
            <i class="bi bi-pencil-square"></i> Nhập điểm
          </button>
          <button class="btn-secondary-sh" style="padding: 6px 12px;" onclick="setUiMode('structure')">
            <i class="bi bi-gear"></i> Chỉnh sửa bảng
          </button>
        }
      </div>
    </div>

    @if (data.SelectedGradeBookId.HasValue && gradeBook == null) {
      <div class="sh-card text-center py-5">
        <div style="font-size:48px; margin-bottom:12px;">📋</div>
        <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Chưa có dữ liệu cho sổ điểm này</h4>
        <p class="text-muted" style="font-size:12px;">Tạo bảng điểm để bắt đầu theo dõi điểm số của bạn.</p>
        <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#wizardGradeBookModal">
          <i class="bi bi-journal-plus"></i> Tạo bảng điểm
        </button>
      </div>
    } else if (data.SelectedGradeBookId.HasValue) {
      
      <!-- ═══ TABLE VIEW MODE ═══ -->
      <div class="sh-card overflow-hidden mode-panel" id="table-view-mode" style="display: block;">
        <div class="table-responsive">
          <table class="table table-hover mb-0 grade-table">
            <thead>
              <tr>
                <th class="ps-4">Môn học</th>
                @foreach(var col in columns) {
                  <th>
                    <div style="line-height:1.2;">@col.Name</div>
                    <div style="font-size:10px; color:var(--sh-slate-400); font-weight:normal;">(x@(col.Weight.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)))</div>
                  </th>
                }
                <th>ĐTB Môn</th>
                <th class="pe-4">Tiến độ</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var s in data.SubjectDetails)
              {
                var ladder = data.GoalLadders.FirstOrDefault(l => l.UserSubjectId == s.UserSubjectId);
                var currentGoal = ladder?.Goals.FirstOrDefault(g => g.Status == GoalStatus.InProgress)
                               ?? ladder?.Goals.OrderByDescending(g => g.TargetValue).FirstOrDefault(g => g.Status == GoalStatus.Achieved);
                var currentAvg = s.CurrentAverage10;

                int? pct = null;
                string color = "var(--sh-slate-400)";
                if (currentGoal != null && currentGoal.TargetValue > 0) {
                    pct = GradeCalculator.ComputeProgressPercent(currentAvg, currentGoal.TargetValue);
                    color = (currentAvg ?? 0m) >= currentGoal.TargetValue ? "var(--sh-emerald-600)"
                            : (currentAvg ?? 0m) >= currentGoal.TargetValue - 0.5m ? "var(--sh-amber-600)"
                            : "var(--sh-rose-600)";
                }

                <tr>
                  <td class="ps-4 fw-semibold" style="font-size:12px; color:var(--sh-slate-900);">
                    <div class="d-flex align-items-center gap-2">
                      @s.SubjectName
                    </div>
                  </td>

                  @foreach (var col in columns) {
                    var colEntries = s.Entries.Where(e => e.GradeColumnId == col.GradeColumnId).ToList();
                    <td style="font-size:12px;">
                      @if (colEntries.Any()) {
                        <span class="fw-bold" style="color:var(--sh-indigo-600);">
                          @string.Join(", ", colEntries.Select(e => e.Score.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)))
                        </span>
                      } else {
                        <span style="color:var(--sh-slate-300);">—</span>
                      }
                    </td>
                  }

                  <td class="fw-black" style="font-size:14px; color:@color;">
                    @(s.CurrentAverage10?.ToString("0.0") ?? "—")
                  </td>
                  <td class="pe-4">
                    @if (pct.HasValue) {
                      <div class="d-flex align-items-center gap-2">
                        <div class="sh-progress flex-grow-1" style="height:5px;">
                          <div class="sh-progress-bar" style="width:@pct%; background:@color;"></div>
                        </div>
                        <span style="font-size:10px; font-weight:700; color:@color; white-space:nowrap;">@pct%</span>
                      </div>
                    } else if (s.CurrentAverage10 == null) {
                      <span style="font-size:11px; color:var(--sh-slate-400); font-style:italic;">Chưa có điểm</span>
                    } else {
                      <span style="font-size:11px; color:var(--sh-slate-400); font-style:italic;">Chưa đặt mục tiêu</span>
                    }
                  </td>
                </tr>
              }
              @if(!data.SubjectDetails.Any()) {
                <tr>
                  <td colspan="@(columns.Count + 3)" class="text-center py-5">
                    <p class="text-muted mb-3">Bạn chưa có môn học nào trong bảng điểm.</p>
                    <button class="btn-primary-sh" onclick="setUiMode('structure')">
                      <i class="bi bi-gear"></i> Chỉnh sửa cấu trúc bảng
                    </button>
                  </td>
                </tr>
              }
            </tbody>
            <tfoot>
              <tr style="border-top:2px solid var(--sh-slate-200);">
                <td class="ps-4 fw-black" style="font-size:12px; color:var(--sh-slate-900);" colspan="@(columns.Count + 1)">
                  Điểm trung bình chung
                </td>
                <td class="fw-black" style="font-size:16px; color:var(--sh-indigo-600);" colspan="2">
                  @(data.Summary.CurrentAverage10?.ToString("0.0") ?? "—")
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- ═══ TABLE SCORE MODE ═══ -->
      <div class="sh-card overflow-hidden mode-panel" id="table-score-mode" style="display: none;">
        
        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold" style="font-size:13px; color:var(--sh-indigo-700);">
                <i class="bi bi-pencil-square me-1"></i> Chế độ nhập điểm
            </h6>
        </div>

        <div class="table-responsive">
          <table class="table table-hover mb-0 grade-table edit-table" id="score-table-grid">
            <thead>
              <tr id="score-mode-header-row">
                <th class="ps-4" style="min-width: 150px;">Môn học</th>
                @foreach(var col in columns) {
                  <th data-col-id="@col.GradeColumnId">
                      <div style="font-size: 11px;">@col.Name <span style="color:var(--sh-slate-400); font-weight:normal;">(x@(col.Weight.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)))</span></div>
                  </th>
                }
                <th>ĐTB Môn</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var s in data.SubjectDetails)
              {
                <tr data-subject-id="@s.UserSubjectId">
                  <td class="ps-4 fw-semibold" style="font-size:12px; color:var(--sh-slate-900);">
                    <div class="d-flex align-items-center gap-2">
                        <span>@s.SubjectName</span>
                    </div>
                  </td>

                  @foreach (var col in columns) {
                    var entry = s.Entries.LastOrDefault(e => e.GradeColumnId == col.GradeColumnId);
                    <td style="font-size:12px; position: relative;">
                      @if (entry != null) {
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold editable-grade" 
                                  style="color:var(--sh-indigo-600); cursor: text; padding: 4px; display: inline-block; min-width: 30px; border-bottom: 1px dashed var(--sh-indigo-300);" 
                                  onclick="openInlineEdit(this, @entry.Id, @s.UserSubjectId, @col.GradeColumnId, @entry.Score.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                @entry.Score.ToString("0.0")
                            </span>
                            <button class="btn-icon-sh text-muted p-0 ms-1" style="font-size:9px;" onclick="deleteGradeInline(@entry.Id, this)"><i class="bi bi-x-circle"></i></button>
                        </div>
                      } else {
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="editable-grade text-muted" 
                                  style="cursor: text; padding: 4px; display: inline-block; min-width: 30px; border-bottom: 1px dashed var(--sh-slate-200); font-style: italic; font-size: 11px;" 
                                  onclick="openInlineEdit(this, null, @s.UserSubjectId, @col.GradeColumnId, null)">
                                [nhập]
                            </span>
                        </div>
                      }
                    </td>
                  }

                  <td class="fw-black subject-avg-cell" style="font-size:14px; color:var(--sh-slate-600);" data-subject-id="@s.UserSubjectId">
                    @(s.CurrentAverage10?.ToString("0.0") ?? "—")
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- ═══ TABLE STRUCTURE MODE ═══ -->
      <div class="sh-card overflow-hidden mode-panel" id="table-structure-mode" style="display: none;">
        
        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h6 class="mb-0 fw-bold" style="font-size:13px; color:var(--sh-indigo-700); white-space: nowrap;">
                <i class="bi bi-gear me-1"></i> Chế độ chỉnh sửa cấu trúc bảng
            </h6>
            <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn-secondary-sh" style="padding: 6px 12px; font-size:12px; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px;" data-bs-toggle="modal" data-bs-target="#addUserSubjectModal">
                  <i class="bi bi-journal-plus"></i> + Thêm môn
                </button>
                <button type="button" class="btn-secondary-sh" style="padding: 6px 12px; font-size:12px; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px;" data-bs-toggle="modal" data-bs-target="#addColumnModal">
                  <i class="bi bi-layout-three-columns"></i> + Thêm cột
                </button>
            </div>
        </div>

        <div class="table-responsive">
          <table class="table table-hover mb-0 grade-table edit-table" id="structure-table-grid">
            <thead>
              <tr id="structure-mode-header-row">
                <th class="ps-4" style="min-width: 150px;">Môn học</th>
                @foreach(var col in columns) {
                  <th data-col-id="@col.GradeColumnId">
                    <div class="d-flex align-items-center justify-content-between gap-1">
                      <div class="d-flex align-items-center gap-1">
                          <div class="d-flex flex-column me-1">
                              <button type="button" class="btn-icon-sh p-0 m-0 text-muted" style="font-size:8px; line-height: 1;" onclick="moveColumn(@col.GradeColumnId, -1)"><i class="bi bi-caret-left-fill"></i></button>
                              <button type="button" class="btn-icon-sh p-0 m-0 text-muted" style="font-size:8px; line-height: 1;" onclick="moveColumn(@col.GradeColumnId, 1)"><i class="bi bi-caret-right-fill"></i></button>
                          </div>
                          <span style="font-size: 11px;">@col.Name <span style="color:var(--sh-slate-400); font-weight:normal;">(x@(col.Weight.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)))</span></span>
                      </div>
                      <div class="d-flex gap-1">
                          <button type="button" class="btn-icon-sh text-muted" style="padding:2px; font-size:10px;" title="Sửa cột"
                                  onclick="editColumn(@col.GradeColumnId, '@Html.Raw(col.Name.Replace("'","\\\'"))', @col.Weight.ToString(System.Globalization.CultureInfo.InvariantCulture), @col.DisplayOrder)">
                            <i class="bi bi-pencil"></i>
                          </button>
                          <form asp-action="DeleteColumn" method="post" class="d-inline"
                                onsubmit="return confirm('Bạn chắc chắn muốn XÓA cột @col.Name? Toàn bộ điểm của cột này sẽ bị xóa.')">
                            <input type="hidden" name="id" value="@col.GradeColumnId" />
                            <input type="hidden" name="currentGradeBookId" value="@data.SelectedGradeBookId" />
                            <button type="submit" class="btn-icon-sh danger" style="padding:2px; font-size:10px;" title="Xóa cột">
                              <i class="bi bi-trash3"></i>
                            </button>
                          </form>
                      </div>
                    </div>
                  </th>
                }
                <th>ĐTB Môn</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var s in data.SubjectDetails)
              {
                <tr data-subject-id="@s.UserSubjectId">
                  <td class="ps-4 fw-semibold" style="font-size:12px; color:var(--sh-slate-900);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <div class="d-flex flex-column me-1">
                                <button type="button" class="btn-icon-sh p-0 m-0 text-muted" style="font-size:8px; line-height: 1;" onclick="moveSubject(@s.UserSubjectId, -1)"><i class="bi bi-caret-up-fill"></i></button>
                                <button type="button" class="btn-icon-sh p-0 m-0 text-muted" style="font-size:8px; line-height: 1;" onclick="moveSubject(@s.UserSubjectId, 1)"><i class="bi bi-caret-down-fill"></i></button>
                            </div>
                            <span style="cursor: pointer;" onclick="editSubject(@s.UserSubjectId, '@Html.Raw(s.SubjectName.Replace("'","\\\'"))', '@s.CreditWeight')">@s.SubjectName</span>
                        </div>
                        <form asp-action="DeleteUserSubject" method="post" class="d-inline"
                              onsubmit="return confirm('Bạn chắc chắn muốn xóa môn @s.SubjectName và tất cả điểm của môn này?')">
                            <input type="hidden" name="id" value="@s.UserSubjectId" />
                            <input type="hidden" name="currentGradeBookId" value="@data.SelectedGradeBookId" />
                            <button type="submit" class="btn-icon-sh danger" style="padding: 2px; font-size:11px;" title="Xóa môn"><i class="bi bi-trash3"></i></button>
                        </form>
                    </div>
                  </td>

                  @foreach (var col in columns) {
                    var entry = s.Entries.LastOrDefault(e => e.GradeColumnId == col.GradeColumnId);
                    <td style="font-size:12px; position: relative;">
                      @if (entry != null) {
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold" style="color:var(--sh-slate-500); padding: 4px; display: inline-block;">
                                @entry.Score.ToString("0.0")
                            </span>
                        </div>
                      } else {
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted" style="padding: 4px; display: inline-block; font-size: 11px;">
                                —
                            </span>
                        </div>
                      }
                    </td>
                  }

                  <td class="fw-black subject-avg-cell" style="font-size:14px; color:var(--sh-slate-600);" data-subject-id="@s.UserSubjectId">
                    @(s.CurrentAverage10?.ToString("0.0") ?? "—")
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>

    } else {
      <div class="sh-card text-center py-5">
        <p class="text-muted mb-3">Bạn chưa có sổ điểm nào. Hãy tạo sổ điểm năm học để bắt đầu.</p>
        <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#wizardGradeBookModal">
          <i class="bi bi-plus-lg"></i> Tạo sổ điểm
        </button>
      </div>
    }
  </div>

  <!-- ═══ GOALS TAB ═══ -->
  <div id="goals-tab" style="display:none;">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
      <h3 class="fw-bold mb-0" style="font-size:15px; color:var(--sh-slate-900);">Mục tiêu học tập – Goal Ladder</h3>
      @if(data.SubjectDetails.Any()) {
        <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addGoalModal">
          <i class="bi bi-plus-lg"></i> Đặt mục tiêu mới
        </button>
      }
    </div>

    @if (!data.GoalLadders.Any()) {
      <div class="sh-card text-center py-5">
        <div style="font-size:48px; margin-bottom:12px;">🎯</div>
        <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Chưa có mục tiêu nào</h4>
        <p class="text-muted" style="font-size:12px;">Đặt mục tiêu điểm số để theo dõi tiến độ học tập.</p>
        @if(data.SubjectDetails.Any()) {
          <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addGoalModal">
            <i class="bi bi-trophy me-1"></i> Đặt mục tiêu đầu tiên
          </button>
        }
      </div>
    } else {
      <div class="row g-3">
        @foreach (var ladder in data.GoalLadders)
        {
          <div class="col-12 col-md-6">
            <div class="sh-card p-4">
              <!-- Subject header -->
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                  <h4 class="fw-bold mb-0" style="font-size:13px; color:var(--sh-slate-900);">@ladder.SubjectName</h4>
                  <div style="font-size:11px; color:var(--sh-slate-500);">
                    Điểm hiện tại:
                    <span class="fw-bold" style="color:var(--sh-indigo-600);">
                      @(ladder.CurrentAverage10?.ToString("0.0") ?? "Chưa có điểm")
                    </span>
                  </div>
                </div>
                <button class="btn-secondary-sh" style="font-size:11px; padding:4px 10px;"
                        onclick="openAddGoalForSubject(@ladder.UserSubjectId, '@Html.Raw(ladder.SubjectName.Replace("'","\\\'"))')">
                  <i class="bi bi-plus"></i> Thêm nấc
                </button>
              </div>

              <!-- Goal Ladder rungs -->
              <div class="d-flex flex-column gap-2">
                @foreach (var goal in ladder.Goals.OrderBy(g => g.TargetValue))
                {
                  var isAchieved = goal.Status == GoalStatus.Achieved;
                  var isInProgress = goal.Status == GoalStatus.InProgress;
                  var isCancelled = goal.Status == GoalStatus.Cancelled;
                  var isFuture = goal.Status == GoalStatus.Future;
                  var isNoData = goal.Status == GoalStatus.NoData;

                  string runColor = isAchieved ? "var(--sh-emerald-600)"
                      : isInProgress ? "var(--sh-indigo-600)"
                      : isCancelled ? "var(--sh-slate-300)"
                      : "var(--sh-slate-400)";
                  string runBg = isAchieved ? "var(--sh-emerald-50)"
                      : isInProgress ? "var(--sh-indigo-50)"
                      : "var(--sh-slate-50)";
                  string icon = isAchieved ? "✅" : isInProgress ? "🎯" : isCancelled ? "🚫" : "○";
                  string statusLabel = isAchieved ? "Đã đạt"
                      : isInProgress ? "Đang hướng tới"
                      : isCancelled ? "Đã hủy"
                      : isFuture ? "Mục tiêu tiếp theo"
                      : "Chưa có điểm";

                  var pctGoal = isInProgress || isAchieved
                      ? GradeCalculator.ComputeProgressPercent(ladder.CurrentAverage10, goal.TargetValue)
                      : null;

                  <div class="rounded p-3 d-flex justify-content-between align-items-center"
                       style="background:@runBg; border-left:3px solid @runColor; opacity:@(isCancelled ? "0.5" : "1");">
                    <div class="d-flex align-items-center gap-3">
                      <span style="font-size:18px; line-height:1;">@Html.Raw(icon)</span>
                      <div>
                        <div class="d-flex align-items-center gap-2">
                          <span class="fw-bold" style="font-size:15px; color:@runColor;">@goal.TargetValue.ToString("0.0")</span>
                          <span style="font-size:10px; color:var(--sh-slate-500);">@statusLabel</span>
                        </div>
                        <div style="font-size:11px; color:var(--sh-slate-500);">@goal.Title</div>
                        @if (isInProgress && pctGoal.HasValue) {
                          <div class="d-flex align-items-center gap-2 mt-1">
                            <div class="sh-progress flex-grow-1" style="height:4px; min-width:80px;">
                              <div class="sh-progress-bar" style="width:@pctGoal%; background:@runColor;"></div>
                            </div>
                            <span style="font-size:10px; font-weight:700; color:@runColor;">@pctGoal%</span>
                          </div>
                        }
                      </div>
                    </div>
                    @if (!isCancelled) {
                      <div class="d-flex gap-1">
                        <button type="button" class="btn-icon-sh primary" title="Sửa mục tiêu"
                                onclick="editGoal(@goal.Id, '@Html.Raw(goal.Title.Replace("'","\\\'"))', '@(goal.EndDate?.ToString("yyyy-MM-dd") ?? "")')">
                          <i class="bi bi-pencil-square"></i>
                        </button>
                        <form asp-action="CancelGoal" method="post" class="d-inline">
                          <input type="hidden" name="id" value="@goal.Id" />
                          <input type="hidden" name="currentGradeBookId" value="@data.SelectedGradeBookId" />
                          <button type="submit" class="btn-icon-sh danger" title="Hủy mục tiêu"
                                  onclick="return confirm('Hủy mục tiêu @goal.TargetValue.ToString("0.0")? Lịch sử vẫn được giữ lại.')">
                            <i class="bi bi-x-circle"></i>
                          </button>
                        </form>
                      </div>
                    }
                  </div>
                }
              </div>
            </div>
          </div>
        }
      </div>
    }
  </div>

</div>


