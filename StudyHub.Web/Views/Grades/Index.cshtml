@model StudyHub.Web.ViewModels.Grades.GradesIndexViewModel
@{
    ViewData["Title"]        = "Điểm số & Mục tiêu";
    ViewData["PageTitle"]    = "Điểm số & Mục tiêu học tập";
    ViewData["PageSubtitle"] = "Theo dõi điểm trung bình và biểu đồ tiến bộ";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var data = Model.Data;
}

<link rel="stylesheet" href="~/css/grades.css" asp-append-version="true" />

@Html.AntiForgeryToken()

<div id="grades-view" style="max-width:1280px; margin:0 auto;">
    <partial name="_AlertMessagesPartial" />

    <partial name="_GradeSummaryCardsPartial" model="data.Summary" />

    <!-- ── Tabs ── -->
    <ul class="nav nav-tabs mb-4" style="border-bottom:2px solid var(--sh-slate-200);">
        <li class="nav-item">
            <button class="nav-link active fw-bold px-4" id="tab-btn-grades"
                    style="font-size:12px; color:var(--sh-indigo-600); border-bottom:2px solid var(--sh-indigo-600); border-top:0; border-left:0; border-right:0; background:transparent;"
                    onclick="gradeTab(this,'grades-tab')">
                📊 Bảng điểm
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-semibold px-4" id="tab-btn-goals"
                    style="font-size:12px; color:var(--sh-slate-500); border:0; background:transparent;"
                    onclick="gradeTab(this,'goals-tab')">
                🎯 Mục tiêu học tập
            </button>
        </li>
    </ul>

    <!-- ═══ GRADES TAB ═══ -->
    <partial name="_GradesTabPartial" model="data" />

    <!-- ═══ GOALS TAB ═══ -->
    <partial name="_GoalsTabPartial" model="data" />

    <!-- ═══ MODALS ═══ -->
    <partial name="Modals/_GradeBookModals" model="data" />
    <partial name="Modals/_StructureModals" model="data" />
    <partial name="Modals/_GoalModals" model="data" />
    <partial name="Modals/_EnterGradesModal" model="data" />

    <!-- ═══ JSON SERVER STATE ═══ -->
    <partial name="_GradesJsonStatePartial" model="data" />
</div>

@section Scripts {
    <script src="~/js/grades/grades-core.js" asp-append-version="true"></script>
    <script src="~/js/grades/grades-wizard.js" asp-append-version="true"></script>
    <script src="~/js/grades/grades-table.js" asp-append-version="true"></script>
    <script src="~/js/grades/grades-modal-entry.js" asp-append-version="true"></script>
    <script src="~/js/grades/goals-ladder.js" asp-append-version="true"></script>
}
