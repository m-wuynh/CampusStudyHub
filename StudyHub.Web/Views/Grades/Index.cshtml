@model StudyHub.Web.ViewModels.Grades.GradesIndexViewModel
@{
    ViewData["Title"]        = "Điểm số & Mục tiêu";
    ViewData["PageTitle"]    = "Điểm số & Mục tiêu học tập";
    ViewData["PageSubtitle"] = "Theo dõi điểm trung bình và biểu đồ tiến bộ";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var data = Model.Data;
}

<div id="grades-view" style="max-width:1280px; margin:0 auto;">

  <!-- ── Stats Row ── -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-indigo-600);">@(data.Summary.CurrentAverage10?.ToString("0.0") ?? "-")</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">ĐTB Chung</p>
        <span class="mt-1 d-inline-block px-2 py-0 rounded-full fw-bold"
              style="font-size:10px; background:var(--sh-emerald-100); color:var(--sh-emerald-700);">
            @(data.Summary.CurrentAverage10 >= 8.0m ? "Học sinh Giỏi" : (data.Summary.CurrentAverage10 >= 6.5m ? "Khá" : "Trung bình"))
        </span>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-emerald-600);">@(data.Summary.HighestScore?.ToString("0.0") ?? "-")</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Điểm cao nhất</p>
        <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-slate-400);">@(data.Summary.HighestSubjectName)</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-amber-600);">@(data.Summary.LowestScore?.ToString("0.0") ?? "-")</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Điểm thấp nhất</p>
        <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-slate-400);">@(data.Summary.LowestSubjectName)</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-rose-600);">@data.Summary.SubjectsBelowTarget</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Môn dưới mục tiêu</p>
        <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-rose-600);">Cần cải thiện</p>
      </div>
    </div>
  </div>

  <!-- ── Tabs ── -->
  <ul class="nav nav-tabs mb-4" style="border-bottom:2px solid var(--sh-slate-200);">
    <li class="nav-item">
      <button class="nav-link active fw-bold px-4"
              style="font-size:12px; color:var(--sh-indigo-600); border-bottom:2px solid var(--sh-indigo-600); border-top:0; border-left:0; border-right:0; background:transparent;"
              onclick="gradeTab(this,'grades-tab')">
        📊 Bảng điểm
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link fw-semibold px-4"
              style="font-size:12px; color:var(--sh-slate-500); border:0; background:transparent;"
              onclick="gradeTab(this,'goals-tab')">
        🎯 Mục tiêu học tập
      </button>
    </li>
  </ul>

  <!-- ═══ GRADES TAB ═══ -->
  <div id="grades-tab">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
      <h3 class="fw-bold mb-0" style="font-size:15px; color:var(--sh-slate-900);">
        Bảng điểm @(data.Terms.FirstOrDefault(t => t.Id == data.SelectedTermId)?.TermName ?? "Chưa chọn")
      </h3>
      <div class="d-flex gap-2">
        <form method="get" asp-action="Index" class="d-flex m-0">
          <select name="academicTermId" class="sh-input" style="font-size:12px; width:auto; padding:6px 12px;" onchange="this.form.submit()">
            @if(!data.Terms.Any()) {
                <option value="">Chưa có học kỳ</option>
            }
            @foreach(var term in data.Terms) {
                if (term.Id == data.SelectedTermId) {
                    <option value="@term.Id" selected>@term.TermName</option>
                } else {
                    <option value="@term.Id">@term.TermName</option>
                }
            }
          </select>
        </form>
        <button class="btn-secondary-sh" style="padding: 6px 12px;" data-bs-toggle="modal" data-bs-target="#addTermModal" title="Thêm học kỳ">
          <i class="bi bi-calendar-plus"></i> Thêm HK
        </button>
        @if(data.SelectedTermId.HasValue) {
            <button class="btn-secondary-sh" style="padding: 6px 12px;" data-bs-toggle="modal" data-bs-target="#addUserSubjectModal" title="Thêm môn học">
              <i class="bi bi-book"></i> Thêm Môn
            </button>
            @if(data.SubjectDetails.Any()) {
                <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addGradeModal">
                  <i class="bi bi-plus-lg"></i> Nhập điểm
                </button>
            }
        }
      </div>
    </div>

    <div class="sh-card overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover mb-0 grade-table">
          <thead>
            <tr>
              <th class="ps-4">Môn học</th>
              <th>Miệng</th>
              <th>15p</th>
              <th>1 tiết</th>
              <th>Giữa kỳ</th>
              <th>Cuối kỳ</th>
              <th>ĐTB Môn</th>
              <th class="pe-4">Tiến độ</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var s in data.SubjectDetails)
            {
              var oralHtml = string.Join(", ", s.Entries.Where(e => e.AssessmentType == "Other").Select(e => $"<span style='cursor:pointer; color:var(--sh-indigo-600);' class='text-decoration-underline' title='Sửa điểm' onclick=\"editGrade({e.Id}, {s.UserSubjectId}, '{e.Title?.Replace("'", "\\'") ?? ""}', '{e.AssessmentType}', {e.Score.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {e.Weight.ToString(System.Globalization.CultureInfo.InvariantCulture)}, '{e.AssessedOn.ToString("yyyy-MM-dd")}')\">{e.Score.ToString("0.0")}</span>"));
              var q15Html = string.Join(", ", s.Entries.Where(e => e.AssessmentType == "Quiz").Select(e => $"<span style='cursor:pointer; color:var(--sh-indigo-600);' class='text-decoration-underline' title='Sửa điểm' onclick=\"editGrade({e.Id}, {s.UserSubjectId}, '{e.Title?.Replace("'", "\\'") ?? ""}', '{e.AssessmentType}', {e.Score.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {e.Weight.ToString(System.Globalization.CultureInfo.InvariantCulture)}, '{e.AssessedOn.ToString("yyyy-MM-dd")}')\">{e.Score.ToString("0.0")}</span>"));
              var q1pHtml = string.Join(", ", s.Entries.Where(e => e.AssessmentType == "Assignment").Select(e => $"<span style='cursor:pointer; color:var(--sh-indigo-600);' class='text-decoration-underline' title='Sửa điểm' onclick=\"editGrade({e.Id}, {s.UserSubjectId}, '{e.Title?.Replace("'", "\\'") ?? ""}', '{e.AssessmentType}', {e.Score.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {e.Weight.ToString(System.Globalization.CultureInfo.InvariantCulture)}, '{e.AssessedOn.ToString("yyyy-MM-dd")}')\">{e.Score.ToString("0.0")}</span>"));
              var midHtml = string.Join(", ", s.Entries.Where(e => e.AssessmentType == "Midterm").Select(e => $"<span style='cursor:pointer; color:var(--sh-indigo-600);' class='text-decoration-underline' title='Sửa điểm' onclick=\"editGrade({e.Id}, {s.UserSubjectId}, '{e.Title?.Replace("'", "\\'") ?? ""}', '{e.AssessmentType}', {e.Score.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {e.Weight.ToString(System.Globalization.CultureInfo.InvariantCulture)}, '{e.AssessedOn.ToString("yyyy-MM-dd")}')\">{e.Score.ToString("0.0")}</span>"));
              var finHtml = string.Join(", ", s.Entries.Where(e => e.AssessmentType == "Final").Select(e => $"<span style='cursor:pointer; color:var(--sh-indigo-600);' class='text-decoration-underline' title='Sửa điểm' onclick=\"editGrade({e.Id}, {s.UserSubjectId}, '{e.Title?.Replace("'", "\\'") ?? ""}', '{e.AssessmentType}', {e.Score.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {e.Weight.ToString(System.Globalization.CultureInfo.InvariantCulture)}, '{e.AssessedOn.ToString("yyyy-MM-dd")}')\">{e.Score.ToString("0.0")}</span>"));
              
              var goal = data.Goals.FirstOrDefault(g => g.UserSubjectId == s.UserSubjectId);
              var currentAvg = s.CurrentAverage10 ?? 0m;
              
              int? pct = null;
              string color = "var(--sh-slate-400)";
              
              if (goal != null && goal.TargetValue > 0)
              {
                  pct = Math.Min(100, (int)((currentAvg / goal.TargetValue) * 100));
                  color = currentAvg >= goal.TargetValue ? "var(--sh-emerald-600)" : currentAvg >= goal.TargetValue - 0.5m ? "var(--sh-amber-600)" : "var(--sh-rose-600)";
              }
              
              <tr>
                <td class="ps-4 fw-semibold" style="font-size:12px; color:var(--sh-slate-900);">
                  <div class="d-flex align-items-center gap-2">
                    @s.SubjectName
                    <button type="button" class="btn-icon-sh text-muted" style="padding: 2px" title="Sửa môn" onclick="editSubject(@s.UserSubjectId, '@s.SubjectName', '@s.TargetScore10', '@s.CreditWeight')"><i class="bi bi-pencil"></i></button>
                    <form asp-action="ArchiveUserSubject" method="post" class="d-inline" onsubmit="return confirm('Bạn muốn xóa môn @s.SubjectName khỏi học kỳ này? Điểm của môn này vẫn sẽ được lưu trữ ẩn.')">
                      <input type="hidden" name="id" value="@s.UserSubjectId" />
                      <input type="hidden" name="currentTermId" value="@data.SelectedTermId" />
                      <button type="submit" class="btn-icon-sh text-muted" style="padding: 2px" title="Xóa môn"><i class="bi bi-trash3"></i></button>
                    </form>
                  </div>
                </td>
                <td style="font-size:12px;">@Html.Raw(oralHtml)</td>
                <td style="font-size:12px;">@Html.Raw(q15Html)</td>
                <td style="font-size:12px;">@Html.Raw(q1pHtml)</td>
                <td style="font-size:12px;">@Html.Raw(midHtml)</td>
                <td style="font-size:12px;">@Html.Raw(finHtml)</td>
                <td class="fw-black" style="font-size:14px; color:@color;">@(s.CurrentAverage10?.ToString("0.0") ?? "-")</td>
                <td class="pe-4">
                  @if (pct.HasValue) {
                    <div class="d-flex align-items-center gap-2">
                      <div class="sh-progress flex-grow-1" style="height:5px;">
                        <div class="sh-progress-bar" style="width:@pct%; background:@color;"></div>
                      </div>
                      <span style="font-size:10px; font-weight:700; color:@color; white-space:nowrap;">@pct%</span>
                    </div>
                  } else {
                    <span style="font-size:11px; color:var(--sh-slate-400); font-style:italic;">Chưa đặt mục tiêu</span>
                  }
                </td>
                <td>
                  @if (s.Entries.Any()) {
                      <form asp-action="DeleteGrade" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@s.Entries.Last().Id" />
                        <button type="submit" class="btn-icon-sh danger" style="padding: 2px 6px" title="Xóa điểm gần nhất" onclick="return confirm('Bạn muốn xóa điểm gần nhất của môn này?')"><i class="bi bi-trash3"></i></button>
                      </form>
                  }
                </td>
              </tr>
            }
            @if(!data.SubjectDetails.Any()) {
                <tr>
                  <td colspan="9" class="text-center py-5">
                    @if(data.SelectedTermId.HasValue) {
                        <p class="text-muted mb-3">Bạn chưa có môn học nào trong học kỳ này.</p>
                        <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addUserSubjectModal">
                          <i class="bi bi-plus-lg"></i> Thêm môn học
                        </button>
                    } else {
                        <p class="text-muted mb-3">Bạn chưa có học kỳ nào. Hãy tạo một học kỳ để bắt đầu.</p>
                        <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addTermModal">
                          <i class="bi bi-plus-lg"></i> Tạo học kỳ
                        </button>
                    }
                  </td>
                </tr>
            }
          </tbody>
          <tfoot>
            <tr style="border-top:2px solid var(--sh-slate-200);">
              <td class="ps-4 fw-black" style="font-size:12px; color:var(--sh-slate-900);" colspan="6">
                Điểm trung bình chung
              </td>
              <td class="fw-black" style="font-size:16px; color:var(--sh-indigo-600);">@(data.Summary.CurrentAverage10?.ToString("0.0") ?? "-")</td>
              <td class="pe-4" colspan="2">
                <span class="px-2 py-0 rounded-full fw-bold"
                      style="font-size:10px; background:var(--sh-emerald-100); color:var(--sh-emerald-700);">
                  Tổng kết
                </span>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <!-- ═══ GOALS TAB ═══ -->
  <div id="goals-tab" style="display:none;">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
      <h3 class="fw-bold mb-0" style="font-size:15px; color:var(--sh-slate-900);">Mục tiêu học tập của tôi</h3>
      <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addGoalModal">
        <i class="bi bi-plus-lg"></i>Thêm mục tiêu
      </button>
    </div>

    <div class="row g-3">
      @foreach (var g in data.Goals)
      {
        var pct = g.TargetValue > 0 ? (int)Math.Min(100, (g.CurrentValue / g.TargetValue) * 100) : 0;
        var isDone = g.IsCompleted;
        var barColor = isDone ? "var(--sh-emerald-500)" : "var(--sh-indigo-600)";
        
        <div class="col-12 col-md-6">
          <div class="sh-card p-4 @(isDone ? "border-success" : "")">
            <div class="d-flex justify-content-between align-items-start gap-3">
              <div class="flex-grow-1 overflow-hidden">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <h4 class="fw-bold mb-0 truncate" style="font-size:13px; color:var(--sh-slate-900);">@g.Title</h4>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3" style="font-size:11px; color:var(--sh-slate-500);">
                  <span class="subject-badge subject-@(g.SubjectName.ToLower().Replace(" ", "").Replace("ị","i").Replace("é","e"))">@g.SubjectName</span>
                  <span><i class="bi bi-calendar3 me-1"></i>Hạn: @g.EndDate.ToString("dd/MM/yyyy")</span>
                </div>
                <!-- Score comparison -->
                <div class="d-flex align-items-center gap-3 mb-2">
                  <div class="text-center">
                    <div class="fw-black" style="font-size:20px; color:var(--sh-slate-900);">@g.CurrentValue</div>
                    <div style="font-size:10px; color:var(--sh-slate-500);">Hiện tại</div>
                  </div>
                  <i class="bi bi-arrow-right" style="color:var(--sh-slate-400);"></i>
                  <div class="text-center">
                    <div class="fw-black" style="font-size:20px; color:var(--sh-indigo-600);">@g.TargetValue</div>
                    <div style="font-size:10px; color:var(--sh-slate-500);">Mục tiêu</div>
                  </div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between mb-1" style="font-size:10px; color:var(--sh-slate-500);">
                      <span>Tiến trình</span>
                      <span class="fw-bold" style="color:@barColor;">@pct%</span>
                    </div>
                    <div class="sh-progress">
                      <div class="sh-progress-bar" style="width:@pct%; background:@barColor;"></div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="d-flex flex-column align-items-end gap-2 flex-shrink-0">
                <span class="px-2 py-0 rounded-full fw-bold"
                      style="font-size:10px; background:@(isDone ? "var(--sh-emerald-100)" : "var(--sh-indigo-100)"); color:@(isDone ? "var(--sh-emerald-700)" : "var(--sh-indigo-700)");">
                  @(isDone ? "✅ Hoàn thành" : "⏳ Đang thực hiện")
                </span>
                <div class="d-flex gap-1">
                  <button type="button" class="btn-icon-sh primary" title="Sửa mục tiêu" onclick="editGoal(@g.Id, '@Html.Raw(g.Title.Replace("'", "\\'"))', '@(g.UserSubjectId.HasValue ? g.UserSubjectId.Value.ToString() : "")', '@g.UnitCode', @g.TargetValue.ToString(System.Globalization.CultureInfo.InvariantCulture), '@g.EndDate.ToString("yyyy-MM-dd")')">
                    <i class="bi bi-pencil-square"></i>
                  </button>
                  <form asp-action="CancelGoal" method="post">
                    <input type="hidden" name="id" value="@g.Id" />
                    <button type="submit" class="btn-icon-sh danger" title="Xóa mục tiêu" onclick="return confirm('Bạn muốn xóa mục tiêu này?')">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      }
      @if(!data.Goals.Any()) {
        <div class="col-12 text-center py-4 text-muted">Chưa có mục tiêu nào.</div>
      }
    </div>
  </div>

</div>

<!-- ── Add Grade Modal ── -->
<div class="modal fade" id="addGradeModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="AddGrade" method="post" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" style="font-size:14px;"><i class="bi bi-journal-plus me-2"></i>Nhập điểm mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-6">
            <label class="sh-label">Môn học</label>
            <select name="UserSubjectId" class="sh-input" required>
              @foreach(var sd in data.SubjectDetails) {
                  <option value="@sd.UserSubjectId">@sd.SubjectName</option>
              }
            </select>
          </div>
          <div class="col-6">
            <label class="sh-label">Loại kiểm tra</label>
            <select name="AssessmentType" id="add-assessment-type" class="sh-input" onchange="updateGradeWeight(this.id, 'add-grade-weight')" required>
              <option value="Other">Miệng</option>
              <option value="Quiz">15 phút</option>
              <option value="Assignment">1 tiết</option>
              <option value="Midterm">Giữa kỳ</option>
              <option value="Final">Cuối kỳ</option>
            </select>
          </div>
          <div class="col-12">
            <label class="sh-label" for="grade-title">Tên bài kiểm tra (tùy chọn)</label>
            <input name="Title" id="grade-title" type="text" class="sh-input" placeholder="Ví dụ: Bài tập số 1" value="Kiểm tra" required />
          </div>
          <div class="col-6">
            <label class="sh-label" for="grade-score">Điểm số (0 – 10)</label>
            <input name="Score" id="grade-score" type="number" min="0" max="10" step="0.25"
                   class="sh-input grade-score-input" placeholder="8.5" required />
            <input type="hidden" name="MaxScore" value="10" />
          </div>
          <div class="col-6">
            <label class="sh-label" for="add-grade-weight">Hệ số</label>
            <select name="Weight" id="add-grade-weight" class="sh-input" required>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
            </select>
          </div>
          <div class="col-6">
            <label class="sh-label">Ngày kiểm tra</label>
            <input name="AssessedOn" type="date" class="sh-input" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
          </div>
        </div>
      </div>
      <div class="modal-footer gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn-primary-sh">
          <i class="bi bi-floppy me-1"></i>Lưu điểm
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ── Edit Grade Modal ── -->
<div class="modal fade" id="editGradeModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="UpdateGrade" method="post" class="modal-content">
      <input type="hidden" name="Id" id="edit-grade-id" />
      <div class="modal-header">
        <h5 class="modal-title fw-bold" style="font-size:14px;"><i class="bi bi-pencil me-2"></i>Sửa điểm</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-6">
            <label class="sh-label">Môn học</label>
            <select name="UserSubjectId" id="edit-grade-subject" class="sh-input" required>
              @foreach(var sd in data.SubjectDetails) {
                  <option value="@sd.UserSubjectId">@sd.SubjectName</option>
              }
            </select>
          </div>
          <div class="col-6">
            <label class="sh-label">Loại kiểm tra</label>
            <select name="AssessmentType" id="edit-assessment-type" class="sh-input" onchange="updateGradeWeight(this.id, 'edit-grade-weight')" required>
              <option value="Other">Miệng</option>
              <option value="Quiz">15 phút</option>
              <option value="Assignment">1 tiết</option>
              <option value="Midterm">Giữa kỳ</option>
              <option value="Final">Cuối kỳ</option>
            </select>
          </div>
          <div class="col-12">
            <label class="sh-label" for="edit-grade-title">Tên bài kiểm tra (tùy chọn)</label>
            <input name="Title" id="edit-grade-title" type="text" class="sh-input" required />
          </div>
          <div class="col-6">
            <label class="sh-label" for="edit-grade-score">Điểm số (0 – 10)</label>
