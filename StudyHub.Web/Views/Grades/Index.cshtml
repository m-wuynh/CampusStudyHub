<!-- ── Enter Grades Modal ── -->
<div class="modal fade" id="enterGradesModal" tabindex="-1" aria-labelledby="enterGradesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
      <div class="modal-header bg-light border-bottom">
        <h5 class="modal-title fw-bold" id="enterGradesModalLabel" style="font-size:15px; color:var(--sh-indigo-900);">
          <i class="bi bi-pencil-square me-2 text-primary"></i>Nhập điểm môn học
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
        
        <!-- Subject Selection -->
        <div class="mb-4">
          <label class="sh-label fw-bold mb-1" style="font-size: 13px; color: var(--sh-slate-700);">Chọn môn học</label>
          <select id="modalSubjectSelect" class="form-select sh-input" style="font-size: 14px; font-weight: 600;" onchange="onModalSubjectChanged(this.value)">
            <!-- Populated via JS -->
          </select>
        </div>

        <!-- Realtime Average Preview Badge -->
        <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded" style="background: var(--sh-indigo-50, #f0f4ff); border-left: 4px solid var(--sh-indigo-600);">
          <div>
            <span class="text-muted" style="font-size: 12px; font-weight: 600;">ĐTB môn dự tính:</span>
            <span id="modalSubjectAvgPreview" class="fw-black ms-2" style="font-size: 18px; color: var(--sh-indigo-700);">—</span>
          </div>
          <div class="text-muted" style="font-size: 11px;">(Tự động tính theo hệ số các cột)</div>
        </div>

        <!-- Grade Columns Grid -->
        <div id="modalColumnsContainer" class="d-flex flex-column gap-3">
          <!-- Populated via JS -->
        </div>

      </div>
      <div class="modal-footer bg-light border-top gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn-primary-sh" id="btnSaveModalGrades" onclick="saveModalGrades()">
          <i class="bi bi-floppy me-1"></i>Lưu điểm
        </button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
  // Anti Forgery Token for AJAX
  const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

  // ── Tab switching ──────────────────────────────────────────
  function gradeTab(btn, tabId) {
    document.querySelectorAll('.nav-link').forEach(b => {
      b.style.cssText = 'font-size:12px;color:var(--sh-slate-500);border:0;background:transparent;padding:8px 16px;font-weight:600;';
      b.classList.remove('active');
    });
    btn.style.cssText = 'font-size:12px;font-weight:700;color:var(--sh-indigo-600);border-bottom:2px solid var(--sh-indigo-600);border-top:0;border-left:0;border-right:0;background:transparent;padding:8px 16px;';
    document.getElementById('grades-tab').style.display = tabId === 'grades-tab' ? 'block' : 'none';
    document.getElementById('goals-tab').style.display = tabId === 'goals-tab' ? 'block' : 'none';
  }

  // ── Mode Switching ─────────────────────────────────────────
  function setUiMode(mode) {
      // mode can be 'view', 'score', 'structure'
      const modes = ['view', 'score', 'structure'];
      
      // Update Headers
      modes.forEach(m => {
          const header = document.getElementById(`${m}-mode-header`);
          if(header) {
              if (m === mode) {
                  header.style.display = (m === 'view' ? 'block' : 'flex');
              } else {
                  header.style.display = 'none';
              }
          }
      });

      // Update Actions (only in view mode)
      const actions = document.getElementById('view-mode-actions');
      if (actions) {
          if (mode === 'view') {
              actions.style.setProperty('display', 'flex', 'important');
          } else {
              actions.style.setProperty('display', 'none', 'important');
          }
      }

      // Update Tables
      modes.forEach(m => {
          const table = document.getElementById(`table-${m}-mode`);
          if(table) table.style.display = (m === mode) ? 'block' : 'none';
      });

      // Reset URL if going back to view mode to avoid editMode lingering
      if (mode === 'view' && window.location.search.includes('editMode')) {
          window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId";
      }
  }

  async function updateGradeBookName(gradeBookId, name) {
      if(!name.trim()) return;
      try {
          const formData = new FormData();
          formData.append('GradeBookId', gradeBookId);
          formData.append('Name', name);
          formData.append('currentGradeBookId', '@data.SelectedGradeBookId');
          
          const resp = await fetch('/Grades/UpdateGradeBook', {
              method: 'POST',
              headers: {
                  'RequestVerificationToken': csrfToken
              },
              body: formData
          });
          
          const result = await resp.json();
          if (result.ok) {
              const status = document.getElementById('gradebook-name-status');
              if (status) {
                  status.style.display = 'inline-block';
                  setTimeout(() => { status.style.display = 'none'; }, 2000);
              }
              const viewHeader = document.querySelector('#view-mode-header h3');
              if (viewHeader) viewHeader.textContent = name;
              
              const scoreHeader = document.querySelector('#score-mode-header h3');
              if (scoreHeader) scoreHeader.innerHTML = `${name} <span class="badge bg-primary" style="font-size:10px; margin-left:4px;">Nhập điểm</span>`;
          } else {
              alert("Lỗi: " + (result.message || "Không thể cập nhật tên"));
          }
      } catch (e) {
          alert("Lỗi kết nối");
      }
  }

  document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const editMode = urlParams.get('editMode');
      if (editMode === 'structure') {
          setUiMode('structure');
      } else if (editMode === 'score' || editMode === 'true') {
          setUiMode('score');
      }
      const wizardModal = document.getElementById('wizardGradeBookModal');
      if (wizardModal) {
          wizardModal.addEventListener('show.bs.modal', () => {
              wizardGoToStep(1);
          });
      }
  });

  // ── Wizard Logic ─────────────────────────────────────────────
  function wizardGoToStep(step) {
      if (step === 2) {
          // Validate step 1
          const nameInput = document.querySelector('#wizard-step-1 input[name="Name"]');
          if (!nameInput.value.trim()) {
              nameInput.reportValidity();
              return;
          }
          
          const numCols = parseInt(document.getElementById('wizard-column-count').value) || 0;
          const numSubjs = parseInt(document.getElementById('wizard-subject-count').value) || 0;
          
          let colsHtml = '';
          for (let i = 0; i < numCols; i++) {
              colsHtml += `
                  <div class="row g-2 mb-2">
                      <div class="col-8">
                          <input type="text" name="Columns[${i}].Name" class="sh-input" placeholder="Tên cột ${i+1}" required maxlength="100">
                      </div>
                      <div class="col-4">
                          <input type="number" name="Columns[${i}].Weight" class="sh-input" placeholder="Hệ số" value="1" step="0.1" min="0.1" required>
                      </div>
                  </div>
              `;
          }
          document.getElementById('wizard-columns-container').innerHTML = colsHtml;
          
          let subjsHtml = '';
          for (let i = 0; i < numSubjs; i++) {
              subjsHtml += `
                  <div class="mb-2">
                      <input type="text" name="SubjectNames[${i}]" class="sh-input" placeholder="Tên môn học ${i+1}" required maxlength="200">
                  </div>
              `;
          }
          document.getElementById('wizard-subjects-container').innerHTML = subjsHtml;

          document.getElementById('wizard-step-1').style.display = 'none';
          document.getElementById('btn-wizard-next').style.display = 'none';
          
          document.getElementById('wizard-step-2').style.display = 'block';
          document.getElementById('btn-wizard-back').style.display = 'block';
          document.getElementById('btn-wizard-submit').style.display = 'block';
      } else {
          document.getElementById('wizard-step-2').style.display = 'none';
          document.getElementById('btn-wizard-back').style.display = 'none';
          document.getElementById('btn-wizard-submit').style.display = 'none';
          
          document.getElementById('wizard-step-1').style.display = 'block';
          document.getElementById('btn-wizard-next').style.display = 'block';
      }
  }

  // ── Inline Edit Logic ─────────────────────────────────────────
  let currentlyEditing = null;

  function openInlineEdit(spanEl, entryId, subjectId, columnId, currentScore) {
      if (currentlyEditing) return; // one at a time
      currentlyEditing = spanEl;

      const originalHtml = spanEl.innerHTML;
      const isNew = entryId === null;
      
      const input = document.createElement('input');
      input.type = 'number';
      input.step = '0.1';
      input.min = '0';
      input.max = '10';
      input.className = 'sh-input form-control-sm border border-primary';
      input.style.cssText = 'width: 50px; padding: 2px 4px; font-size: 12px; height: auto; display: inline-block; text-align: center;';
      if (!isNew) {
          input.value = currentScore;
      }
      
      spanEl.innerHTML = '';
      spanEl.appendChild(input);
      input.focus();

      const saveFn = async () => {
          const val = input.value.trim();
          if (val === '') {
              // Revert
              spanEl.innerHTML = originalHtml;
              currentlyEditing = null;
              return;
          }
          
          const num = parseFloat(val);
          if (isNaN(num) || num < 0 || num > 10) {
              alert('Điểm phải từ 0 đến 10.');
              input.focus();
              return;
          }

          input.disabled = true;
          try {
              let url, payload;
              if (isNew) {
                  url = '/Grades/AddGrade';
                  payload = { UserSubjectId: subjectId, GradeColumnId: columnId, Score: num };
              } else {
                  url = '/Grades/UpdateGrade';
                  payload = { Id: entryId, Score: num };
              }

              const resp = await fetch(url, {
                  method: 'POST',
                  headers: {
                      'Content-Type': 'application/json',
                      'RequestVerificationToken': csrfToken
                  },
                  body: JSON.stringify(payload)
              });
              
              const result = await resp.json();
              if (result.ok) {
                  window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId&editMode=score";
              } else {
                  alert("Lỗi: " + result.error);
                  spanEl.innerHTML = originalHtml;
                  currentlyEditing = null;
              }
          } catch(e) {
              alert("Lỗi kết nối");
              spanEl.innerHTML = originalHtml;
              currentlyEditing = null;
          }
      };

      input.addEventListener('blur', saveFn);
      input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
              input.blur();
          } else if (e.key === 'Escape') {
              input.removeEventListener('blur', saveFn);
              spanEl.innerHTML = originalHtml;
              currentlyEditing = null;
          }
      });
  }

  async function deleteGradeInline(entryId, btnEl) {
      if(!confirm("Bạn có chắc chắn muốn xóa điểm này?")) return;
      btnEl.disabled = true;
      try {
          const resp = await fetch('/Grades/DeleteGrade', {
              method: 'POST',
              headers: {
                  'Content-Type': 'application/json',
                  'RequestVerificationToken': csrfToken
              },
              body: JSON.stringify({ Id: entryId })
          });
          const result = await resp.json();
          if (result.ok) {
              window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId&editMode=score";
          } else {
              alert("Lỗi: " + result.error);
              btnEl.disabled = false;
          }
      } catch(e) {
          alert("Lỗi kết nối");
          btnEl.disabled = false;
      }
  }

  // ── Reorder Logic ─────────────────────────────────────────────
  async function moveColumn(colId, dir) {
      const row = document.getElementById('structure-mode-header-row');
      const ths = Array.from(row.querySelectorAll('th[data-col-id]'));
      const idx = ths.findIndex(th => th.getAttribute('data-col-id') == colId);
      if (idx < 0) return;
      if (dir === -1 && idx === 0) return;
      if (dir === 1 && idx === ths.length - 1) return;

      // Swap array elements to compute new display orders
      const newOrders = ths.map((th, i) => ({
          GradeColumnId: parseInt(th.getAttribute('data-col-id')),
          NewDisplayOrder: i + 1
      }));
      
      const targetIdx = idx + dir;
      // swap in newOrders
      const temp = newOrders[idx].NewDisplayOrder;
      newOrders[idx].NewDisplayOrder = newOrders[targetIdx].NewDisplayOrder;
      newOrders[targetIdx].NewDisplayOrder = temp;

      try {
          const resp = await fetch('/Grades/ReorderColumns', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
              body: JSON.stringify({ GradeBookId: @(gradeBook?.GradeBookId ?? 0), Columns: newOrders })
          });
          const result = await resp.json();
          if(result.ok) window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId&editMode=structure";
          else alert(result.error);
      } catch(e) { alert("Lỗi kết nối"); }
  }

  async function moveSubject(subId, dir) {
      const tbody = document.querySelector('#structure-table-grid tbody');
      const trs = Array.from(tbody.querySelectorAll('tr[data-subject-id]'));
      const idx = trs.findIndex(tr => tr.getAttribute('data-subject-id') == subId);
      if (idx < 0) return;
      if (dir === -1 && idx === 0) return;
      if (dir === 1 && idx === trs.length - 1) return;

      const newOrders = trs.map((tr, i) => ({
          UserSubjectId: parseInt(tr.getAttribute('data-subject-id')),
          NewDisplayOrder: i + 1
      }));
      
      const targetIdx = idx + dir;
      const temp = newOrders[idx].NewDisplayOrder;
      newOrders[idx].NewDisplayOrder = newOrders[targetIdx].NewDisplayOrder;
      newOrders[targetIdx].NewDisplayOrder = temp;

      try {
          const resp = await fetch('/Grades/ReorderSubjects', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
              body: JSON.stringify({ Subjects: newOrders })
          });
          const result = await resp.json();
          if(result.ok) window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId&editMode=structure";
          else alert(result.error);
      } catch(e) { alert("Lỗi kết nối"); }
  }

  // ── Column & Subject Edit Modals ─────────────────────────────────
  function editColumn(id, name, weight, order) {
    document.getElementById('editColumnId').value = id;
    document.getElementById('editColumnName').value = name;
    document.getElementById('editColumnWeight').value = weight;
    document.getElementById('editColumnOrder').value = order;
    new bootstrap.Modal(document.getElementById('editColumnModal')).show();
  }
  function editSubject(id, name, weight) {
    document.getElementById('editUserSubjectId').value = id;
    document.getElementById('editSubjectName').value = name;
    document.getElementById('editCreditWeight').value = weight;
    new bootstrap.Modal(document.getElementById('editUserSubjectModal')).show();
  }
  function openAddGoalForSubject(id, name) {
    const sel = document.getElementById('addGoalSubjectId');
    if(sel) sel.value = id;
    new bootstrap.Modal(document.getElementById('addGoalModal')).show();
  }
  function editGoal(id, title, deadline) {
    document.getElementById('editGoalId').value = id;
    document.getElementById('edit-goal-title').value = title;
    if(deadline) document.getElementById('edit-goal-deadline').value = deadline;
    new bootstrap.Modal(document.getElementById('editGoalModal')).show();
  }

  // Common Date Validation for GradeBooks
  function validateAddGradeBook(form) {
      const start = document.getElementById('displayStartDate').value;
      const end = document.getElementById('displayEndDate').value;
      
      function parseDMY(str) {
          const parts = str.split('/');
          if(parts.length !== 3) return null;
          return new Date(parts[2], parts[1]-1, parts[0]);
      }
      
      const dStart = parseDMY(start);
      const dEnd = parseDMY(end);
      
      if(!dStart || !dEnd) {
          alert("Vui lòng nhập ngày theo định dạng dd/MM/yyyy");
          return false;
      }
      
      if(dStart >= dEnd) {
          alert("Ngày bắt đầu phải trước ngày kết thúc");
          return false;
      }
      
      document.getElementById('hiddenStartDate').value = dStart.toISOString().split('T')[0];
      document.getElementById('hiddenEndDate').value = dEnd.toISOString().split('T')[0];
      return true;
  }

  // ── Enter Grades Modal Logic ─────────────────────────────────
  const subjectData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.SubjectDetails ?? new List<SubjectGradeDetailDto>()));
  const columnData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(columns ?? new List<GradeColumnDto>()));

  let modalCurrentSubjectId = null;
  let modalScores = [];
  let modalTempIdCounter = 1;

  function openEnterGradesModal(targetSubjectId) {
      const modalEl = document.getElementById('enterGradesModal');
      if (!modalEl) return;
      const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);

      const selectEl = document.getElementById('modalSubjectSelect');
      selectEl.innerHTML = '';

      if (!subjectData || subjectData.length === 0) {
          selectEl.innerHTML = '<option value="">(Chưa có môn học nào)</option>';
          document.getElementById('modalColumnsContainer').innerHTML = '<div class="alert alert-info" style="font-size:13px;"><i class="bi bi-info-circle me-1"></i>Vui lòng thêm môn học vào bảng điểm trước khi nhập điểm.</div>';
          document.getElementById('modalSubjectAvgPreview').textContent = '—';
          bsModal.show();
          return;
      }

      subjectData.forEach(sub => {
          const subId = sub.userSubjectId || sub.UserSubjectId;
          const subName = sub.subjectName || sub.SubjectName;
          const opt = document.createElement('option');
          opt.value = subId;
          opt.textContent = subName;
          selectEl.appendChild(opt);
      });

      let initialSubjectId = targetSubjectId;
      if (!initialSubjectId && subjectData.length > 0) {
          initialSubjectId = subjectData[0].userSubjectId || subjectData[0].UserSubjectId;
      }

      if (initialSubjectId) {
          selectEl.value = initialSubjectId;
          onModalSubjectChanged(initialSubjectId);
      }

      bsModal.show();
  }

  function onModalSubjectChanged(subjectId) {
      modalCurrentSubjectId = parseInt(subjectId);
      if (!modalCurrentSubjectId) {
          document.getElementById('modalColumnsContainer').innerHTML = '';
          document.getElementById('modalSubjectAvgPreview').textContent = '—';
          return;
      }

      const subject = subjectData.find(s => (s.userSubjectId || s.UserSubjectId) == modalCurrentSubjectId);
      if (!subject) return;

      modalScores = [];
      const entries = subject.entries || subject.Entries || [];
      entries.forEach(e => {
          modalScores.push({
              tempId: 'temp_' + (modalTempIdCounter++),
              id: e.id || e.Id || null,
              gradeColumnId: e.gradeColumnId || e.GradeColumnId,
              score: e.score !== undefined ? e.score : (e.Score !== undefined ? e.Score : 0)
          });
      });

      renderModalColumns();
  }

  function renderModalColumns() {
      const container = document.getElementById('modalColumnsContainer');
      container.innerHTML = '';

      if (!columnData || columnData.length === 0) {
          container.innerHTML = '<div class="alert alert-warning" style="font-size:13px;"><i class="bi bi-exclamation-triangle me-2"></i>Sổ điểm này chưa có cột đánh giá nào. Vui lòng thêm cột ở mục "Chỉnh sửa bảng".</div>';
          updateModalAvgPreview();
          return;
      }

      columnData.forEach(col => {
          const colId = col.gradeColumnId || col.GradeColumnId;
          const colName = col.name || col.Name;
          const colWeight = col.weight || col.Weight;

          const colScores = modalScores.filter(s => s.gradeColumnId == colId);

          const card = document.createElement('div');
          card.className = 'card border rounded-3 p-3 bg-white shadow-sm';

          let scoresHtml = '';
          if (colScores.length === 0) {
              scoresHtml = `<span class="text-muted fst-italic" style="font-size: 12px;">Chưa có điểm. Bấm [+ Thêm điểm] để nhập.</span>`;
          } else {
              scoresHtml = colScores.map(s => `
                  <div class="input-group input-group-sm" style="width: 110px;" id="score-item-${s.tempId}">
                      <input type="number" min="0" max="10" step="0.1" class="form-control text-center fw-bold" 
                             style="color: var(--sh-indigo-600); font-size: 14px;"
                             value="${s.score}" 
                             onchange="updateModalScore('${s.tempId}', this.value)" 
                             onkeyup="updateModalScore('${s.tempId}', this.value)" />
                      <button class="btn btn-outline-danger px-2" type="button" onclick="removeModalScore('${s.tempId}')" title="Xóa điểm">
                          <i class="bi bi-x-lg"></i>
                      </button>
                  </div>
              `).join('');
          }

          card.innerHTML = `
              <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                  <div class="d-flex align-items-center gap-2">
                      <span class="fw-bold" style="font-size: 14px; color: var(--sh-slate-800);">${escapeHtml(colName)}</span>
                      <span class="badge bg-secondary" style="font-size: 11px;">Hệ số ${colWeight}</span>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-primary" style="font-size: 12px; padding: 2px 10px;" onclick="addScoreToColumn(${colId})">
                      <i class="bi bi-plus-lg me-1"></i>Thêm điểm
                  </button>
              </div>
              <div class="d-flex flex-wrap gap-2 align-items-center" id="scores-container-${colId}">
                  ${scoresHtml}
              </div>
          `;
          container.appendChild(card);
      });

      updateModalAvgPreview();
  }

  function addScoreToColumn(columnId) {
      const newTempId = 'temp_' + (modalTempIdCounter++);
      modalScores.push({
          tempId: newTempId,
          id: null,
          gradeColumnId: columnId,
          score: 10
      });
      renderModalColumns();
  }

  function updateModalScore(tempId, val) {
      const num = parseFloat(val);
      const item = modalScores.find(s => s.tempId === tempId);
      if (item) {
          item.score = isNaN(num) ? 0 : Math.min(10, Math.max(0, num));
      }
      updateModalAvgPreview();
  }

  function removeModalScore(tempId) {
      modalScores = modalScores.filter(s => s.tempId !== tempId);
      renderModalColumns();
  }

  function updateModalAvgPreview() {
      let weightedSum = 0;
      let totalWeight = 0;

      modalScores.forEach(s => {
          const col = columnData.find(c => (c.gradeColumnId || c.GradeColumnId) == s.gradeColumnId);
          if (col) {
              const weight = parseFloat(col.weight || col.Weight || 1);
              const score = parseFloat(s.score);
              if (!isNaN(score) && score >= 0 && score <= 10) {
                  weightedSum += score * weight;
                  totalWeight += weight;
              }
          }
      });

      const previewEl = document.getElementById('modalSubjectAvgPreview');
      if (previewEl) {
          if (totalWeight > 0) {
              const avg = (weightedSum / totalWeight).toFixed(2);
              previewEl.textContent = avg;
          } else {
              previewEl.textContent = '—';
          }
      }
  }

  async function saveModalGrades() {
      if (!modalCurrentSubjectId) {
          alert("Vui lòng chọn môn học.");
          return;
      }

      const btn = document.getElementById('btnSaveModalGrades');
      if (btn) btn.disabled = true;

      const payload = {
          UserSubjectId: modalCurrentSubjectId,
          Entries: modalScores.map(s => ({
              GradeEntryId: s.id && s.id > 0 ? s.id : null,
              GradeColumnId: s.gradeColumnId,
              Score: parseFloat(s.score) || 0
          }))
      };

      try {
          const token = csrfToken || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
          const resp = await fetch('/Grades/SaveSubjectGrades', {
              method: 'POST',
              headers: {
                  'Content-Type': 'application/json',
                  'RequestVerificationToken': token || ''
              },
              body: JSON.stringify(payload)
          });

          const result = await resp.json();
          if (result.ok) {
              window.location.reload();
          } else {
              alert("Lỗi khi lưu điểm: " + (result.message || "Không xác định"));
              if (btn) btn.disabled = false;
          }
      } catch (e) {
          alert("Lỗi kết nối khi lưu điểm.");
          if (btn) btn.disabled = false;
      }
  }

  function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
</script>
}


