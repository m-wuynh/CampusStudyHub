<div class="modal fade" id="editActivityModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form id="editActivityForm" onsubmit="submitEditActivity(event)" class="modal-content">
      <input type="hidden" name="ActivityId" id="editActivityId" />
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" style="font-size:15px;"><i class="bi bi-pencil-square me-2 text-primary"></i>Sửa hoạt động rèn luyện</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="sh-label" for="edit-activity-title">Tên hoạt động</label>
          <input name="Title" id="edit-activity-title" type="text" class="sh-input" required />
        </div>
        <div class="row g-2 mb-3">
          <div class="col-6">
            <label class="sh-label" for="edit-activity-start">Thời gian bắt đầu</label>
            <input name="StartAtLocal" id="edit-activity-start" type="datetime-local" class="sh-input" required />
          </div>
          <div class="col-6">
            <label class="sh-label" for="edit-activity-end">Thời gian kết thúc</label>
            <input name="EndAtLocal" id="edit-activity-end" type="datetime-local" class="sh-input" required />
          </div>
        </div>
        <div class="mb-2">
          <label class="sh-label" for="edit-activity-desc">Ghi chú / Mô tả (tùy chọn)</label>
          <textarea name="Description" id="edit-activity-desc" rows="2" class="sh-input"></textarea>
        </div>
      </div>
      <div class="modal-footer gap-2 border-0 pt-0">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn-primary-sh"><i class="bi bi-save me-1"></i>Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>


<!-- ── Delete GradeBook Confirmation Modal ── -->
<div class="modal fade" id="deleteGradeBookModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="DeleteGradeBook" method="post" class="modal-content">
      <input type="hidden" name="id" value="@(gradeBook?.GradeBookId ?? data.SelectedGradeBookId ?? 0)" />
      <input type="hidden" name="currentGradeBookId" value="@data.SelectedGradeBookId" />
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xóa bảng điểm?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="fw-bold mb-2">Thao tác này sẽ xóa vĩnh viễn:</p>
        <ul class="mb-3" style="font-size: 13px; color: var(--sh-slate-700);">
            <li>Bảng điểm</li>
            <li>Các môn học</li>
            <li>Các cột điểm</li>
            <li>Toàn bộ điểm đã nhập</li>
        </ul>
        <div class="alert alert-danger mb-0" style="font-size:12px;">
          <i class="bi bi-exclamation-circle me-1"></i> Dữ liệu sau khi xóa không thể khôi phục.
        </div>
      </div>
      <div class="modal-footer gap-2 border-0 pt-0">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn-primary-sh bg-danger border-danger"><i class="bi bi-trash3 me-1"></i>Tôi hiểu, xóa bảng điểm</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Enter Grades Modal ── -->
<div class="modal fade" id="enterGradesModal" tabindex="-1" aria-labelledby="enterGradesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
      <div class="modal-header bg-light border-bottom">
        <h5 class="modal-title fw-bold" id="enterGradesModalLabel" style="font-size:15px; color:var(--sh-indigo-900);">
          <i class="bi bi-pencil-square me-2 text-primary"></i>Nhập điểm môn học
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
        
        <!-- Subject Selection -->
        <div class="mb-3">
          <label class="sh-label fw-bold mb-1" style="font-size: 13px; color: var(--sh-slate-700);">Chọn môn học</label>
          <select id="modalSubjectSelect" class="form-select sh-input" style="font-size: 14px; font-weight: 600;" onchange="onModalSubjectChanged(this.value)">
            <!-- Populated via JS -->
          </select>
          <div class="form-text text-muted mt-2" style="font-size: 12px;">
            <i class="bi bi-info-circle me-1 text-primary"></i>Nhập nhiều điểm phân cách bằng dấu phẩy, ví dụ: 8.0, 9.0
          </div>
        </div>


        <!-- Grade Columns Grid -->
        <div id="modalColumnsContainer" class="d-flex flex-column gap-3">
          <!-- Populated via JS -->
        </div>

      </div>
      <div class="modal-footer bg-light border-top gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn-primary-sh" id="btnSaveModalGrades" onclick="saveModalGrades()">
          <i class="bi bi-floppy me-1"></i>Lưu điểm
        </button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
  // Anti Forgery Token for AJAX
  const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

  // ── Tab switching ──────────────────────────────────────────
  function gradeTab(btn, tabId) {
    document.querySelectorAll('.nav-link').forEach(b => {
      b.style.cssText = 'font-size:12px;color:var(--sh-slate-500);border:0;background:transparent;padding:8px 16px;font-weight:600;';
      b.classList.remove('active');
    });
    if (btn) {
      btn.style.cssText = 'font-size:12px;font-weight:700;color:var(--sh-indigo-600);border-bottom:2px solid var(--sh-indigo-600);border-top:0;border-left:0;border-right:0;background:transparent;padding:8px 16px;';
      btn.classList.add('active');
    }
    const gradesTabEl = document.getElementById('grades-tab');
    const goalsTabEl = document.getElementById('goals-tab');
    if (gradesTabEl) gradesTabEl.style.display = tabId === 'grades-tab' ? 'block' : 'none';
    if (goalsTabEl) goalsTabEl.style.display = tabId === 'goals-tab' ? 'block' : 'none';

    try {
      localStorage.setItem('activeGradeTab', tabId);
      if (tabId === 'goals-tab') {
        if (!window.location.hash.includes('goals')) {
          history.replaceState(null, '', window.location.pathname + window.location.search + '#goals');
        }
      } else {
        if (window.location.hash.includes('goals')) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }
    } catch(e) {}
  }

  // ── Mode Switching ─────────────────────────────────────────
  function setUiMode(mode) {
      // mode can be 'view', 'score', 'structure'
      const modes = ['view', 'score', 'structure'];
      
      // Update Headers
      modes.forEach(m => {
          const header = document.getElementById(`${m}-mode-header`);
          if(header) {
              if (m === mode) {
                  header.style.display = (m === 'view' ? 'block' : 'flex');
              } else {
                  header.style.display = 'none';
              }
          }
      });

      // Update Actions (only in view mode)
      const actions = document.getElementById('view-mode-actions');
      if (actions) {
          if (mode === 'view') {
              actions.style.setProperty('display', 'flex', 'important');
          } else {
              actions.style.setProperty('display', 'none', 'important');
          }
      }

      // Update Tables
      modes.forEach(m => {
          const table = document.getElementById(`table-${m}-mode`);
          if(table) table.style.display = (m === mode) ? 'block' : 'none';
      });

      // Reset URL if going back to view mode to avoid editMode lingering
      if (mode === 'view' && window.location.search.includes('editMode')) {
          window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId";
      }
  }

  async function updateGradeBookName(gradeBookId, name) {
      if(!name.trim()) return;
      try {
          const formData = new FormData();
          formData.append('GradeBookId', gradeBookId);
          formData.append('Name', name);
          formData.append('currentGradeBookId', '@data.SelectedGradeBookId');
          
          const resp = await fetch('/Grades/UpdateGradeBook', {
              method: 'POST',
              headers: {
                  'RequestVerificationToken': csrfToken
              },
              body: formData
          });
          
          const result = await resp.json();
          if (result.ok) {
              const status = document.getElementById('gradebook-name-status');
              if (status) {
                  status.style.display = 'inline-block';
                  setTimeout(() => { status.style.display = 'none'; }, 2000);
              }
              const viewHeader = document.querySelector('#view-mode-header h3');
              if (viewHeader) viewHeader.textContent = name;
              
              const scoreHeader = document.querySelector('#score-mode-header h3');
              if (scoreHeader) scoreHeader.innerHTML = `${name} <span class="badge bg-primary" style="font-size:10px; margin-left:4px;">Nhập điểm</span>`;
          } else {
              alert("Lỗi: " + (result.message || "Không thể cập nhật tên"));
          }
      } catch (e) {
          alert("Lỗi kết nối");
      }
  }

  document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const editMode = urlParams.get('editMode');
      if (editMode === 'structure') {
          setUiMode('structure');
      } else if (editMode === 'score' || editMode === 'true') {
          setUiMode('score');
      }

      if (!editMode && (window.location.hash === '#goals' || localStorage.getItem('activeGradeTab') === 'goals-tab')) {
          const goalsBtn = document.getElementById('tab-btn-goals');
          if (goalsBtn) gradeTab(goalsBtn, 'goals-tab');
      }

      const wizardModal = document.getElementById('wizardGradeBookModal');
      if (wizardModal) {
          wizardModal.addEventListener('show.bs.modal', () => {
              wizardGoToStep(1);
          });
      }
  });

  // ── Wizard Logic ─────────────────────────────────────────────
  const existingGradeBooks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.GradeBooks.Select(gb => new { gb.FromYear, gb.ToYear })));

  function wizardGoToStep(step) {
      if (step === 2) {
          // Validate step 1
          const nameInput = document.querySelector('#wizard-step-1 input[name="Name"]');
          if (!nameInput.value.trim()) {
              nameInput.reportValidity();
              return;
          }

          const fromYear = parseInt(document.getElementById('wizardFromYear').value) || 0;
          const toYear = parseInt(document.getElementById('wizardToYear').value) || 0;
          const exists = existingGradeBooks && existingGradeBooks.some(gb => (gb.fromYear || gb.FromYear) === fromYear && (gb.toYear || gb.ToYear) === toYear);
          if (exists) {
              if (window.showToast) {
                  window.showToast('Sổ điểm này đã tồn tại', 'error');
              } else {
                  alert('Sổ điểm này đã tồn tại');
              }
              return;
          }
          
          const numCols = parseInt(document.getElementById('wizard-column-count').value) || 0;
          const numSubjs = parseInt(document.getElementById('wizard-subject-count').value) || 0;
          
          let colsHtml = '';
          for (let i = 0; i < numCols; i++) {
              colsHtml += `
                  <div class="row g-2 mb-2">
                      <div class="col-8">
                          <input type="text" name="Columns[${i}].Name" class="sh-input" placeholder="Tên cột ${i+1}" required maxlength="100">
                      </div>
                      <div class="col-4">
                          <input type="number" name="Columns[${i}].Weight" class="sh-input" placeholder="Hệ số" value="1" step="0.1" min="0.1" required>
                      </div>
                  </div>
              `;
          }
          document.getElementById('wizard-columns-container').innerHTML = colsHtml;
          
          let subjsHtml = '';
          for (let i = 0; i < numSubjs; i++) {
              subjsHtml += `
                  <div class="mb-2">
                      <input type="text" name="SubjectNames[${i}]" class="sh-input" placeholder="Tên môn học ${i+1}" required maxlength="200">
                  </div>
              `;
          }
          document.getElementById('wizard-subjects-container').innerHTML = subjsHtml;

          document.getElementById('wizard-step-1').style.display = 'none';
          document.getElementById('btn-wizard-next').style.display = 'none';
          
          document.getElementById('wizard-step-2').style.display = 'block';
          document.getElementById('btn-wizard-back').style.display = 'block';
          document.getElementById('btn-wizard-submit').style.display = 'block';
      } else {
          document.getElementById('wizard-step-2').style.display = 'none';
          document.getElementById('btn-wizard-back').style.display = 'none';
          document.getElementById('btn-wizard-submit').style.display = 'none';
          
          document.getElementById('wizard-step-1').style.display = 'block';
          document.getElementById('btn-wizard-next').style.display = 'block';
      }
  }

  // ── Inline Edit Logic ─────────────────────────────────────────
  let currentlyEditing = null;

  function openInlineEdit(spanEl, entryId, subjectId, columnId, currentScore) {
      if (currentlyEditing) return; // one at a time
      currentlyEditing = spanEl;

      const originalHtml = spanEl.innerHTML;
      const isNew = entryId === null;
      
      const input = document.createElement('input');
      input.type = 'number';
      input.step = '0.1';
      input.min = '0';
      input.max = '10';
      input.className = 'sh-input form-control-sm border border-primary';
      input.style.cssText = 'width: 50px; padding: 2px 4px; font-size: 12px; height: auto; display: inline-block; text-align: center;';
      if (!isNew) {
          input.value = currentScore;
      }
      
      spanEl.innerHTML = '';
      spanEl.appendChild(input);
      input.focus();

      const saveFn = async () => {
          const val = input.value.trim();
          if (val === '') {
              // Revert
              spanEl.innerHTML = originalHtml;
              currentlyEditing = null;
              return;
          }
          
          const num = parseFloat(val);
          if (isNaN(num) || num < 0 || num > 10) {
              alert('Điểm phải từ 0 đến 10.');
              input.focus();
              return;
          }

          input.disabled = true;
          try {
              let url, payload;
              if (isNew) {
                  url = '/Grades/AddGrade';
                  payload = { UserSubjectId: subjectId, GradeColumnId: columnId, Score: num };
              } else {
                  url = '/Grades/UpdateGrade';
                  payload = { Id: entryId, Score: num };
              }

              const resp = await fetch(url, {
                  method: 'POST',
                  headers: {
                      'Content-Type': 'application/json',
                      'RequestVerificationToken': csrfToken
                  },
                  body: JSON.stringify(payload)
              });
              
              const result = await resp.json();
              if (result.ok) {
                  window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId&editMode=score";
              } else {
                  alert("Lỗi: " + result.error);
                  spanEl.innerHTML = originalHtml;
                  currentlyEditing = null;
              }
          } catch(e) {
              alert("Lỗi kết nối");
              spanEl.innerHTML = originalHtml;
              currentlyEditing = null;
          }
      };

      input.addEventListener('blur', saveFn);
      input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
              input.blur();
          } else if (e.key === 'Escape') {
              input.removeEventListener('blur', saveFn);
              spanEl.innerHTML = originalHtml;
              currentlyEditing = null;
          }
      });
  }

  async function deleteGradeInline(entryId, btnEl) {
      if(!confirm("Bạn có chắc chắn muốn xóa điểm này?")) return;
      btnEl.disabled = true;
      try {
          const resp = await fetch('/Grades/DeleteGrade', {
              method: 'POST',
              headers: {
                  'Content-Type': 'application/json',
                  'RequestVerificationToken': csrfToken
              },
              body: JSON.stringify({ Id: entryId })
          });
          const result = await resp.json();
          if (result.ok) {
              window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId&editMode=score";
          } else {
              alert("Lỗi: " + result.error);
              btnEl.disabled = false;
          }
      } catch(e) {
          alert("Lỗi kết nối");
          btnEl.disabled = false;
      }
  }

  // ── Reorder Logic ─────────────────────────────────────────────
  async function moveColumn(colId, dir) {
      const row = document.getElementById('structure-mode-header-row');
      const ths = Array.from(row.querySelectorAll('th[data-col-id]'));
      const idx = ths.findIndex(th => th.getAttribute('data-col-id') == colId);
      if (idx < 0) return;
      if (dir === -1 && idx === 0) return;
      if (dir === 1 && idx === ths.length - 1) return;

      // Swap array elements to compute new display orders
      const newOrders = ths.map((th, i) => ({
          GradeColumnId: parseInt(th.getAttribute('data-col-id')),
          NewDisplayOrder: i + 1
      }));
      
      const targetIdx = idx + dir;
      // swap in newOrders
      const temp = newOrders[idx].NewDisplayOrder;
      newOrders[idx].NewDisplayOrder = newOrders[targetIdx].NewDisplayOrder;
      newOrders[targetIdx].NewDisplayOrder = temp;

      try {
          const resp = await fetch('/Grades/ReorderColumns', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
              body: JSON.stringify({ GradeBookId: @(gradeBook?.GradeBookId ?? 0), Columns: newOrders })
          });
          const result = await resp.json();
          if(result.ok) window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId&editMode=structure";
          else alert(result.error);
      } catch(e) { alert("Lỗi kết nối"); }
  }

  async function moveSubject(subId, dir) {
      const tbody = document.querySelector('#structure-table-grid tbody');
      const trs = Array.from(tbody.querySelectorAll('tr[data-subject-id]'));
      const idx = trs.findIndex(tr => tr.getAttribute('data-subject-id') == subId);
      if (idx < 0) return;
      if (dir === -1 && idx === 0) return;
      if (dir === 1 && idx === trs.length - 1) return;

      const newOrders = trs.map((tr, i) => ({
          UserSubjectId: parseInt(tr.getAttribute('data-subject-id')),
          NewDisplayOrder: i + 1
      }));
      
      const targetIdx = idx + dir;
      const temp = newOrders[idx].NewDisplayOrder;
      newOrders[idx].NewDisplayOrder = newOrders[targetIdx].NewDisplayOrder;
      newOrders[targetIdx].NewDisplayOrder = temp;

      try {
          const resp = await fetch('/Grades/ReorderSubjects', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
              body: JSON.stringify({ Subjects: newOrders })
          });
          const result = await resp.json();
          if(result.ok) window.location.href = window.location.pathname + "?gradeBookId=@data.SelectedGradeBookId&editMode=structure";
          else alert(result.error);
      } catch(e) { alert("Lỗi kết nối"); }
  }

  // ── Column & Subject Edit Modals ─────────────────────────────────
  function editColumn(id, name, weight, order) {
    document.getElementById('editColumnId').value = id;
    document.getElementById('editColumnName').value = name;
    document.getElementById('editColumnWeight').value = weight;
    document.getElementById('editColumnOrder').value = order;
    new bootstrap.Modal(document.getElementById('editColumnModal')).show();
  }
  function editSubject(id, name, weight) {
    document.getElementById('editUserSubjectId').value = id;
    document.getElementById('editSubjectName').value = name;
    document.getElementById('editCreditWeight').value = weight;
    new bootstrap.Modal(document.getElementById('editUserSubjectModal')).show();
  }
  const goalLaddersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.GoalLadders ?? new List<GoalLadderDto>()));
  const allSubjectsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data.AllSubjects ?? new List<GradeSubjectOptionDto>()));

  function onAddGoalGradeBookChanged(gradeBookId) {
    const gbId = parseInt(gradeBookId);
    const subSelect = document.getElementById('addGoalSubjectId');
    if (!subSelect) return;
    subSelect.innerHTML = '';

    const hiddenGb = document.getElementById('addGoalCurrentGradeBookId');
    if (hiddenGb) hiddenGb.value = gbId || '';

    const filtered = (allSubjectsData || []).filter(s => (s.gradeBookId || s.GradeBookId) === gbId);
    if (!filtered || filtered.length === 0) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = '(Bảng điểm này chưa có môn học nào)';
      subSelect.appendChild(opt);
    } else {
      // Khử trùng lặp tên môn học để chỉ hiển thị 1 mục cho mỗi môn trong bảng điểm
      const seenNames = new Set();
      filtered.forEach(s => {
        const name = (s.subjectName || s.SubjectName || '').trim().toLowerCase();
        if (!seenNames.has(name)) {
          seenNames.add(name);
          const opt = document.createElement('option');
          opt.value = s.userSubjectId || s.UserSubjectId;
          opt.textContent = s.subjectName || s.SubjectName;
          subSelect.appendChild(opt);
        }
      });
    }
    onAddGoalSubjectChanged();
  }

  function resetAddGoalModal() {
    const titleEl = document.getElementById('addGoalModalTitle');
    if (titleEl) titleEl.innerText = 'Đặt mục tiêu học tập';

    const currentGbId = @(data.SelectedGradeBookId ?? 0);
    const gbSelect = document.getElementById('addGoalGradeBookSelect');
    if (gbSelect) {
      if (currentGbId > 0) gbSelect.value = currentGbId;
      onAddGoalGradeBookChanged(gbSelect.value);
    }

    const titleInput = document.getElementById('goal-title');
    if (titleInput) titleInput.value = '';
    const targetInput = document.getElementById('goal-target');
    if (targetInput) targetInput.value = '';
  }

  function openAddGoalForSubject(id, name) {
    // Tự động chọn đúng bảng điểm của môn học này
    const sub = (allSubjectsData || []).find(s => (s.userSubjectId || s.UserSubjectId) == id);
    const gbId = sub ? (sub.gradeBookId || sub.GradeBookId) : (@(data.SelectedGradeBookId ?? 0));

    const gbSelect = document.getElementById('addGoalGradeBookSelect');
    if (gbSelect && gbId) {
      gbSelect.value = gbId;
      onAddGoalGradeBookChanged(gbId);
    }

    const sel = document.getElementById('addGoalSubjectId');
    if (sel) sel.value = id;

    const titleInput = document.getElementById('goal-title');
    if (titleInput) titleInput.value = '';
    const targetInput = document.getElementById('goal-target');
    if (targetInput) targetInput.value = '';

    onAddGoalSubjectChanged();
    new bootstrap.Modal(document.getElementById('addGoalModal')).show();
  }

  function onAddGoalSubjectChanged() {
    const subId = parseInt(document.getElementById('addGoalSubjectId')?.value);
    const selectedSub = (allSubjectsData || []).find(s => (s.userSubjectId || s.UserSubjectId) == subId);
    const subName = (selectedSub ? (selectedSub.subjectName || selectedSub.SubjectName) : '').trim().toLowerCase();
    
    // Tìm ladder theo UserSubjectId hoặc tên môn chuẩn hóa
    const ladder = (goalLaddersData || []).find(l => 
      (l.userSubjectId || l.UserSubjectId) == subId || 
      (subName && (l.subjectName || l.SubjectName || '').trim().toLowerCase() === subName)
    );
    
    const targetHint = document.getElementById('goal-target-hint');
    const modalTitle = document.getElementById('addGoalModalTitle');
    const displayName = selectedSub ? (selectedSub.subjectName || selectedSub.SubjectName) : '';

    if (ladder && ladder.hasBaseGoal && ladder.baseGoal) {
      const baseTarget = ladder.baseGoal.targetValue || ladder.baseGoal.TargetValue;
      if (modalTitle && displayName) {
        modalTitle.innerText = `Thêm nấc mục tiêu cho môn ${displayName}`;
      }
      if (targetHint && baseTarget) {
        targetHint.innerText = `Phải lớn hơn mục tiêu gốc (${Number(baseTarget).toFixed(1)}) và ≤ 10.0`;
        targetHint.className = 'text-primary fw-semibold';
      }
    } else {
      if (modalTitle && displayName) {
        modalTitle.innerText = `Đặt mục tiêu cho môn ${displayName}`;
      }
      if (targetHint) {
        targetHint.innerText = 'Mục tiêu đầu tiên sẽ tự động làm Mục tiêu gốc (0.1–10.0)';
        targetHint.className = 'text-muted';
      }
    }
  }

  function editGoal(id, title, targetVal, isBase, isDone, deadline) {
    document.getElementById('editGoalId').value = id;
    document.getElementById('edit-goal-title').value = title;
    const targetInput = document.getElementById('edit-goal-target');
    const targetHint = document.getElementById('edit-goal-target-hint');
    const noticeEl = document.getElementById('editGoalNotice');

    targetInput.value = targetVal;
    
    if (isBase) {
      targetInput.disabled = true;
      targetHint.innerText = 'Mục tiêu gốc là cố định, không thể sửa điểm';
      noticeEl.innerHTML = `
        <div class="alert alert-primary py-2 px-3 mb-3" style="font-size:12px;">
          <i class="bi bi-shield-lock me-1"></i><strong>Mục tiêu gốc (Cố định):</strong> Bạn có thể sửa tên hoặc hạn hoàn thành nhưng không thể sửa điểm mục tiêu.
        </div>`;
    } else {
      targetInput.disabled = false;
      targetHint.innerText = 'Điểm mục tiêu (phải lớn hơn mục tiêu gốc)';
      if (isDone) {
        noticeEl.innerHTML = `
          <div class="alert alert-warning py-2 px-3 mb-3" style="font-size:12px;">
            <i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Nấc đã hoàn thành:</strong> Khi bạn sửa điểm mục tiêu mới, thành tích cũ sẽ được tự động lưu vào Lịch sử thành tích và nấc mục tiêu sẽ chuyển về trạng thái Đang thực hiện.
          </div>`;
      } else {
        noticeEl.innerHTML = `
          <div class="alert alert-info py-2 px-3 mb-3" style="font-size:12px;">
            <i class="bi bi-info-circle me-1"></i>Điểm của nấc bổ sung phải lớn hơn điểm mục tiêu gốc và nằm trong khoảng (0, 10].
          </div>`;
      }
    }

    document.getElementById('edit-goal-deadline').value = deadline || '';
    new bootstrap.Modal(document.getElementById('editGoalModal')).show();
  }

  async function confirmDeleteAdditionalGoal(goalId, targetVal) {
    if (!confirm(`Xác nhận xóa nấc mục tiêu ${targetVal}?\n\nLưu ý: Các hoạt động đã hoàn thành sẽ được giữ lại trên Lịch học cá nhân để bảo tồn lịch sử học tập.`)) return;
    try {
      const resp = await fetch('/Grades/DeleteGoal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
        body: JSON.stringify({ GoalId: goalId })
      });
      const res = await resp.json();
      if (res.ok) window.location.reload();
      else alert("Lỗi khi xóa: " + res.error);
    } catch (e) {
      alert("Lỗi kết nối khi xóa nấc mục tiêu.");
    }
  }

  async function moveGoalOrder(userSubjectId, goalId, dir) {
    const listEl = document.getElementById('goal-list-' + userSubjectId);
    if (!listEl) return;
    const ladder = (goalLaddersData || []).find(l => (l.userSubjectId || l.UserSubjectId) == userSubjectId);
    if (!ladder || !ladder.additionalGoals) return;

    const goals = [...ladder.additionalGoals];
    const idx = goals.findIndex(g => (g.id || g.Id) == goalId);
    if (idx < 0) return;
    if (dir === -1 && idx === 0) return;
    if (dir === 1 && idx === goals.length - 1) return;

    const targetIdx = idx + dir;
    const temp = goals[idx];
    goals[idx] = goals[targetIdx];
    goals[targetIdx] = temp;

    const items = goals.map((g, i) => ({
      GoalId: g.id || g.Id,
      NewDisplayOrder: i + 1
    }));

    try {
      const resp = await fetch('/Grades/ReorderGoals', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': csrfToken },
        body: JSON.stringify(items)
      });
      const res = await resp.json();
      if (res.ok) window.location.reload();
      else alert(res.error);
    } catch (e) {
      alert("Lỗi kết nối");
    }
  }

  // ── Goal Activity AJAX ───────────────────────────────────────
  function openAddActivityModal(goalId) {
    document.getElementById('addActivityGoalId').value = goalId;
    document.getElementById('add-activity-title').value = '';
    const now = new Date();
    const pad = n => n < 10 ? '0' + n : n;
    const startStr = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours()+1)}:00`;
    const endStr = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours()+2)}:00`;
    document.getElementById('add-activity-start').value = startStr;
    document.getElementById('add-activity-end').value = endStr;
    document.getElementById('add-activity-desc').value = '';
    new bootstrap.Modal(document.getElementById('addActivityModal')).show();
  }

