@section Scripts {
<script>
  function updateGradeWeight(sourceId, targetId) {
    var type = document.getElementById(sourceId).value;
    var weightSelect = document.getElementById(targetId);
    if (type === 'Midterm') {
      weightSelect.value = '2';
    } else if (type === 'Final') {
      weightSelect.value = '3';
    } else {
      weightSelect.value = '1';
    }
  }

  function editGrade(id, subjectId, title, assessmentType, score, weight, date) {
    document.getElementById('edit-grade-id').value = id;
    document.getElementById('edit-grade-subject').value = subjectId;
    document.getElementById('edit-assessment-type').value = assessmentType;
    document.getElementById('edit-grade-title').value = title;
    document.getElementById('edit-grade-score').value = score;
    document.getElementById('edit-grade-weight').value = weight;
    document.getElementById('edit-grade-date').value = date;
    new bootstrap.Modal(document.getElementById('editGradeModal')).show();
  }
  function editGoal(id, title, subjectId, unitCode, targetVal, endDate) {
    document.getElementById('editGoalId').value = id;
    document.getElementById('edit-goal-title').value = title;
    document.getElementById('edit-goal-subject').value = subjectId || '';
    document.getElementById('edit-goal-unitcode').value = unitCode;
    document.getElementById('edit-goal-target').value = targetVal;
    document.getElementById('edit-goal-deadline').value = endDate;
    new bootstrap.Modal(document.getElementById('editGoalModal')).show();
  }

  function parseDateVN(dateStr) {
    const parts = dateStr.split('/');
    if (parts.length === 3) {
      return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
    }
    return null;
  }

  function validateAddTerm(form) {
    const displayStart = document.getElementById('displayStartDate').value;
    const displayEnd = document.getElementById('displayEndDate').value;
    
    const startStr = parseDateVN(displayStart);
    const endStr = parseDateVN(displayEnd);
    
    if (!startStr || !endStr) {
      alert("Vui lòng nhập ngày theo định dạng dd/MM/yyyy.");
      return false;
    }
    
    document.getElementById('hiddenStartDate').value = startStr;
    document.getElementById('hiddenEndDate').value = endStr;
    
    const startDate = new Date(startStr);
    const endDate = new Date(endStr);
    
    if (startDate >= endDate) {
      alert("Ngày bắt đầu phải trước ngày kết thúc.");
      return false;
    }
    
    const diffTime = Math.abs(endDate - startDate);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
    
    if (diffDays < 90) {
      alert("Học kỳ phải kéo dài tối thiểu 3 tháng.");
      return false;
    }
    if (diffDays > 185) {
      alert("Học kỳ không được vượt quá 6 tháng.");
      return false;
    }
    
    return true;
  }

function gradeTab(btn, tabId) {
  document.querySelectorAll('.nav-link').forEach(b => {
    b.style.cssText = 'font-size:12px;color:var(--sh-slate-500);border:0;background:transparent;padding:8px 16px;font-weight:600;';
    b.classList.remove('active');
  });
  btn.style.cssText = 'font-size:12px;font-weight:700;color:var(--sh-indigo-600);border-bottom:2px solid var(--sh-indigo-600);border-top:0;border-left:0;border-right:0;background:transparent;padding:8px 16px;';
  document.getElementById('grades-tab').style.display = tabId === 'grades-tab' ? 'block' : 'none';
  document.getElementById('goals-tab').style.display = tabId === 'goals-tab' ? 'block' : 'none';
}

function editSubject(id, name, target, credit) {
  document.getElementById('editUserSubjectId').value = id;
  document.getElementById('editSubjectName').value = name;
  document.getElementById('editTargetScore10').value = target || '';
  document.getElementById('editCreditWeight').value = credit || '1';
  new bootstrap.Modal(document.getElementById('editUserSubjectModal')).show();
}

@if(TempData["SuccessMessage"] != null) {
  <text>
  document.addEventListener("DOMContentLoaded", function() {
    if (typeof showToast === 'function') {
      showToast('@TempData["SuccessMessage"]', 'success');
    }
  });
  </text>
}
@if(TempData["ErrorMessage"] != null) {
  <text>
  document.addEventListener("DOMContentLoaded", function() {
    if (typeof showToast === 'function') {
      showToast('@TempData["ErrorMessage"]', 'error');
    }
  });
  </text>
}
</script>
}
