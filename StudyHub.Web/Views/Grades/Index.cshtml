<!-- ── Add Goal Modal ── -->
<div class="modal fade" id="addGoalModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="AddGoal" method="post" class="modal-content">
      <input type="hidden" name="currentGradeBookId" id="addGoalCurrentGradeBookId" value="@data.SelectedGradeBookId" />
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" style="font-size:15px;"><i class="bi bi-trophy me-2 text-primary"></i><span id="addGoalModalTitle">Đặt mục tiêu học tập</span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <!-- 1. Bảng điểm năm học -->
        <div class="mb-3">
          <label class="sh-label" for="addGoalGradeBookSelect">Bảng điểm năm học</label>
          <select id="addGoalGradeBookSelect" class="sh-input" onchange="onAddGoalGradeBookChanged(this.value)">
            @if (!data.GradeBooks.Any()) {
              <option value="">(Chưa có sổ điểm nào)</option>
            } else {
              @foreach (var gb in data.GradeBooks) {
                if (gb.GradeBookId == data.SelectedGradeBookId) {
                  <option value="@gb.GradeBookId" selected>@gb.Name</option>
                } else {
                  <option value="@gb.GradeBookId">@gb.Name</option>
                }
              }
            }
          </select>
        </div>

        <!-- 2. Môn học -->
        <div class="mb-3">
          <label class="sh-label" for="addGoalSubjectId">Môn học</label>
          <select name="UserSubjectId" id="addGoalSubjectId" class="sh-input" required onchange="onAddGoalSubjectChanged()">
            @if (data.AllSubjects != null && data.AllSubjects.Any()) {
              var initialGbId = data.SelectedGradeBookId ?? (data.GradeBooks.FirstOrDefault()?.GradeBookId ?? 0);
              var initialSubs = data.AllSubjects
                .Where(s => s.GradeBookId == initialGbId)
                .GroupBy(s => (s.SubjectName ?? string.Empty).Trim().ToLowerInvariant())
                .Select(g => g.First())
                .ToList();
              if (initialSubs.Any()) {
                @foreach (var s in initialSubs) {
                  <option value="@s.UserSubjectId">@s.SubjectName</option>
                }
              } else {
                var uniqueAll = data.AllSubjects
                  .GroupBy(s => (s.SubjectName ?? string.Empty).Trim().ToLowerInvariant())
                  .Select(g => g.First());
                @foreach (var s in uniqueAll) {
                  <option value="@s.UserSubjectId">@s.SubjectName</option>
                }
              }
            }
          </select>
        </div>

        <!-- 3. Tên mục tiêu -->
        <div class="mb-3">
          <label class="sh-label" for="goal-title">Tên mục tiêu</label>
          <input name="Title" id="goal-title" type="text" class="sh-input" placeholder="Ví dụ: Đạt 8.0 môn Toán" required />
        </div>

        <!-- 4. Điểm mục tiêu (0–10) -->
        <div class="mb-3">
          <label class="sh-label" for="goal-target">Điểm mục tiêu (0–10)</label>
          <input name="TargetValue" id="goal-target" type="number" min="0.1" max="10" step="0.1" class="sh-input" placeholder="Ví dụ: 8.0" required />
          <small class="text-muted" id="goal-target-hint" style="font-size:11px;">Thang điểm 0–10</small>
        </div>
      </div>
      <div class="modal-footer gap-2 border-0 pt-0">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn-primary-sh"><i class="bi bi-trophy me-1"></i>Lưu mục tiêu</button>
      </div>
    </form>
  </div>
</div>

