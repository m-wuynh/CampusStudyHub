@model StudyHub.BLL.DTOs.GradesPageDto
@{
    var data = Model;
    var columns = Model.Columns;
    var gradeBook = Model.GradeBook;
}

@* ═════════ 1. Sổ điểm: wizard tạo sổ, xác nhận xóa sổ ═════════ *@
<!-- ── Wizard Create GradeBook Modal ── -->
<div class="modal fade" id="wizardGradeBookModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="CreateGradeBookWithColumns" method="post" class="modal-content" id="wizard-form">
      <input type="hidden" name="GradeBookId" value="@data.SelectedGradeBookId" />
      
      <div class="modal-header">
        <h5 class="modal-title fw-bold" style="font-size:14px;"><i class="bi bi-journal-plus me-2"></i>Thêm sổ điểm năm học</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      
      <!-- Step 1 -->
      <div class="modal-body" id="wizard-step-1">
        <div class="row g-3 mb-3">
          <div class="col-6">
            <label class="sh-label">Năm bắt đầu</label>
            <input type="number" name="FromYear" id="wizardFromYear" class="sh-input" value="@StudyHub.BLL.Constants.GradeClock.Today().Year" onchange="document.getElementById('wizardToYear').value = parseInt(this.value) + 1; document.getElementById('wizardNameInput').value = 'Sổ điểm năm học ' + this.value + '-' + (parseInt(this.value) + 1);" required />
          </div>
          <div class="col-6">
            <label class="sh-label">Năm kết thúc</label>
            <input type="number" name="ToYear" id="wizardToYear" class="sh-input" value="@(StudyHub.BLL.Constants.GradeClock.Today().Year + 1)" readonly />
          </div>
        </div>
        <div class="mb-3">
          <label class="sh-label">Tên sổ điểm</label>
          <input name="Name" id="wizardNameInput" type="text" class="sh-input" value="Sổ điểm năm học @StudyHub.BLL.Constants.GradeClock.Today().Year-@(StudyHub.BLL.Constants.GradeClock.Today().Year + 1)" required maxlength="200" />
        </div>
        <div class="row g-3">
            <div class="col-6">
                <label class="sh-label">Số môn khởi tạo</label>
                <input type="number" id="wizard-subject-count" class="sh-input" value="3" min="0" max="10" />
            </div>
            <div class="col-6">
                <label class="sh-label">Số cột khởi tạo</label>
                <input type="number" id="wizard-column-count" class="sh-input" value="2" min="0" max="10" />
            </div>
        </div>
        <p class="text-muted mt-2 mb-0" style="font-size: 11px;">(Bạn có thể thêm bớt tùy ý sau khi tạo xong)</p>
      </div>

      <!-- Step 2 -->
      <div class="modal-body" id="wizard-step-2" style="display: none; max-height: 400px; overflow-y: auto;">
          <h6 class="fw-bold mb-2" style="font-size: 13px;">Cột đánh giá</h6>
          <div id="wizard-columns-container"></div>
          
          <h6 class="fw-bold mt-4 mb-2" style="font-size: 13px;">Môn học</h6>
          <div id="wizard-subjects-container"></div>
      </div>

      <div class="modal-footer gap-2">
        <button type="button" class="btn-secondary-sh" id="btn-wizard-cancel" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn-secondary-sh" id="btn-wizard-back" style="display: none;" onclick="wizardGoToStep(1)">← Quay lại</button>
        <button type="button" class="btn-primary-sh" id="btn-wizard-next" onclick="wizardGoToStep(2)">Tiếp theo →</button>
        <button type="submit" class="btn-primary-sh" id="btn-wizard-submit" style="display: none;"><i class="bi bi-check-lg me-1"></i>Hoàn tất tạo sổ điểm</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Delete GradeBook Modal ── -->
<div class="modal fade" id="deleteGradeBookModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="DeleteGradeBook" method="post" class="modal-content">
      <input type="hidden" name="id" value="@(gradeBook?.GradeBookId ?? data.SelectedGradeBookId ?? 0)" />
      <input type="hidden" name="currentGradeBookId" value="@data.SelectedGradeBookId" />
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xóa bảng điểm?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">Sổ điểm: <strong>@(gradeBook?.Name)</strong></p>
        <p class="fw-bold mb-2">Thao tác này sẽ xóa vĩnh viễn sổ điểm và toàn bộ dữ liệu của sổ:</p>
        <ul class="mb-3" style="font-size: 13px; color: var(--sh-slate-700);">
            <li>Các môn học và cột điểm</li>
            <li>Toàn bộ điểm đã nhập</li>
            <li>Mục tiêu, lịch sử mục tiêu và hoạt động học tập (kể cả lịch học của các môn)</li>
            <li>Deadline và phiên học của các môn</li>
        </ul>
        <p class="mb-3" style="font-size: 13px; color: var(--sh-slate-700);">Ghi chú, tài liệu và bộ flashcard được <strong>giữ lại</strong> nhưng sẽ không còn gắn với môn học.</p>
        <div class="alert alert-danger mb-0" style="font-size:12px;">
          <i class="bi bi-exclamation-circle me-1"></i> Thao tác không thể hoàn tác. Các sổ điểm khác không bị ảnh hưởng.
        </div>
      </div>
      <div class="modal-footer gap-2 border-0 pt-0">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn-primary-sh bg-danger border-danger"><i class="bi bi-trash3 me-1"></i>Xác nhận xóa</button>
      </div>
    </form>
  </div>
</div>

@* ═════════ 2. Cấu trúc bảng: thêm/sửa cột, thêm/sửa môn ═════════ *@
<!-- ── Add Column Modal ── -->
<div class="modal fade" id="addColumnModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="AddColumn" method="post" class="modal-content">
      <input type="hidden" name="GradeBookId" value="@gradeBook?.GradeBookId" />
      <input type="hidden" name="currentGradeBookId" value="@data.SelectedGradeBookId" />
      <div class="modal-header">
        <h5 class="modal-title fw-bold" style="font-size:14px;"><i class="bi bi-layout-three-columns me-2"></i>Thêm cột đánh giá</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-7">
            <label class="sh-label">Tên cột</label>
            <input name="Name" type="text" class="sh-input" placeholder="Ví dụ: Bài tập, Giữa kỳ..." required maxlength="100" />
          </div>
          <div class="col-5">
            <label class="sh-label">Hệ số (Weight)</label>
            <input name="Weight" type="number" step="0.1" min="0.1" class="sh-input" value="1" required />
          </div>
          <div class="col-12" style="display: none;">
            <label class="sh-label">Thứ tự hiển thị</label>
            <input name="DisplayOrder" type="number" class="sh-input" value="@(columns.Any() ? columns.Max(c => c.DisplayOrder) + 1 : 1)" min="0" required />
          </div>
        </div>
      </div>
      <div class="modal-footer gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn-primary-sh"><i class="bi bi-plus-lg me-1"></i>Thêm cột</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Edit Column Modal ── -->
<div class="modal fade" id="editColumnModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="UpdateColumn" method="post" class="modal-content">
      <input type="hidden" name="GradeColumnId" id="editColumnId" />
      <input type="hidden" name="currentGradeBookId" value="@data.SelectedGradeBookId" />
      <div class="modal-header">
        <h5 class="modal-title fw-bold" style="font-size:14px;"><i class="bi bi-pencil me-2"></i>Sửa cột đánh giá</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-7">
            <label class="sh-label">Tên cột</label>
            <input name="Name" id="editColumnName" type="text" class="sh-input" required maxlength="100" />
          </div>
          <div class="col-5">
            <label class="sh-label">Hệ số (Weight)</label>
            <input name="Weight" id="editColumnWeight" type="number" step="0.1" min="0.1" class="sh-input" required />
          </div>
          <div class="col-12" style="display: none;">
            <label class="sh-label">Thứ tự hiển thị</label>
            <input name="DisplayOrder" id="editColumnOrder" type="number" class="sh-input" min="0" required />
          </div>
        </div>
      </div>
      <div class="modal-footer gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn-primary-sh"><i class="bi bi-floppy me-1"></i>Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Add User Subject Modal ── -->
<div class="modal fade" id="addUserSubjectModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="AddUserSubject" method="post" class="modal-content">
      <input type="hidden" name="GradeBookId" value="@data.SelectedGradeBookId" />
      <div class="modal-header">
        <h5 class="modal-title fw-bold" style="font-size:14px;"><i class="bi bi-book me-2"></i>Thêm môn học</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="sh-label">Tên môn học</label>
          <input type="text" name="SubjectName" class="sh-input" placeholder="Ví dụ: Toán nâng cao" required />
        </div>
        <div class="mb-3" style="display: none;">
          <label class="sh-label">Hệ số môn (tín chỉ)</label>
          <input name="CreditWeight" type="number" min="1" max="10" step="1" class="sh-input" value="1" required />
        </div>
      </div>
      <div class="modal-footer gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn-primary-sh">Thêm môn học</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Edit User Subject Modal ── -->
<div class="modal fade" id="editUserSubjectModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <form asp-action="UpdateUserSubject" method="post" class="modal-content">
      <input type="hidden" name="UserSubjectId" id="editUserSubjectId" />
      <input type="hidden" name="currentGradeBookId" value="@data.SelectedGradeBookId" />
      <div class="modal-header">
        <h5 class="modal-title fw-bold" style="font-size:14px;"><i class="bi bi-pencil me-2"></i>Sửa môn học</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="sh-label">Tên môn học</label>
          <input type="text" name="SubjectName" id="editSubjectName" class="sh-input" required />
        </div>
        <div class="mb-3" style="display: none;">
          <label class="sh-label">Hệ số môn (tín chỉ)</label>
          <input name="CreditWeight" id="editCreditWeight" type="number" min="1" max="10" step="1" class="sh-input" required />
        </div>
      </div>
      <div class="modal-footer gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn-primary-sh">Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>

@* ═════════ 3. Nhập điểm môn học ═════════ *@
<!-- ── Enter Grades Modal ── -->
<div class="modal fade" id="enterGradesModal" tabindex="-1" aria-labelledby="enterGradesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
      <div class="modal-header bg-light border-bottom">
        <h5 class="modal-title fw-bold" id="enterGradesModalLabel" style="font-size:15px; color:var(--sh-indigo-900);">
          <i class="bi bi-pencil-square me-2 text-primary"></i>Nhập điểm môn học
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
        
        <!-- Subject Selection -->
        <div class="mb-3">
          <label class="sh-label fw-bold mb-1" style="font-size: 13px; color: var(--sh-slate-700);">Chọn môn học</label>
          <select id="modalSubjectSelect" class="form-select sh-input" style="font-size: 14px; font-weight: 600;" onchange="onModalSubjectChanged(this.value)">
            <!-- Populated via JS -->
          </select>
          <div class="form-text text-muted mt-2" style="font-size: 12px;">
            <i class="bi bi-info-circle me-1 text-primary"></i>Nhập nhiều điểm phân cách bằng dấu chấm phẩy, ví dụ: 8,5; 9
          </div>
        </div>

        <!-- Grade Columns Grid -->
        <div id="modalColumnsContainer" class="d-flex flex-column gap-3">
          <!-- Populated via JS -->
        </div>

      </div>
      <div class="modal-footer bg-light border-top gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn-primary-sh" id="btnSaveModalGrades" onclick="saveModalGrades()">
          <i class="bi bi-floppy me-1"></i>Lưu điểm
        </button>
      </div>
    </div>
  </div>
</div>
