@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Đăng nhập vào Study Hub bằng tài khoản Google." />
  <title>Đăng nhập — Study Hub</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous" />
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/site.css" />
  <style>
    .login-page {
      min-height: 100vh;
      background: linear-gradient(145deg, var(--sh-slate-50), var(--sh-indigo-50));
      display: grid;
      place-items: center;
      padding: 32px 16px;
    }
    .login-shell { width: 100%; max-width: 440px; }
    .login-card {
      background: #fff;
      border: 1px solid var(--sh-slate-200);
      border-radius: 20px;
      box-shadow: var(--sh-shadow-md);
      padding: 36px 40px;
    }
    .google-button {
      width: 100%;
      min-height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      background: #fff;
      color: var(--sh-slate-800);
      border: 1px solid var(--sh-slate-300);
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      transition: border-color .15s, box-shadow .15s, transform .15s;
    }
    .google-button:hover {
      color: var(--sh-slate-900);
      border-color: var(--sh-indigo-400);
      box-shadow: 0 6px 16px rgba(79, 70, 229, .12);
      transform: translateY(-1px);
    }
    .google-logo {
      width: 24px;
      height: 24px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: #4285f4;
      font-size: 19px;
      font-weight: 800;
      font-family: Arial, sans-serif;
    }
    @@media (max-width: 480px) {
      .login-card { padding: 28px 22px; }
    }
  </style>
</head>
<body class="login-page">
  <main class="login-shell">
    <div class="d-flex justify-content-center align-items-center gap-3 mb-4">
      <div class="sidebar-brand-logo" style="width:48px; height:48px; border-radius:14px;">
        <i class="bi bi-book-fill" style="font-size:22px;"></i>
      </div>
      <div>
        <h1 class="mb-0 fw-bold" style="font-size:22px; color:var(--sh-slate-900);">Study Hub</h1>
        <p class="mb-0" style="font-size:10px; color:var(--sh-indigo-600); font-weight:700; text-transform:uppercase; letter-spacing:.08em;">
          Không gian học tập sinh viên
        </p>
      </div>
    </div>

    <section class="login-card" aria-labelledby="login-title">
      <div class="text-center mb-4">
        <h2 id="login-title" class="fw-bold mb-2" style="font-size:20px; color:var(--sh-slate-900);">
          Chào mừng bạn trở lại
        </h2>
        <p class="mb-0" style="font-size:12px; color:var(--sh-slate-500); line-height:1.65;">
          Dùng tài khoản Google để đăng nhập. Lần đầu đăng nhập, Study Hub sẽ tự tạo hồ sơ cho bạn.
        </p>
      </div>

      @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
      {
        <div class="alert alert-danger py-2 px-3 mb-3" role="alert" style="font-size:12px;">
          <i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage
        </div>
      }

      @if (!ViewData.ModelState.IsValid)
      {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3" style="font-size:12px;"></div>
      }

      @if (Model.GoogleEnabled)
      {
        <a class="google-button"
           asp-controller="Account"
           asp-action="Google"
           asp-route-returnUrl="@Model.ReturnUrl"
           asp-route-rememberMe="true">
          <span class="google-logo" aria-hidden="true">G</span>
          <span>Đăng nhập với Google</span>
        </a>
      }
      else
      {
        <button type="button" class="google-button" disabled aria-disabled="true">
          <span class="google-logo" aria-hidden="true">G</span>
          <span>Đăng nhập với Google</span>
        </button>
        <div class="alert alert-warning py-2 px-3 mt-3 mb-0" role="alert" style="font-size:12px;">
          Chưa có Google Client ID và Client Secret. Hãy cấu hình User Secrets theo hướng dẫn trong README.
        </div>
      }

      <p class="text-center mb-0 mt-4" style="font-size:11px; color:var(--sh-slate-500); line-height:1.6;">
        Study Hub chỉ nhận tên, email và ảnh đại diện do Google cung cấp. Ứng dụng không nhận mật khẩu Google của bạn.
      </p>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
          crossorigin="anonymous"></script>
</body>
</html>
