@model StudyHub.Web.ViewModels.NotesV3.NotesReaderViewModel
@using System.Globalization
@{
    Layout = null;
    var fileUrl = Url.Action("OpenPdf", "Pdfs",
        new { versionId = Model.VersionId, shareId = Model.ShareId });
    string Number(double value) => (value * 1000).ToString("0.###", CultureInfo.InvariantCulture);
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title · Trang @Model.CurrentPage</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notesv3/notes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notesv3/pdf-reader.css" asp-append-version="true" />
</head>
<body class="notesv3 notesv3-viewer">
    <header class="notesv3-viewer-toolbar">
        <strong class="notesv3-viewer-file"><i class="bi bi-file-earmark-pdf"></i> @Model.Title</strong>
        <nav class="notesv3-viewer-pages" aria-label="Chuyển trang">
            @if (Model.CurrentPage > 1)
            {
                <a class="notesv3-page-nav" data-reader-page-link title="Trang trước"
                   aria-label="Trang trước" target="_top" asp-controller="Pdfs" asp-action="Reader"
                   asp-route-id="@Model.DocumentId" asp-route-shareId="@Model.ShareId"
                   asp-route-page="@(Model.CurrentPage - 1)"><i class="bi bi-chevron-left"></i></a>
            }
            else
            {
                <span class="notesv3-page-nav disabled" aria-disabled="true">
                    <i class="bi bi-chevron-left"></i>
                </span>
            }
            <form asp-controller="Pdfs" asp-action="Reader" asp-route-id="@Model.DocumentId"
                  method="get" target="_top" class="notesv3-viewer-page-form">
                <label class="visually-hidden" for="viewer-page-number">Trang PDF</label>
                <input id="viewer-page-number" name="page" type="number" min="1"
                       max="@Model.PageCount" value="@Model.CurrentPage" />
                <input type="hidden" name="shareId" value="@Model.ShareId" />
                <span>/ @Model.PageCount</span>
                <button type="submit" title="Đi tới trang" aria-label="Đi tới trang">
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>
            @if (Model.CurrentPage < Model.PageCount)
            {
                <a class="notesv3-page-nav" data-reader-page-link title="Trang sau"
                   aria-label="Trang sau" target="_top" asp-controller="Pdfs" asp-action="Reader"
                   asp-route-id="@Model.DocumentId" asp-route-shareId="@Model.ShareId"
                   asp-route-page="@(Model.CurrentPage + 1)"><i class="bi bi-chevron-right"></i></a>
            }
            else
            {
                <span class="notesv3-page-nav disabled" aria-disabled="true">
                    <i class="bi bi-chevron-right"></i>
                </span>
            }
        </nav>
        <div class="notesv3-zoom-controls" aria-label="Phóng to, thu nhỏ PDF">
            <button id="pdf-zoom-out" type="button" title="Thu nhỏ PDF"
                    aria-label="Thu nhỏ PDF"><i class="bi bi-dash-lg"></i></button>
            <label class="visually-hidden" for="pdf-zoom">Mức phóng to PDF</label>
            <select id="pdf-zoom" class="form-select form-select-sm notesv3-viewer-zoom"
                    aria-label="Mức phóng to PDF">
                <option value="0.5">50%</option>
                <option value="0.75">75%</option>
                <option value="1" selected>Vừa rộng</option>
                <option value="1.25">125%</option>
                <option value="1.5">150%</option>
                <option value="2">200%</option>
                <option value="3">300%</option>
            </select>
            <button id="pdf-zoom-in" type="button" title="Phóng to PDF"
                    aria-label="Phóng to PDF"><i class="bi bi-plus-lg"></i></button>
        </div>
        @if (!Model.IsArchived)
        {
            <button class="btn-primary-sh notesv3-viewer-save" id="save-mark"
                    type="submit" form="mark-form" disabled>
                <i class="bi bi-cloud-check"></i> Lưu dấu
            </button>
        }
    </header>
    <div class="notesv3-viewer-tab"><i class="bi bi-file-earmark-pdf"></i> @Model.FileName</div>
    <nav class="notesv3-penbar" aria-label="Công cụ PDF">
        <span class="notesv3-penbar-label">BÚT &amp; CHÚ THÍCH</span>
        <label class="visually-hidden" for="mark-tool">Công cụ đánh dấu</label>
        <select class="visually-hidden" id="mark-tool" disabled="@Model.IsArchived">
            <option value="Highlight">Tô sáng</option>
            <option value="Ink">Bút vẽ</option>
            <option value="Comment">Thêm chữ</option>
            <option value="Eraser">Tẩy dấu</option>
            <option value="Pan">Bàn tay</option>
        </select>
        <button type="button" class="notesv3-pen-tool" data-mark-tool="Pan"
                title="Bàn tay: cuộn tài liệu" aria-label="Bàn tay">
            <i class="bi bi-hand-index"></i><span>Bàn tay</span>
        </button>
        <span class="notesv3-pen-divider"></span>
        <button type="button" class="notesv3-pen-tool active" data-mark-tool="Highlight"
                title="Kéo để tô sáng" aria-label="Tô sáng" disabled="@Model.IsArchived">
            <i class="bi bi-highlighter"></i><span>Tô sáng</span>
        </button>
        <button type="button" class="notesv3-pen-tool" data-mark-tool="Ink"
                title="Kéo để vẽ" aria-label="Bút vẽ" disabled="@Model.IsArchived">
            <i class="bi bi-pencil"></i><span>Bút</span>
        </button>
        <button type="button" class="notesv3-pen-tool" data-mark-tool="Comment"
                title="Chạm để thêm chữ" aria-label="Thêm chữ" disabled="@Model.IsArchived">
            <i class="bi bi-fonts"></i><span>Chữ</span>
        </button>
        <button type="button" class="notesv3-pen-tool" data-mark-tool="Eraser"
                title="Chạm vào dấu đã lưu để tẩy" aria-label="Tẩy" disabled="@Model.IsArchived">
            <i class="bi bi-eraser"></i><span>Tẩy</span>
        </button>
        <button type="button" class="notesv3-pen-tool" id="undo-mark"
                title="Bỏ dấu nháp cuối cùng" aria-label="Hoàn tác nét nháp"
                disabled>
            <i class="bi bi-arrow-counterclockwise"></i><span>Hoàn tác</span>
        </button>
        <span class="notesv3-pen-divider"></span>
        <label class="notesv3-pen-color" for="mark-color">
            <span>Màu</span>
            <input id="mark-color" type="color" value="#ffd54f" title="Màu nét"
                   disabled="@Model.IsArchived" />
        </label>
    </nav>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success m-2 py-2" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger m-2 py-2" role="alert">@error</div>
    }
    <p id="pdf-status" class="notesv3-viewer-status" role="status">Đang mở trang PDF…</p>
    <div class="notesv3-viewer-surface">
        <div class="notesv3-pdf-page" id="pdf-page"
             data-file-url="@fileUrl" data-page="@Model.CurrentPage"
             data-archived="@Model.IsArchived.ToString().ToLowerInvariant()">
            <canvas id="pdf-canvas" aria-label="Trang PDF @Model.CurrentPage"></canvas>
            <svg id="mark-layer" class="notesv3-mark-layer" viewBox="0 0 1000 1000"
                 preserveAspectRatio="none" aria-label="Đánh dấu trên trang PDF">
                @foreach (var mark in Model.Marks)
                {
                    if (mark.Kind == "Highlight")
                    {
                        <rect data-mark-id="@mark.Id" data-version="@mark.VersionToken"
                              x="@Number(mark.X)" y="@Number(mark.Y)"
                              width="@Number(mark.Width)" height="@Number(mark.Height)"
                              fill="@mark.Color" opacity="0.42" />
                    }
                    else if (mark.Kind == "Ink")
                    {
                        var points = string.Join(" ", mark.Points.Select(point =>
                            $"{Number(point.X)},{Number(point.Y)}"));
                        <polyline data-mark-id="@mark.Id" data-version="@mark.VersionToken"
                                  points="@points" fill="none" stroke="@mark.Color"
                                  stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
                    }
                    else if (mark.Kind == "Comment")
                    {
                        <foreignObject data-mark-id="@mark.Id" data-version="@mark.VersionToken"
                                       x="@Number(mark.X)" y="@Number(mark.Y)"
                                       width="270" height="110">
                            <div xmlns="http://www.w3.org/1999/xhtml" class="notesv3-pdf-text"
                                 style="border-color:@mark.Color">@mark.Text</div>
                        </foreignObject>
                    }
                }
            </svg>
        </div>
    </div>

    <footer class="notesv3-viewer-footer">
        @if (!Model.IsArchived)
        {
            <form asp-controller="PdfMarks" asp-action="Save" method="post" id="mark-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                <input type="hidden" name="versionId" value="@Model.VersionId" />
                <input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
                <input type="hidden" name="shareId" value="@Model.ShareId" />
                <input type="hidden" name="marksJson" />
                <label for="mark-text" class="small fw-semibold">Chữ đặt trên PDF</label>
                <input class="form-control form-control-sm" id="mark-text"
                       maxlength="2000" placeholder="Chọn Thêm chữ, bấm vị trí trên PDF rồi nhập nội dung" />
            </form>
            <form asp-controller="PdfMarks" asp-action="Delete" method="post" id="erase-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="markId" />
                <input type="hidden" name="versionToken" />
                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                <input type="hidden" name="versionId" value="@Model.VersionId" />
                <input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
                <input type="hidden" name="shareId" value="@Model.ShareId" />
            </form>
        }
        <details>
            <summary>Đánh dấu đã lưu (@Model.Marks.Count)</summary>
            <div class="notesv3-viewer-mark-list">
                @foreach (var mark in Model.Marks)
                {
                    <div class="notesv3-mark-item">
                        <span class="notesv3-mark-dot" style="background-color:@mark.Color"></span>
                        <span>@(mark.Kind switch { "Highlight" => "Tô sáng", "Ink" => "Nét vẽ", _ => "Chữ" })</span>
                        @if (!string.IsNullOrWhiteSpace(mark.Text))
                        {
                            <span class="notesv3-mark-text">@mark.Text</span>
                        }
                        @if (!Model.IsArchived)
                        {
                            <form asp-controller="PdfMarks" asp-action="Delete" method="post" class="ms-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="markId" value="@mark.Id" />
                                <input type="hidden" name="versionToken" value="@mark.VersionToken" />
                                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                                <input type="hidden" name="versionId" value="@Model.VersionId" />
                                <input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
                                <input type="hidden" name="shareId" value="@Model.ShareId" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </details>
    </footer>
    <script type="module" src="~/js/notesv3/pdf-marks.js" asp-append-version="true"></script>
</body>
</html>
