@model StudyHub.Web.ViewModels.NotesV3.NotesBookViewModel

@{
    ViewData["Title"] = $"Sổ ghi chú - {Model.Title}";
    ViewData["PageTitle"] = "Sổ ghi chú PDF";
    ViewData["PageSubtitle"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/notesv3/notes.css" asp-append-version="true" />
}

<div class="notesv3 notesv3-book container py-4">
    <header class="notesv3-page-header mb-4">
        <a class="btn-secondary-sh notesv3-back-button"
           asp-controller="Pdfs" asp-action="Reader"
           asp-route-id="@Model.DocumentId" asp-route-shareId="@Model.ShareId"
           asp-route-page="@Model.ReturnPage">
            <i class="bi bi-arrow-left"></i> Quay lại PDF
        </a>
        <h1>Sổ ghi chú PDF</h1>
        <p class="text-muted mb-0">@Model.Title</p>
    </header>

    @if (Model.Pages.Count == 0)
    {
        <div class="notesv3-empty">Chưa có trang nào chứa ghi chú.</div>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach (var page in Model.Pages)
            {
                <article class="card notesv3-book-page">
                    <div class="card-body">
                        <span class="notesv3-book-label">GHI CHÚ THEO TRANG</span>
                        <h2 class="h5 mt-2">
                            <a asp-controller="Pdfs" asp-action="Reader"
                               asp-route-id="@Model.DocumentId"
                               asp-route-shareId="@Model.ShareId"
                               asp-route-page="@(page.PageNumber)">
                                Trang @(page.PageNumber) <i class="bi bi-arrow-up-right"></i>
                            </a>
                        </h2>
                        <p class="notesv3-note-text mb-0">@(page.Text)</p>
                    </div>
                </article>
            }
        </div>
    }
</div>
