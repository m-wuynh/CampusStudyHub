@model StudyHub.Web.ViewModels.Pdf.PdfCardViewModel

<div class="modal fade pdf-library-modal" id="managePdf-@Model.Id" tabindex="-1"
     aria-labelledby="managePdfTitle-@Model.Id" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h5" id="managePdfTitle-@Model.Id">Quản lý PDF</h2>
                    <p class="text-muted small mb-0 mt-1">@Model.Title</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <section class="pdf-manage-section">
                    <h3>Thông tin tài liệu</h3>
                    <form asp-controller="PdfDocuments" asp-action="RenamePdf" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="versionToken" value="@Model.VersionToken" />
                        <label class="form-label" for="pdf-title-@Model.Id">Tên hiển thị</label>
                        <div class="input-group">
                            <input class="form-control" id="pdf-title-@Model.Id" name="title"
                                   value="@Model.Title" maxlength="200" required />
                            <button class="btn btn-primary" type="submit">Lưu tên</button>
                        </div>
                    </form>
                </section>

                <section class="pdf-manage-section is-danger">
                    <h3>Xóa tài liệu</h3>
                    <p>PDF đang chia sẻ phải được thu hồi tại tài nguyên nhóm trước khi xóa. PDF hợp lệ sẽ vào thùng rác và có thể khôi phục trong 30 ngày.</p>
                    <form asp-controller="PdfDocuments" asp-action="DeletePdf" method="post"
                          data-confirm="Chuyển PDF này vào thùng rác?">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="versionToken" value="@Model.VersionToken" />
                        <button class="btn btn-outline-danger btn-sm" type="submit">
                            <i class="bi bi-trash"></i> Chuyển vào thùng rác
                        </button>
                    </form>
                </section>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light" type="button" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
