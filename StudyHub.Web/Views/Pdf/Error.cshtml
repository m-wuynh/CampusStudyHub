@model StudyHub.Web.ViewModels.Pdf.PdfErrorViewModel
@{
    ViewData["Title"] = "Không thể mở PDF";
    ViewData["PageTitle"] = "Không thể mở PDF";
    ViewData["PageSubtitle"] = "Yêu cầu tài liệu không thực hiện được";
}

<main class="container py-5">
    <section class="card border-0 shadow-sm mx-auto" style="max-width:680px">
        <div class="card-body p-4 p-md-5">
            <span class="badge text-bg-danger mb-3">Lỗi @Model.StatusCode</span>
            <h1 class="h3">Không thể mở tài liệu PDF</h1>
            <p class="text-muted mt-3">@Model.Message</p>
            <a class="btn btn-primary mt-2" asp-controller="Pdf" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Quay lại thư viện PDF
            </a>
        </div>
    </section>
</main>
