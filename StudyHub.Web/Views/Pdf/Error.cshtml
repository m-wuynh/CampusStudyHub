@{
    ViewData["Title"] = "Không thể xử lý PDF";
}

<partial name="~/Views/Pdf/_PdfNav.cshtml" />

<div class="pdf-panel pdf-error-panel">
    <span class="pdf-head-icon mb-3"><i class="bi bi-exclamation-triangle"></i></span>
    <p class="pdf-eyebrow">Lỗi @ViewData["Status"]</p>
    <h1>Không thể xử lý yêu cầu</h1>
    <p>@ViewData["Message"]</p>

    <a class="pdf-primary-action"
       asp-controller="Pdf"
       asp-action="Index">
        <i class="bi bi-grid-1x2"></i> Về thư viện
    </a>
</div>
