@model StudyHub.Web.ViewModels.Pdf.PdfLibraryViewModel
@{
    ViewData["Title"] = "PDF học tập";
    ViewData["PageTitle"] = "PDF học tập";
    ViewData["PageSubtitle"] = "Đọc, đánh dấu và ghi chú tài liệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var firstPage = Math.Max(1, Model.PageNumber - 2);
    var lastPage = Math.Min(Model.TotalPages, firstPage + 4);
    firstPage = Math.Max(1, lastPage - 4);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pdf/pdf-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pdf/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pdf/library-tools.css" asp-append-version="true" />
}

<main class="pdf pdf-library container-fluid">
    <header class="pdf-library-header">
        <div>
            <span class="pdf-library-eyebrow"><i class="bi bi-file-earmark-pdf"></i> THƯ VIỆN PDF</span>
            <h1>Tài liệu của tôi</h1>
            <p>Tìm kiếm, đọc và ghi chú tài liệu học tập của bạn.</p>
        </div>
        <button class="pdf-library-upload" type="button" data-bs-toggle="modal" data-bs-target="#uploadPdfModal">
            <i class="bi bi-cloud-arrow-up"></i> Tải PDF lên
        </button>
    </header>


    <form class="pdf-library-search" method="get" role="search">
        <div class="pdf-library-search-box">
            <i class="bi bi-search"></i>
            <label class="visually-hidden" for="pdf-search">Tìm kiếm PDF</label>
            <input id="pdf-search" name="q" value="@Model.SearchQuery" maxlength="100"
                   placeholder="Tìm tên file hoặc ghi chú" />
        </div>
        <button type="submit"><i class="bi bi-search"></i> Tìm kiếm</button>
        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            <a asp-action="Index">Xóa tìm kiếm</a>
        }
    </form>

    <section class="pdf-library-summary" aria-label="Tổng quan thư viện">
        <div><i class="bi bi-file-earmark-pdf-fill"></i><span><strong>@Model.PdfCount</strong> tài liệu</span></div>
        <a asp-action="Trash"><i class="bi bi-trash3"></i><span>Thùng rác</span><i class="bi bi-chevron-right"></i></a>
    </section>

    <section class="pdf-library-content">
        <div class="pdf-library-heading">
            <div><span class="pdf-library-kicker">TỦ TÀI LIỆU</span><h2>PDF của tôi</h2></div>
            <span class="pdf-library-result-count">Trang @Model.PageNumber / @Model.TotalPages</span>
        </div>

        @if (Model.Pdfs.Count == 0)
        {
            <div class="pdf-library-empty">
                <span><i class="bi bi-file-earmark-arrow-up"></i></span>
                <div><strong>Không có PDF phù hợp</strong><p>Thử đổi từ khóa hoặc tải một tài liệu mới.</p></div>
            </div>
        }
        else
        {
            <div class="pdf-library-grid">
                @foreach (var pdf in Model.Pdfs)
                {
                    <article class="pdf-library-card is-pdf">
                        <a class="pdf-library-cover" asp-controller="PdfDocuments" asp-action="Reader"
                           asp-route-id="@pdf.Id" asp-route-page="@pdf.SearchPage" aria-label="Mở @pdf.Title">
                            <i class="bi bi-file-earmark-pdf-fill"></i><span>PDF</span>
                        </a>
                        <div class="pdf-library-card-body">
                            <div class="pdf-library-card-badges"><span>PDF · @pdf.PageCount trang</span></div>
                            <h3><a asp-controller="PdfDocuments" asp-action="Reader" asp-route-id="@pdf.Id"
                                   asp-route-page="@pdf.SearchPage">@pdf.Title</a></h3>
                            <p title="@pdf.FileName">@pdf.FileName</p>
                            @if (pdf.SearchPage.HasValue)
                            {
                                <span class="pdf-library-match"><i class="bi bi-search"></i> Khớp ở trang @pdf.SearchPage</span>
                            }
                            <div class="pdf-library-card-actions">
                                <a asp-controller="PdfDocuments" asp-action="Reader" asp-route-id="@pdf.Id"
                                   asp-route-page="@pdf.SearchPage">Mở tài liệu</a>
                                <button type="button" data-bs-toggle="modal" data-bs-target="#managePdf-@pdf.Id"
                                        aria-label="Quản lý PDF @pdf.Title" title="Quản lý PDF"><i class="bi bi-three-dots"></i></button>
                            </div>
                        </div>
                    </article>
                    <partial name="_PdfManageModal" model="pdf" />
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="pdf-pagination" aria-label="Phân trang PDF">
                @if (Model.PageNumber > 1)
                {
                    <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-q="@Model.SearchQuery" aria-label="Trang trước"><i class="bi bi-chevron-left"></i></a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                }
                @for (var number = firstPage; number <= lastPage; number++)
                {
                    <a class="@(number == Model.PageNumber ? "is-active" : null)" asp-action="Index"
                       asp-route-page="@number" asp-route-q="@Model.SearchQuery"
                       aria-current="@(number == Model.PageNumber ? "page" : null)">@number</a>
                }
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-q="@Model.SearchQuery" aria-label="Trang sau"><i class="bi bi-chevron-right"></i></a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                }
            </nav>
        }
    </section>
</main>

<div class="modal fade pdf-library-modal" id="uploadPdfModal" tabindex="-1" aria-labelledby="uploadPdfTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title h5" id="uploadPdfTitle">Tải PDF lên</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <form asp-controller="PdfDocuments" asp-action="UploadPdf" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <label class="form-label" for="upload-title">Tên hiển thị <span class="text-muted">(không bắt buộc)</span></label>
                <input class="form-control mb-3" id="upload-title" name="title" maxlength="200" />
                <label class="form-label" for="upload-file">File PDF</label>
                <input class="form-control" id="upload-file" name="file" type="file" accept=".pdf,application/pdf" required />
                <p class="form-text mb-0">Tối đa 25 MiB và 5.000 trang. Không hỗ trợ PDF có mật khẩu.</p>
            </div>
            <div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit"><i class="bi bi-cloud-arrow-up"></i> Tải lên</button></div>
        </form>
    </div></div>
</div>
