@model PdfLibraryDto

@{
    ViewData["Title"] = "Tài liệu học tập";
}

<partial name="~/Views/Pdf/_PdfNav.cshtml" />

<header class="pdf-head">
    <div class="pdf-head-copy">
        <span class="pdf-head-icon"><i class="bi bi-collection"></i></span>
        <div>
            <p class="pdf-eyebrow">Không gian học tập</p>
            <h1>Tài liệu học tập</h1>
            <p>@Model.DocumentCount PDF được sắp xếp theo môn học.</p>
        </div>
    </div>

    <a class="pdf-primary-action" asp-action="Upload">
        <i class="bi bi-cloud-arrow-up"></i> Tải PDF
    </a>
</header>

<section class="pdf-grid">
    @foreach (var folder in Model.Folders)
    {
        <article class="pdf-card" style="--accent:@folder.ColorHex">
            <div class="pdf-card-head">
                <span class="pdf-card-icon"><i class="bi bi-folder2-open"></i></span>
                <span class="pdf-count-badge">@folder.DocumentCount PDF</span>
            </div>
            <h2>@folder.Name</h2>
            <p>Thư mục tài liệu và kiến thức của môn học.</p>

            <div class="pdf-actions">
                <a asp-action="Folder"
                   asp-route-subjectId="@folder.UserSubjectId">
                    <i class="bi bi-folder2"></i> Tài liệu
                </a>
                <a asp-action="Dashboard"
                   asp-route-subjectId="@folder.UserSubjectId">
                    <i class="bi bi-bar-chart"></i> Thống kê
                </a>
            </div>
        </article>
    }
</section>

<h2 class="pdf-section-title"><i class="bi bi-clock-history"></i> Mở gần đây</h2>

<div class="pdf-list">
    @foreach (var document in Model.RecentDocuments)
    {
        <partial name="~/Views/Pdf/_PdfDocumentRow.cshtml" model="document" />
    }

    @if (Model.RecentDocuments.Count == 0)
    {
        <div class="pdf-empty-state">
            <div><i class="bi bi-file-earmark-plus"></i><strong>Chưa có tài liệu</strong><span>Tải PDF đầu tiên để bắt đầu.</span></div>
        </div>
    }
</div>
