@model StudyHub.Web.ViewModels.Pdf.PdfReaderViewModel
@using System.Globalization
@{
    Layout = null;
    var fileUrl = Url.Action("OpenPdf", "PdfDocuments", new { documentId = Model.DocumentId, shareId = Model.ShareId });
    string Number(double value) => (value * 1000).ToString("0.###", CultureInfo.InvariantCulture);
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title · Trang @Model.CurrentPage</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pdf/pdf-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pdf/pdf-reader.css" asp-append-version="true" />
</head>
<body class="pdf pdf-viewer">
    <header class="pdf-viewer-toolbar">
        <strong class="pdf-viewer-file" title="@Model.Title"><i class="bi bi-file-earmark-pdf"></i> @Model.Title</strong>
        <nav class="pdf-viewer-pages" aria-label="Chuyển trang">
            @if (Model.CurrentPage > 1)
            {
                <a class="pdf-page-nav" data-reader-page-link title="Trang trước" aria-label="Trang trước"
                   asp-controller="PdfDocuments" asp-action="Viewer" asp-route-id="@Model.DocumentId"
                   asp-route-shareId="@Model.ShareId" asp-route-page="@(Model.CurrentPage - 1)"><i class="bi bi-chevron-left"></i></a>
            }
            else
            {
                <span class="pdf-page-nav disabled" aria-disabled="true"><i class="bi bi-chevron-left"></i></span>
            }
            <form asp-controller="PdfDocuments" asp-action="Viewer" asp-route-id="@Model.DocumentId" method="get" class="pdf-viewer-page-form">
                <label class="visually-hidden" for="viewer-page-number">Trang PDF</label>
                <input id="viewer-page-number" name="page" type="number" min="1" max="@Model.PageCount" value="@Model.CurrentPage" />
                <input type="hidden" name="shareId" value="@Model.ShareId" />
                <span>/ @Model.PageCount</span>
                <button type="submit" title="Đi tới trang" aria-label="Đi tới trang"><i class="bi bi-arrow-right"></i></button>
            </form>
            @if (Model.CurrentPage < Model.PageCount)
            {
                <a class="pdf-page-nav" data-reader-page-link title="Trang sau" aria-label="Trang sau"
                   asp-controller="PdfDocuments" asp-action="Viewer" asp-route-id="@Model.DocumentId"
                   asp-route-shareId="@Model.ShareId" asp-route-page="@(Model.CurrentPage + 1)"><i class="bi bi-chevron-right"></i></a>
            }
            else
            {
                <span class="pdf-page-nav disabled" aria-disabled="true"><i class="bi bi-chevron-right"></i></span>
            }
        </nav>
        <div class="pdf-zoom-controls" aria-label="Phóng to, thu nhỏ PDF">
            <button id="pdf-zoom-out" type="button" title="Thu nhỏ PDF" aria-label="Thu nhỏ PDF"><i class="bi bi-dash-lg"></i></button>
            <label class="visually-hidden" for="pdf-zoom">Mức phóng to PDF</label>
            <select id="pdf-zoom" class="form-select form-select-sm pdf-viewer-zoom" aria-label="Mức phóng to PDF">
                <option value="0.5">50%</option><option value="0.75">75%</option>
                <option value="1" selected>Vừa rộng</option><option value="1.25">125%</option>
                <option value="1.5">150%</option><option value="2">200%</option><option value="3">300%</option>
            </select>
            <button id="pdf-zoom-in" type="button" title="Phóng to PDF" aria-label="Phóng to PDF"><i class="bi bi-plus-lg"></i></button>
        </div>
    </header>

    @if (Model.IsReadOnly && !Model.ShareId.HasValue)
    {
        <div class="pdf-view-only-bar"><i class="bi bi-shield-lock"></i><span>Tài liệu đã lưu trữ · Chế độ chỉ xem</span></div>
    }
    else if (!Model.IsReadOnly)
    {
        <nav class="pdf-penbar" aria-label="Công cụ PDF">
            <span class="pdf-penbar-label">CÔNG CỤ</span>
            <label class="visually-hidden" for="mark-tool">Công cụ đánh dấu</label>
            <select class="visually-hidden" id="mark-tool">
                <option value="Pan" selected>Bàn tay</option><option value="Highlight">Tô sáng</option>
                <option value="Ink">Bút vẽ</option><option value="Comment">Thêm chữ</option><option value="Eraser">Tẩy dấu</option>
            </select>
            <button type="button" class="pdf-pen-tool active" data-mark-tool="Pan" title="Bàn tay: cuộn tài liệu" aria-label="Bàn tay" aria-pressed="true"><i class="bi bi-hand-index"></i><span>Bàn tay</span></button>
            <span class="pdf-pen-divider"></span>
            <button type="button" class="pdf-pen-tool" data-mark-tool="Highlight" title="Kéo để tô sáng" aria-label="Tô sáng" aria-pressed="false"><i class="bi bi-highlighter"></i><span>Tô sáng</span></button>
            <button type="button" class="pdf-pen-tool" data-mark-tool="Ink" title="Kéo để vẽ" aria-label="Bút vẽ" aria-pressed="false"><i class="bi bi-pencil"></i><span>Bút</span></button>
            <button type="button" class="pdf-pen-tool" data-mark-tool="Comment" title="Chạm để thêm chữ" aria-label="Thêm chữ" aria-pressed="false"><i class="bi bi-fonts"></i><span>Chữ</span></button>
            <button type="button" class="pdf-pen-tool" data-mark-tool="Eraser" title="Chạm vào dấu để tẩy" aria-label="Tẩy" aria-pressed="false"><i class="bi bi-eraser"></i><span>Tẩy</span></button>
            <button type="button" class="pdf-pen-tool" id="undo-mark" title="Bỏ dấu chưa lưu cuối cùng" aria-label="Hoàn tác dấu chưa lưu" disabled><i class="bi bi-arrow-counterclockwise"></i><span>Hoàn tác</span></button>
            <span class="pdf-pen-divider"></span>
            <label class="pdf-pen-color d-none" for="mark-color" data-color-control><span>Màu</span><input id="mark-color" type="color" value="#ffd54f" title="Màu nét" /></label>
            <div class="pdf-comment-editor d-none" data-comment-editor>
                <label class="visually-hidden" for="mark-text">Nội dung chữ</label>
                <input class="form-control form-control-sm" id="mark-text" maxlength="2000" placeholder="Nhập chữ rồi bấm vị trí trên PDF" />
            </div>
            <span class="pdf-autosave-badge" title="Mọi thay đổi được lưu tự động"><i class="bi bi-cloud-check"></i> Tự động lưu</span>
        </nav>
    }

    <p id="pdf-status" class="pdf-viewer-status" role="status" data-read-only="@Model.IsReadOnly.ToString().ToLowerInvariant()">Đang mở trang PDF…</p>
    <div class="pdf-viewer-surface">
        <div class="pdf-pdf-page" id="pdf-page" data-file-url="@fileUrl" data-page="@Model.CurrentPage" data-archived="@Model.IsReadOnly.ToString().ToLowerInvariant()">
            <canvas id="pdf-canvas" aria-label="Trang PDF @Model.CurrentPage"></canvas>
            <svg id="mark-layer" class="pdf-mark-layer" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-label="Đánh dấu trên trang PDF">
                @foreach (var mark in Model.Marks)
                {
                    if (mark.Kind == "Highlight")
                    {
                        <rect data-mark-id="@mark.Id" data-version="@mark.VersionToken" x="@Number(mark.X)" y="@Number(mark.Y)" width="@Number(mark.Width)" height="@Number(mark.Height)" fill="@mark.Color" opacity="0.42" />
                    }
                    else if (mark.Kind == "Ink")
                    {
                        var points = string.Join(" ", mark.Points.Select(point => $"{Number(point.X)},{Number(point.Y)}"));
                        <polyline data-mark-id="@mark.Id" data-version="@mark.VersionToken" points="@points" fill="none" stroke="@mark.Color" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
                    }
                    else if (mark.Kind == "Comment")
                    {
                        <foreignObject data-mark-id="@mark.Id" data-version="@mark.VersionToken" x="@Number(mark.X)" y="@Number(mark.Y)" width="270" height="110">
                            <div xmlns="http://www.w3.org/1999/xhtml" class="pdf-pdf-text" style="border-color:@mark.Color">@mark.Text</div>
                        </foreignObject>
                    }
                }
            </svg>
        </div>
    </div>

    @if (!Model.IsReadOnly)
    {
        <form asp-controller="PdfMarks" asp-action="AutoSave" method="post" id="mark-form" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="documentId" value="@Model.DocumentId" /><input type="hidden" name="pageNumber" value="@Model.CurrentPage" />
            <input type="hidden" name="shareId" value="@Model.ShareId" /><input type="hidden" name="marksJson" />
        </form>
        <form asp-controller="PdfMarks" asp-action="Delete" method="post" id="erase-form" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="markId" /><input type="hidden" name="versionToken" />
            <input type="hidden" name="documentId" value="@Model.DocumentId" />
            <input type="hidden" name="pageNumber" value="@Model.CurrentPage" /><input type="hidden" name="shareId" value="@Model.ShareId" />
        </form>
    }
    <partial name="_ToastMessages" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/pdf/pdf-marks.js" asp-append-version="true"></script>
</body>
</html>
