@model PdfDocumentItemDto

@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<article class="pdf-document-row">
    <a class="pdf-document-link"
       asp-controller="PdfDocuments"
       asp-action="Reader"
       asp-route-id="@Model.DocumentId">
        <span class="pdf-list-icon"><i class="bi bi-file-earmark-pdf"></i></span>
        <span class="pdf-list-copy">
            <strong>@Model.Title</strong>
            <span>
                @(Model.SubjectName ?? "Chưa phân loại") ·
                @Model.OriginalFileName · @Model.PageCount trang
            </span>
        </span>
    </a>

    <details class="pdf-document-menu">
        <summary aria-label="Tùy chọn cho @Model.Title" title="Tùy chọn">
            <i class="bi bi-three-dots-vertical"></i>
        </summary>

        <div class="pdf-document-menu-popover">
            <strong>Quản lý tài liệu</strong>

            <form asp-controller="PdfDocuments"
                  asp-action="Rename"
                  asp-route-id="@Model.DocumentId"
                  method="post">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <label for="pdf-title-@Model.DocumentId">Đổi tên</label>
                <div class="pdf-rename-row">
                    <input id="pdf-title-@Model.DocumentId"
                           name="title"
                           value="@Model.Title"
                           maxlength="@PdfPolicy.MaxTitleLength"
                           required />
                    <button class="btn btn-primary btn-sm" type="submit">Lưu</button>
                </div>
            </form>

            <form asp-controller="PdfDocuments"
                  asp-action="Delete"
                  asp-route-id="@Model.DocumentId"
                  method="post"
                  onsubmit="return confirm('Chuyển PDF vào thùng rác? Bạn có thể khôi phục trong @PdfPolicy.TrashRetentionDays ngày.');">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button class="pdf-menu-danger" type="submit">
                    <i class="bi bi-trash3"></i> Chuyển vào thùng rác
                </button>
            </form>
        </div>
    </details>
</article>
