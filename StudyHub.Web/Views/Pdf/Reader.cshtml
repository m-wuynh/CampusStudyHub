@model PdfReaderDto

@{
    ViewData["Title"] = Model.Title;
    var fileUrl = Url.Action(
        "File",
        "PdfDocuments",
        new { id = Model.DocumentId });
    var aiRemaining = Math.Max(0, Model.AiDailyLimit - Model.AiRequestsUsedToday);
    var aiUsagePercent = Math.Min(
        100,
        Model.AiRequestsUsedToday * 100 / Model.AiDailyLimit);
}

<partial name="~/Views/Pdf/_PdfNav.cshtml" />

<header class="pdf-head">
    <div class="pdf-head-copy">
        <span class="pdf-head-icon"><i class="bi bi-file-earmark-pdf"></i></span>
        <div>
            <p class="pdf-eyebrow">Trình đọc tài liệu</p>
            <h1>@Model.Title</h1>
            <p>@Model.FileName · trang @Model.CurrentPage/@Model.PageCount</p>
        </div>
    </div>

    <a class="btn btn-outline-secondary"
       asp-controller="Pdf"
       asp-action="Folder"
       asp-route-subjectId="@Model.UserSubjectId">
        <i class="bi bi-folder2"></i> Về thư mục
    </a>
</header>

<div class="pdf-reader">
    <section class="pdf-viewer-shell">
        <div class="pdf-pager">
            <a class="btn btn-outline-secondary @(Model.CurrentPage == 1 ? "disabled" : "")"
               asp-action="Reader"
               asp-route-id="@Model.DocumentId"
               asp-route-page="@(Model.CurrentPage - 1)">
                Trang trước
            </a>

            <form method="get">
                <span class="pdf-page-label">Trang</span>
                <input name="page"
                       type="number"
                       min="1"
                       max="@Model.PageCount"
                       value="@Model.CurrentPage" />
                <span class="pdf-page-label">/ @Model.PageCount</span>
                <button class="btn btn-outline-light" type="submit">Mở</button>
            </form>

            <a class="btn btn-outline-secondary @(Model.CurrentPage == Model.PageCount ? "disabled" : "")"
               asp-action="Reader"
               asp-route-id="@Model.DocumentId"
               asp-route-page="@(Model.CurrentPage + 1)">
                Trang sau
            </a>
        </div>

        <div class="pdf-page-canvas"
             data-pdf-page
             data-pdf-url="@fileUrl"
             data-page-number="@Model.CurrentPage">
            <div class="pdf-page-loading" role="status">
                <span class="spinner-border spinner-border-sm"></span>
                Đang tải trang @Model.CurrentPage...
            </div>
            <canvas hidden aria-label="@Model.Title, trang @Model.CurrentPage"></canvas>
        </div>
    </section>

    <aside>
        <div class="pdf-panel pdf-note-panel">
            <div class="pdf-panel-title">
                <i class="bi bi-bookmark-check"></i><h2>Ghi chú có nguồn</h2>
            </div>

            <div class="pdf-note-source">
                <i class="bi bi-link-45deg"></i>
                <span>Đang gắn với <strong>trang @Model.CurrentPage</strong>. Chuyển trang bằng thanh phía trên trước khi ghi chú.</span>
            </div>

            @if (Model.NotePages.Count > 0)
            {
                <div class="pdf-note-pages">
                    <span>Trang đã ghi chú</span>
                    <div>
                        @foreach (var notePage in Model.NotePages)
                        {
                            <a class="@(notePage == Model.CurrentPage ? "active" : null)"
                               asp-action="Reader"
                               asp-route-id="@Model.DocumentId"
                               asp-route-page="@notePage">@notePage</a>
                        }
                    </div>
                </div>
            }

            <form class="pdf-note-form"
                  asp-action="SaveNote"
                  asp-route-id="@Model.DocumentId"
                  method="post">
                <input type="hidden"
                       name="page"
                       value="@Model.CurrentPage" />
                <textarea name="content"
                          maxlength="@PdfPolicy.MaxNoteLength"
                          rows="12"
                          placeholder="Ý chính, công thức hoặc câu hỏi ở trang @Model.CurrentPage...">@Model.NoteText</textarea>
                <button class="pdf-primary-action" type="submit">
                    <i class="bi bi-check2"></i> Lưu cho trang @Model.CurrentPage
                </button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.NoteText))
            {
                <form asp-action="SaveNote"
                      asp-route-id="@Model.DocumentId"
                      method="post"
                      onsubmit="return confirm('Xóa toàn bộ ghi chú của trang này?');">
                    <input type="hidden" name="page" value="@Model.CurrentPage" />
                    <input type="hidden" name="content" value="" />
                    <button class="btn btn-outline-danger w-100" type="submit">
                        <i class="bi bi-trash3"></i> Xóa ghi chú trang này
                    </button>
                </form>
            }
        </div>

        <details class="pdf-panel pdf-ai-panel">
            <summary>
                <span><i class="bi bi-stars"></i> Tóm tắt bằng Gemini</span>
                <small>@Model.AiRequestsUsedToday/@Model.AiDailyLimit lượt hôm nay</small>
            </summary>

            <div class="pdf-ai-usage">
                <div>
                    <strong>Còn @aiRemaining lượt AI hôm nay</strong>
                    <span>Mỗi lần chọn tối đa @PdfPolicy.MaxAiPagesPerRequest trang.</span>
                </div>
                <div class="progress" role="progressbar"
                     aria-label="Lượt AI đã dùng"
                     aria-valuenow="@Model.AiRequestsUsedToday"
                     aria-valuemin="0"
                     aria-valuemax="@Model.AiDailyLimit">
                    <div class="progress-bar" style="width:@aiUsagePercent%"></div>
                </div>
                <small>Đọc lại kết quả đã cache không tính thêm lượt.</small>
            </div>

            <form class="pdf-range"
                  asp-action="Analyze"
                  asp-route-id="@Model.DocumentId"
                  method="post">
                <label>
                    Từ trang
                    <input name="fromPage"
                           type="number"
                           min="1"
                           max="@Model.PageCount"
                           value="@Model.CurrentPage" />
                </label>

                <label>
                    Đến trang
                    <input name="toPage"
                           type="number"
                           min="1"
                           max="@Model.PageCount"
                           value="@Model.CurrentPage" />
                </label>

                <button class="pdf-primary-action" type="submit">
                    <i class="bi bi-stars"></i> Tạo bản nháp AI
                </button>
            </form>
        </details>
    </aside>
</div>

<script type="module" src="~/js/pdf/page-viewer.js" asp-append-version="true"></script>
