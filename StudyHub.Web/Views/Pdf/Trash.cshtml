@model StudyHub.Web.ViewModels.Pdf.PdfTrashViewModel
@{
    ViewData["Title"] = "Thùng rác PDF";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pdf/pdf-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pdf/index.css" asp-append-version="true" />
}

<main class="pdf pdf-library pdf-trash container py-4">
    <a class="btn-secondary-sh pdf-trash-back" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Quay lại thư viện
    </a>
    <header class="pdf-trash-heading">
        <h1>Thùng rác PDF</h1>
        <p class="text-muted mb-0">Tài liệu được giữ 30 ngày trước khi tự động xóa vĩnh viễn.</p>
    </header>


    @if (Model.Pdfs.Count == 0)
    {
        <div class="pdf-library-empty">
            <span><i class="bi bi-trash3"></i></span>
            <div><strong>Thùng rác đang trống</strong><p>PDF bạn xóa sẽ xuất hiện ở đây trong thời hạn khôi phục.</p></div>
        </div>
    }
    else
    {
        <div class="pdf-library-grid">
            @foreach (var pdf in Model.Pdfs)
            {
                <article class="pdf-library-card is-pdf">
                    <div class="pdf-library-cover"><i class="bi bi-file-earmark-pdf-fill"></i><span>ĐÃ XÓA</span></div>
                    <div class="pdf-library-card-body">
                        <div class="pdf-library-card-badges"><span class="is-muted">Còn @pdf.DaysLeft ngày</span></div>
                        <h3>@pdf.Title</h3>
                        <p title="@pdf.FileName">@pdf.FileName</p>
                        <div class="pdf-trash-actions">
                            <form asp-controller="PdfDocuments" asp-action="RestorePdf" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@pdf.Id" />
                                <input type="hidden" name="versionToken" value="@pdf.VersionToken" />
                                <button class="btn btn-outline-primary btn-sm" type="submit"><i class="bi bi-arrow-counterclockwise"></i> Khôi phục</button>
                            </form>
                            <form asp-controller="PdfDocuments" asp-action="PermanentlyDeletePdf" method="post"
                                  data-confirm="PDF và toàn bộ ghi chú, đánh dấu sẽ bị xóa vĩnh viễn. Tiếp tục?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@pdf.Id" />
                                <input type="hidden" name="versionToken" value="@pdf.VersionToken" />
                                <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i> Xóa vĩnh viễn</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</main>
