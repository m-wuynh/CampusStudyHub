@model IReadOnlyList<PdfTrashItemDto>

@{
    ViewData["Title"] = "Thùng rác PDF";
}

<partial name="~/Views/Pdf/_PdfNav.cshtml" />

<header class="pdf-head">
    <div class="pdf-head-copy">
        <span class="pdf-head-icon"><i class="bi bi-trash3"></i></span>
        <div>
            <p class="pdf-eyebrow">Quản lý tài liệu đã xóa</p>
            <h1>Thùng rác</h1>
            <p>PDF được giữ @PdfPolicy.TrashRetentionDays ngày trước khi tự động xóa vĩnh viễn.</p>
        </div>
    </div>
</header>

<div class="pdf-list">
    @foreach (var document in Model)
    {
        <article class="pdf-trash-item">
            <div class="pdf-trash-copy">
                <i class="bi bi-file-earmark-pdf"></i>
                <div>
                    <strong>@document.Title</strong>
                    <span>@document.OriginalFileName</span>
                    <small>Xóa sau @document.DeletePermanentlyAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                </div>
            </div>

            <form asp-controller="PdfDocuments"
                  asp-action="Restore"
                  asp-route-id="@document.DocumentId"
                  method="post">
                <button class="btn btn-outline-primary" type="submit">
                    Khôi phục
                </button>
            </form>
        </article>
    }

    @if (Model.Count == 0)
    {
        <div class="pdf-empty-state"><div><i class="bi bi-trash3"></i><strong>Thùng rác đang trống</strong><span>Tài liệu đã xóa sẽ xuất hiện tại đây trong @PdfPolicy.TrashRetentionDays ngày.</span></div></div>
    }
</div>
