@model StudyGroupsIndexViewModel
@{
    ViewData["Title"] = "Nhóm học tập";
    ViewData["PageTitle"] = "Nhóm học tập";
    ViewData["PageSubtitle"] = "Khám phá, tham gia và cộng tác theo từng môn học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="groups-view" data-initial-search="@Model.SearchText" style="max-width:1280px;margin:0 auto;">
  <form id="groups-antiforgery" hidden>@Html.AntiForgeryToken()</form>

  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
      <h2 class="fw-black mb-1 tracking-tight" style="font-size:22px;color:var(--sh-slate-900);">Không gian học tập của bạn</h2>
      <p id="groups-summary" class="mb-0" style="font-size:12px;color:var(--sh-slate-500);">Đang tải dữ liệu nhóm...</p>
    </div>
    <div class="d-flex gap-2">
      <button type="button" class="btn-secondary-sh" data-bs-toggle="modal" data-bs-target="#joinInviteModal">
        <i class="bi bi-link-45deg"></i>Dùng mã mời
      </button>
      <button type="button" class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#newGroupModal">
        <i class="bi bi-plus-lg"></i>Tạo nhóm
      </button>
    </div>
  </div>

  <form id="group-search-form" class="mb-4" role="search">
    <div class="d-flex flex-column flex-sm-row gap-2">
      <div class="position-relative flex-grow-1">
        <i class="bi bi-search position-absolute" style="left:13px;top:50%;transform:translateY(-50%);color:var(--sh-slate-400);"></i>
        <input id="group-search-input" class="sh-input w-100" type="search" name="q"
               value="@Model.SearchText" maxlength="100" autocomplete="off"
               placeholder="Tìm theo tên, môn học, mục tiêu..." style="padding-left:38px;" />
      </div>
      <button type="submit" class="btn-primary-sh justify-content-center"><i class="bi bi-search"></i>Tìm</button>
      <button id="clear-group-search" type="button" class="btn-secondary-sh justify-content-center" hidden>Xóa</button>
    </div>
  </form>

  <ul class="nav nav-tabs mb-4 group-tabs" role="tablist">
    <li class="nav-item"><button type="button" class="nav-link active group-tab" data-tab-target="my-groups">Nhóm của tôi</button></li>
    <li class="nav-item"><button type="button" class="nav-link group-tab" data-tab-target="pending-groups">Đang chờ duyệt</button></li>
    <li class="nav-item"><button type="button" class="nav-link group-tab" data-tab-target="discover-groups">Khám phá</button></li>
  </ul>

  <div id="groups-loading" class="sh-card p-5 text-center" aria-live="polite">
    <div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden">Đang tải</span></div>
    <p class="mb-0" style="font-size:12px;color:var(--sh-slate-500);">Đang tải nhóm từ SQL Server...</p>
  </div>

  @foreach (var sectionId in new[] { "my-groups", "pending-groups", "discover-groups" })
  {
    <section id="@sectionId" class="group-list-section" hidden>
      <div class="row g-4"></div>
      <div class="groups-empty sh-card p-5 text-center" hidden>
        <i class="bi bi-people d-block mb-2" style="font-size:30px;color:var(--sh-slate-400);"></i>
        <p class="mb-0" style="font-size:12px;color:var(--sh-slate-500);">Chưa có nhóm phù hợp trong mục này.</p>
      </div>
    </section>
  }
</div>

<div class="modal fade" id="newGroupModal" tabindex="-1" aria-labelledby="newGroupModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header px-4 py-3">
        <div>
          <h5 class="modal-title fw-bold" id="newGroupModalLabel">Tạo nhóm học tập</h5>
          <p class="mb-0" style="font-size:11px;color:var(--sh-slate-500);">Thiết lập cách mọi người tìm thấy và tham gia nhóm.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <div class="modal-body px-4 py-4">
        <div class="row g-3">
          <div class="col-12">
            <label class="sh-label" for="group-name">Tên nhóm</label>
            <input id="group-name" class="sh-input" maxlength="150" placeholder="Ví dụ: Ôn thi Cơ sở dữ liệu" />
          </div>
          <div class="col-12">
            <label class="sh-label" for="group-subject-toggle">Môn học <span class="text-danger">*</span></label>
            <div id="group-subject-select" class="subject-multiselect">
              <button id="group-subject-toggle" type="button" class="subject-multiselect-toggle"
                      data-subject-toggle aria-expanded="false" aria-controls="group-subject-panel">
                <span data-subject-summary>Chọn môn học</span>
                <i class="bi bi-chevron-down"></i>
              </button>
              <div id="group-subject-panel" class="subject-multiselect-panel" data-subject-panel hidden>
                <div class="subject-multiselect-search">
                  <i class="bi bi-search"></i>
                  <input type="text" maxlength="150" data-subject-search
                         placeholder="Tìm hoặc nhập môn học mới..." autocomplete="off" />
                </div>
                <div class="group-subject-picker" data-subject-options aria-live="polite"></div>
                <p class="subject-multiselect-hint" data-subject-hint>Nhập tên môn rồi nhấn Enter để thêm môn mới.</p>
              </div>
            </div>
            <p class="mb-0 mt-2" style="font-size:10px;color:var(--sh-slate-500);">
              Tích các môn có sẵn hoặc tìm và nhấn Enter để thêm môn mới. Tối đa 10 môn.
            </p>
          </div>
          <div class="col-12">
            <label class="sh-label" for="group-desc">Mô tả</label>
            <textarea id="group-desc" class="sh-input" rows="2" maxlength="2000" placeholder="Nhóm dành cho ai và sẽ học những gì?"></textarea>
          </div>
          <div class="col-12">
            <label class="sh-label" for="group-goal">Mục tiêu</label>
            <input id="group-goal" class="sh-input" maxlength="500" placeholder="Ví dụ: Hoàn thành đề cương trước kỳ thi cuối kỳ" />
          </div>
          <div class="col-md-4">
            <label class="sh-label" for="group-format">Hình thức</label>
            <select id="group-format" class="sh-input"><option value="Online">Online</option><option value="Offline">Offline</option><option value="Hybrid">Kết hợp</option></select>
          </div>
          <div class="col-md-5">
            <label class="sh-label" for="group-schedule">Lịch dự kiến</label>
            <input id="group-schedule" class="sh-input" maxlength="250" placeholder="Thứ 7, 19:00 hàng tuần" />
          </div>
          <div class="col-md-3">
            <label class="sh-label" for="group-max-members">Giới hạn người</label>
            <input id="group-max-members" class="sh-input" type="number" min="2" max="500" placeholder="Không giới hạn" />
            <small class="d-block mt-1" style="font-size:9px;color:var(--sh-slate-500);">Để trống nếu nhóm không giới hạn thành viên.</small>
          </div>
          <div class="col-12">
            <label class="sh-label" for="group-access">Cách tham gia</label>
            <select id="group-access" class="sh-input">
              <option value="Approval">Công khai · Cần duyệt</option>
              <option value="Open">Công khai · Vào ngay</option>
              <option value="InviteOnly">Riêng tư · Chỉ qua lời mời</option>
            </select>
          </div>
          <div class="col-12">
            <label class="sh-label" for="group-rules">Nội quy nhóm</label>
            <textarea id="group-rules" class="sh-input" rows="2" maxlength="2000" placeholder="Tôn trọng thành viên, không spam, chuẩn bị bài trước buổi học..."></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer px-4 py-3">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button id="create-group-btn" type="button" class="btn-primary-sh"><i class="bi bi-plus-lg"></i>Tạo nhóm</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="joinInviteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header"><h5 class="modal-title fw-bold" style="font-size:15px;">Tham gia bằng mã mời</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <label class="sh-label" for="invite-code-input">Mã hoặc đường dẫn lời mời</label>
        <input id="invite-code-input" class="sh-input" placeholder="Dán mã mời tại đây" />
      </div>
      <div class="modal-footer"><button id="open-invite-btn" type="button" class="btn-primary-sh w-100 justify-content-center">Mở lời mời</button></div>
    </div>
  </div>
</div>

<script src="~/js/subject-multiselect.js" asp-append-version="true"></script>
<script src="~/js/groups.js" asp-append-version="true"></script>
