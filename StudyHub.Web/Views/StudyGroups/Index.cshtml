@model StudyGroupsIndexViewModel
@{
    ViewData["Title"] = "Nhóm học tập";
    ViewData["PageTitle"] = "Nhóm học tập";
    ViewData["PageSubtitle"] = "Cùng trao đổi kiến thức với bạn cùng lớp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="groups-view" data-initial-search="@Model.SearchText" style="max-width:1280px; margin:0 auto;">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
      <h2 class="fw-black mb-0 tracking-tight" style="font-size:20px; color:var(--sh-slate-900);">Nhóm học tập của tôi</h2>
      <p id="groups-summary" class="mb-0" style="font-size:12px; color:var(--sh-slate-500);">Đang tải dữ liệu nhóm...</p>
    </div>
    <button type="button" class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#newGroupModal">
      <i class="bi bi-plus-lg"></i>Tạo nhóm mới
    </button>
  </div>

  <form id="group-search-form" class="mb-4" role="search">
    <div class="d-flex flex-column flex-sm-row gap-2">
      <div class="position-relative flex-grow-1">
        <i class="bi bi-search position-absolute" style="left:13px; top:50%; transform:translateY(-50%); color:var(--sh-slate-400);"></i>
        <input id="group-search-input" class="sh-input w-100" type="search" name="q"
               value="@Model.SearchText" maxlength="100" autocomplete="off"
               placeholder="Tìm theo tên nhóm, môn học hoặc mô tả..." style="padding-left:38px;" />
      </div>
      <button type="submit" class="btn-primary-sh justify-content-center"><i class="bi bi-search"></i>Tìm kiếm</button>
      <button id="clear-group-search" type="button" class="btn-secondary-sh justify-content-center" hidden>Xóa tìm kiếm</button>
    </div>
  </form>

  <ul class="nav nav-tabs mb-4" style="border-bottom:2px solid var(--sh-slate-200);">
    <li class="nav-item">
      <button type="button" class="nav-link active fw-bold px-4 group-tab" id="my-groups-tab"
              data-tab-target="my-groups"
              style="font-size:12px; color:var(--sh-indigo-600); border-bottom:2px solid var(--sh-indigo-600); border-top:0; border-left:0; border-right:0; background:transparent;">
        Nhóm của tôi
      </button>
    </li>
    <li class="nav-item">
      <button type="button" class="nav-link fw-semibold px-4 group-tab" id="discover-groups-tab"
              data-tab-target="discover-groups"
              style="font-size:12px; color:var(--sh-slate-500); border:0; background:transparent;">
        Khám phá nhóm
      </button>
    </li>
  </ul>

  <div id="groups-loading" class="sh-card p-5 text-center" aria-live="polite">
    <div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden">Đang tải</span></div>
    <p class="mb-0" style="font-size:12px; color:var(--sh-slate-500);">Đang tải nhóm từ SQL Server...</p>
  </div>

  <section id="my-groups" aria-labelledby="my-groups-tab" hidden>
    <div class="row g-4"></div>
    <div class="groups-empty sh-card p-5 text-center" hidden>
      <i class="bi bi-people d-block mb-2" style="font-size:28px; color:var(--sh-slate-400);"></i>
      <p class="mb-0" style="font-size:12px; color:var(--sh-slate-500);">Bạn chưa tham gia nhóm nào phù hợp.</p>
    </div>
  </section>

  <section id="discover-groups" aria-labelledby="discover-groups-tab" hidden>
    <div class="row g-4"></div>
    <div class="groups-empty sh-card p-5 text-center" hidden>
      <i class="bi bi-search d-block mb-2" style="font-size:28px; color:var(--sh-slate-400);"></i>
      <p class="mb-0" style="font-size:12px; color:var(--sh-slate-500);">Không tìm thấy nhóm công khai phù hợp.</p>
    </div>
  </section>
</div>

<div class="modal fade" id="newGroupModal" tabindex="-1" aria-labelledby="newGroupModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header border-bottom px-4 py-3">
        <div>
          <h5 class="modal-title fw-bold" id="newGroupModalLabel" style="font-size:16px;">Tạo nhóm học tập mới</h5>
          <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500);">Nhóm mới sẽ được lưu vào SQL Server.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <div class="modal-body px-4 py-4">
        <div class="mb-3">
          <label class="sh-label" for="group-name">Tên nhóm</label>
          <input id="group-name" type="text" class="sh-input" maxlength="100" placeholder="Ví dụ: Toán nâng cao 11A1" />
        </div>
        <div class="mb-3">
          <label class="sh-label" for="group-subject">Môn học chính</label>
          <select id="group-subject" class="sh-input">
            <option>Toán</option><option>Vật lý</option><option>Hóa học</option>
            <option>Sinh học</option><option>Lịch sử</option><option>Tiếng Anh</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="sh-label" for="group-desc">Mô tả nhóm</label>
          <textarea id="group-desc" class="sh-input" rows="3" maxlength="500" placeholder="Mục tiêu và hoạt động của nhóm..."></textarea>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="group-public" checked />
          <label class="form-check-label" for="group-public" style="font-size:12px; color:var(--sh-slate-600);">
            Cho phép học sinh khác tìm thấy và tham gia nhóm
          </label>
        </div>
      </div>
      <div class="modal-footer border-top px-4 py-3">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button id="create-group-btn" type="button" class="btn-primary-sh"><i class="bi bi-plus-lg"></i>Tạo nhóm</button>
      </div>
    </div>
  </div>
</div>

<script src="~/js/groups.js" asp-append-version="true"></script>
