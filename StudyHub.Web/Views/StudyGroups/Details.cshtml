@model StudyGroupDetailsViewModel
@{
    ViewData["Title"] = Model.Group.Name;
    ViewData["PageTitle"] = Model.Group.Name;
    ViewData["PageSubtitle"] = Model.Group.IsMember ? "Không gian cộng tác của nhóm" : "Xem trước nhóm học tập";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pendingMemberCount = Model.Group.Members.Count(member => member.Status == "Pending");
    string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
}

<div id="group-details-page"
     data-group-id="@Model.Group.Id"
     data-is-member="@Model.Group.IsMember.ToString().ToLowerInvariant()"
     data-is-owner="@Model.Group.IsOwner.ToString().ToLowerInvariant()"
     style="max-width:1240px;margin:0 auto;">
  <form id="group-antiforgery" hidden>@Html.AntiForgeryToken()</form>

  <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <a asp-controller="StudyGroups" asp-action="Index" class="d-inline-flex align-items-center gap-2 text-decoration-none" style="font-size:12px;color:var(--sh-slate-600);">
      <i class="bi bi-arrow-left"></i>Danh sách nhóm
    </a>
    <div class="d-flex gap-2">
      @if (Model.Group.IsOwner)
      {
        <button type="button" class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#editGroupModal">
          <i class="bi bi-pencil-square"></i>Chỉnh sửa nhóm
        </button>
      }
      else if (Model.Group.IsMember)
      {
        <button id="leave-group-btn" type="button" class="btn-secondary-sh" style="color:var(--sh-rose-600);"><i class="bi bi-box-arrow-left"></i>Rời nhóm</button>
      }
    </div>
  </div>

  @if (TempData["GroupSuccess"] is string success)
  {
    <div class="alert alert-success py-2 px-3" role="alert" style="font-size:12px;">@success</div>
  }

  <section class="group-hero sh-card overflow-hidden mb-4">
    <div class="p-4 p-md-5">
      <div class="d-flex flex-column flex-lg-row justify-content-between gap-4">
        <div class="flex-grow-1">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            @foreach (var subject in Model.Group.Subjects)
            {
              <span class="subject-badge @subject.CssClass">@subject.Name</span>
            }
            <span class="group-access-badge"><i class="bi @(Model.Group.IsPublic ? "bi-globe2" : "bi-lock-fill")"></i>@(Model.Group.IsPublic ? "Công khai" : "Riêng tư")</span>
            <span class="group-access-badge">@(Model.Group.JoinMode == "Open" ? "Vào ngay" : Model.Group.JoinMode == "Approval" ? "Cần duyệt" : "Chỉ lời mời")</span>
          </div>
          <h1 class="fw-black mb-2" style="font-size:clamp(24px,4vw,34px);color:var(--sh-slate-900);">@Model.Group.Name</h1>
          <p class="mb-3" style="max-width:760px;font-size:13px;color:var(--sh-slate-600);line-height:1.7;">@(string.IsNullOrWhiteSpace(Model.Group.Description) ? "Nhóm chưa có mô tả." : Model.Group.Description)</p>
          @if (!string.IsNullOrWhiteSpace(Model.Group.Goal))
          {
            <p class="mb-0 d-flex gap-2" style="font-size:12px;color:var(--sh-indigo-700);"><i class="bi bi-bullseye"></i><strong>Mục tiêu:</strong> @Model.Group.Goal</p>
          }
        </div>
        <div class="group-hero-stats">
          <div>
            <strong>@(Model.Group.MaxMembers is null ? Model.Group.MemberCount : $"{Model.Group.MemberCount}/{Model.Group.MaxMembers}")</strong>
            <span>@(Model.Group.MaxMembers is null ? "Thành viên · Không giới hạn" : "Thành viên")</span>
          </div>
          <div><strong>@Model.Group.MeetingFormat</strong><span>@(string.IsNullOrWhiteSpace(Model.Group.MeetingSchedule) ? "Chưa đặt lịch" : Model.Group.MeetingSchedule)</span></div>
        </div>
      </div>
    </div>
  </section>

  @if (!Model.Group.IsMember)
  {
    <div class="row g-4">
      <div class="col-lg-8">
        <section class="sh-card p-4 mb-4">
          <h2 class="group-section-title"><i class="bi bi-signpost-split"></i>Trước khi tham gia</h2>
          <p style="font-size:12px;color:var(--sh-slate-600);line-height:1.7;white-space:pre-line;">@(string.IsNullOrWhiteSpace(Model.Group.Rules) ? "Nhóm chưa công bố nội quy riêng. Hãy trao đổi tôn trọng và tập trung vào mục tiêu học tập." : Model.Group.Rules)</p>
        </section>
      </div>
      <div class="col-lg-4">
        <section class="sh-card p-4 text-center">
          @if (Model.Group.MembershipStatus == "Pending")
          {
            <i class="bi bi-hourglass-split d-block mb-2" style="font-size:32px;color:var(--sh-amber-500);"></i>
            <h2 class="fw-bold" style="font-size:15px;">Đang chờ duyệt</h2>
            <p style="font-size:11px;color:var(--sh-slate-500);">Bạn sẽ truy cập được nội dung nhóm sau khi Owner hoặc Moderator chấp nhận.</p>
            <button id="withdraw-request-btn" type="button" class="btn-secondary-sh w-100 justify-content-center">Rút yêu cầu</button>
          }
          else if (Model.Group.MembershipStatus == "Banned")
          {
            <i class="bi bi-slash-circle d-block mb-2" style="font-size:32px;color:var(--sh-rose-600);"></i>
            <h2 class="fw-bold" style="font-size:15px;">Bạn đã bị cấm khỏi nhóm</h2>
            <p style="font-size:11px;color:var(--sh-slate-500);">Bạn cần được người đã cấm gỡ cấm trước khi có thể xin vào hoặc tham gia nhóm.</p>
            @if (Model.Group.HasPendingUnbanRequest)
            {
              <p class="mb-0" style="font-size:11px;">Yêu cầu gỡ cấm đang chờ xử lý.</p>
            }
            else
            {
              <button id="request-unban-btn" type="button" class="btn-primary-sh w-100 justify-content-center">Xin gỡ cấm</button>
            }
          }
          else if (Model.Group.JoinMode == "InviteOnly")
          {
            <i class="bi bi-lock-fill d-block mb-2" style="font-size:32px;color:var(--sh-indigo-600);"></i>
            <h2 class="fw-bold" style="font-size:15px;">Nhóm chỉ qua lời mời</h2>
            <p class="mb-0" style="font-size:11px;color:var(--sh-slate-500);">Bạn cần link hoặc mã mời do người quản lý nhóm cung cấp.</p>
          }
          else
          {
            <i class="bi bi-people d-block mb-2" style="font-size:32px;color:var(--sh-indigo-600);"></i>
            <h2 class="fw-bold" style="font-size:15px;">Tham gia không gian học tập</h2>
            <p style="font-size:11px;color:var(--sh-slate-500);">@(Model.Group.JoinMode == "Open" ? "Bạn sẽ vào nhóm ngay." : "Yêu cầu sẽ được gửi tới người quản lý nhóm.")</p>
            <button id="join-group-btn" type="button" class="btn-primary-sh w-100 justify-content-center">@(Model.Group.JoinMode == "Open" ? "Tham gia ngay" : "Gửi yêu cầu")</button>
          }
        </section>
      </div>
    </div>
  }
  else
  {
    <div class="group-workspace sh-card overflow-hidden">
      <nav class="group-channel-nav" aria-label="Khu vực nhóm">
        <button type="button" class="active" data-panel="overview"><i class="bi bi-house-door"></i>Tổng quan</button>
        <button type="button" data-panel="announcements"><i class="bi bi-megaphone"></i>Thông báo <span>@Model.Group.Announcements.Count</span></button>
        <button type="button" data-panel="chat"><i class="bi bi-chat-dots"></i>Chat nhóm</button>
        <button type="button" data-panel="resources"><i class="bi bi-folder2-open"></i>Tài nguyên <span>@Model.Group.Resources.Count</span></button>
        <button type="button" data-panel="members"><i class="bi bi-people"></i>Thành viên <span>@Model.Group.MemberCount@if (pendingMemberCount > 0){<text> + @pendingMemberCount chờ</text>}</span></button>
      </nav>

      <div class="group-panel-area">
        <section class="group-panel active" data-panel-content="overview">
          <h2 class="group-section-title"><i class="bi bi-compass"></i>Tổng quan nhóm</h2>
          <div class="row g-3">
            <div class="col-md-6"><div class="group-info-tile"><i class="bi bi-camera-video"></i><div><span>Hình thức</span><strong>@Model.Group.MeetingFormat</strong></div></div></div>
            <div class="col-md-6"><div class="group-info-tile"><i class="bi bi-calendar3"></i><div><span>Lịch học</span><strong>@(string.IsNullOrWhiteSpace(Model.Group.MeetingSchedule) ? "Chưa cập nhật" : Model.Group.MeetingSchedule)</strong></div></div></div>
          </div>
          <div class="mt-4">
            <h3 class="fw-bold" style="font-size:13px;">Nội quy</h3>
            <p style="font-size:12px;color:var(--sh-slate-600);line-height:1.7;white-space:pre-line;">@(string.IsNullOrWhiteSpace(Model.Group.Rules) ? "Tôn trọng thành viên và tập trung vào nội dung học tập." : Model.Group.Rules)</p>
          </div>
        </section>

        <section class="group-panel" data-panel-content="announcements" hidden>
          <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
            <h2 class="group-section-title mb-0"><i class="bi bi-megaphone"></i>Thông báo</h2>
          </div>
          @if (Model.Group.CanManage)
          {
            <form id="announcement-form" class="group-compose mb-4">
              <textarea id="announcement-content" maxlength="4000" rows="3" placeholder="Đăng lịch học, mục tiêu hoặc thông tin quan trọng..."></textarea>
              <div class="d-flex align-items-center justify-content-between gap-2 mt-2">
                <label style="font-size:11px;color:var(--sh-slate-600);"><input id="announcement-pinned" type="checkbox" class="form-check-input me-1" />Ghim thông báo</label>
                <button type="submit" class="btn-primary-sh"><i class="bi bi-send"></i>Đăng</button>
              </div>
            </form>
          }
          <div id="announcement-list" class="d-grid gap-3">
            @foreach (var post in Model.Group.Announcements)
            {
              <article class="group-announcement @(post.IsPinned ? "pinned" : "")">
                <div class="d-flex align-items-center gap-2 mb-2">
                  @if (!string.IsNullOrWhiteSpace(post.AuthorAvatarUrl)) { <img src="@post.AuthorAvatarUrl" alt="" referrerpolicy="no-referrer" /> }
                  else { <span class="group-avatar">@Initial(post.AuthorName)</span> }
                  <div><strong>@post.AuthorName</strong><time datetime="@post.SentAt.ToString("O")">@post.SentAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div>
                  @if (post.IsPinned) { <span class="badge text-bg-warning ms-auto"><i class="bi bi-pin-angle-fill"></i> Đã ghim</span> }
                </div>
                <p>@post.Content</p>
              </article>
            }
            @if (Model.Group.Announcements.Count == 0) { <div class="group-empty-state"><i class="bi bi-megaphone"></i><p>Chưa có thông báo nào.</p></div> }
          </div>
        </section>

        <section class="group-panel group-chat-channel" data-panel-content="chat" hidden>
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="group-section-title mb-0"><i class="bi bi-hash"></i>chat-nhom</h2>
            <span id="chat-connection-status" class="group-connection-status">Đang kết nối...</span>
          </div>
          <div id="group-chat-messages" class="group-channel-messages" aria-live="polite">
            @foreach (var message in Model.Group.Messages)
            {
              <div class="group-channel-message @(message.Mine ? "mine" : "")" data-message-id="@message.Id">
                @if (!string.IsNullOrWhiteSpace(message.AuthorAvatarUrl)) { <img src="@message.AuthorAvatarUrl" alt="" referrerpolicy="no-referrer" /> }
                else { <span class="group-avatar">@Initial(message.AuthorName)</span> }
                <div><div><strong>@message.AuthorName</strong><time datetime="@message.SentAt.ToString("O")">@message.SentAt.ToLocalTime().ToString("dd/MM HH:mm")</time></div><p>@message.Content</p></div>
              </div>
            }
            @if (Model.Group.Messages.Count == 0) { <div id="chat-empty-state" class="group-empty-state"><i class="bi bi-chat-dots"></i><p>Chưa có tin nhắn. Hãy bắt đầu cuộc trò chuyện.</p></div> }
          </div>
          <form id="group-chat-form" class="group-channel-compose">
            <textarea id="group-chat-input" maxlength="1000" rows="1" placeholder="Nhắn vào #chat-nhom"></textarea>
            <button type="submit" aria-label="Gửi"><i class="bi bi-send-fill"></i></button>
          </form>
        </section>

        <section class="group-panel" data-panel-content="resources" hidden>
          <h2 class="group-section-title"><i class="bi bi-folder2-open"></i>Tài nguyên nhóm</h2>
          <div class="row g-3">
            @foreach (var resource in Model.Group.Resources)
            {
              <div class="col-md-6">
                <a href="@(resource.Url ?? "#")" class="group-resource-card @(resource.Url is null ? "disabled" : "")">
                  <i class="bi @(resource.ResourceType == "Note" ? "bi-journal-text" : resource.ResourceType == "Flashcard" ? "bi-layers" : "bi-file-earmark-text")"></i>
                  <div><strong>@resource.Title</strong><span>@resource.ResourceType</span></div>
                </a>
              </div>
            }
          </div>
          @if (Model.Group.Resources.Count == 0) { <div class="group-empty-state"><i class="bi bi-folder2-open"></i><p>Chưa có ghi chú, tài liệu hoặc flashcard được chia sẻ cho nhóm.</p></div> }
        </section>

        <section class="group-panel" data-panel-content="members" hidden>
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <h2 class="group-section-title mb-0"><i class="bi bi-people"></i>Thành viên</h2>
            @if (Model.Group.CanManage)
            {
              <button id="create-invite-btn" type="button" class="btn-primary-sh"><i class="bi bi-person-plus"></i>Tạo lời mời</button>
            }
          </div>
          <div id="invite-result" class="alert alert-primary" hidden>
            <label class="sh-label" for="invite-result-url">Liên kết mời</label>
            <div class="input-group"><input id="invite-result-url" class="form-control" readonly /><button id="copy-invite-btn" class="btn btn-outline-primary" type="button">Sao chép</button></div>
            <small id="invite-result-meta"></small>
          </div>
          <div class="group-member-list">
            @foreach (var member in Model.Group.Members.OrderBy(member => member.Status == "Pending"))
            {
              <article class="group-member-row" data-member-id="@member.UserId">
                @if (!string.IsNullOrWhiteSpace(member.AvatarUrl)) { <img src="@member.AvatarUrl" alt="" referrerpolicy="no-referrer" /> }
                else { <span class="group-avatar">@Initial(member.DisplayName)</span> }
                <div class="flex-grow-1"><strong>@member.DisplayName</strong><span>@(member.Status == "Pending" ? "Đang chờ duyệt" : member.Status == "Banned" ? "Đang xin gỡ cấm" : member.Role)</span></div>
                @if (Model.Group.CanManage && member.Status == "Pending")
                {
                  <div class="d-flex gap-1"><button type="button" class="member-action btn-primary-sh" data-action="approve">Duyệt</button><button type="button" class="member-action btn-secondary-sh" data-action="reject">Từ chối</button></div>
                }
                else if (Model.Group.CanManage && member.Status == "Banned" && member.HasPendingUnbanRequest &&
                    (member.BannedByUserId == Model.Group.Members.FirstOrDefault(m => m.IsCurrentUser)?.UserId || member.BannedByUserId == null && Model.Group.IsOwner))
                {
                  <button type="button" class="member-action btn-primary-sh" data-action="unban">Gỡ cấm</button>
                }
                else if (Model.Group.CanManage && !member.IsCurrentUser && member.Role != "Owner" && (Model.Group.IsOwner || member.Role != "Moderator"))
                {
                  <div class="dropdown">
                    <button class="btn-icon-sh" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      @if (Model.Group.IsOwner) { <li><button class="dropdown-item member-action" data-action="@(member.Role == "Moderator" ? "demote" : "promote")">@(member.Role == "Moderator" ? "Hạ xuống thành viên" : "Đặt làm Moderator")</button></li> }
                      <li><button class="dropdown-item member-action" data-action="kick">Mời ra khỏi nhóm</button></li>
                      <li><button class="dropdown-item member-action text-danger" data-action="ban">Cấm khỏi nhóm</button></li>
                    </ul>
                  </div>
                }
              </article>
            }
          </div>
        </section>
      </div>
    </div>
  }
</div>

@if (Model.Group.IsOwner)
{
  <div class="modal fade" id="editGroupModal" tabindex="-1" aria-labelledby="editGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
      <div class="modal-content border-0 shadow rounded-4">
        <div class="modal-header px-4 py-3">
          <div>
            <h5 class="modal-title fw-bold" id="editGroupModalLabel">Chỉnh sửa nhóm học tập</h5>
            <p class="mb-0" style="font-size:11px;color:var(--sh-slate-500);">Cập nhật thông tin, môn học và cách thành viên tham gia nhóm.</p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body px-4 py-4">
          <div class="row g-3">
            <div class="col-12">
              <label class="sh-label" for="edit-group-name">Tên nhóm <span class="text-danger">*</span></label>
              <input id="edit-group-name" class="sh-input" maxlength="150" value="@Model.Group.Name" />
            </div>
            <div class="col-12">
              <label class="sh-label" for="edit-group-subject-toggle">Môn học <span class="text-danger">*</span></label>
              <div id="edit-group-subject-select" class="subject-multiselect">
                <button id="edit-group-subject-toggle" type="button" class="subject-multiselect-toggle"
                        data-subject-toggle aria-expanded="false" aria-controls="edit-group-subject-panel">
                  <span data-subject-summary>Chọn môn học</span>
                  <i class="bi bi-chevron-down"></i>
                </button>
                <div id="edit-group-subject-panel" class="subject-multiselect-panel" data-subject-panel hidden>
                  <div class="subject-multiselect-search">
                    <i class="bi bi-search"></i>
                    <input type="text" maxlength="150" data-subject-search
                           placeholder="Tìm hoặc nhập môn học mới..." autocomplete="off" />
                  </div>
                  <div class="group-subject-picker" data-subject-options aria-live="polite">
                    @foreach (var subject in Model.Group.Subjects)
                    {
                      <label class="group-subject-option" data-subject-initial data-subject-custom="@subject.IsCustom.ToString().ToLowerInvariant()">
                        <input type="checkbox" value="@subject.Name" checked />
                        <span>@subject.Name</span>
                      </label>
                    }
                  </div>
                  <p class="subject-multiselect-hint" data-subject-hint>Nhập tên môn rồi nhấn Enter để thêm môn mới.</p>
                </div>
              </div>
              <p class="mb-0 mt-2" style="font-size:10px;color:var(--sh-slate-500);">Tích các môn có sẵn hoặc tìm và nhấn Enter để thêm môn mới. Tối đa 10 môn.</p>
            </div>
            <div class="col-12">
              <label class="sh-label" for="edit-group-desc">Mô tả</label>
              <textarea id="edit-group-desc" class="sh-input" rows="2" maxlength="2000">@Model.Group.Description</textarea>
            </div>
            <div class="col-12">
              <label class="sh-label" for="edit-group-goal">Mục tiêu</label>
              <input id="edit-group-goal" class="sh-input" maxlength="500" value="@Model.Group.Goal" />
            </div>
            <div class="col-md-4">
              <label class="sh-label" for="edit-group-format">Hình thức</label>
              <select id="edit-group-format" class="sh-input" data-current-value="@Model.Group.MeetingFormat">
                <option value="Online">Online</option>
                <option value="Offline">Offline</option>
                <option value="Hybrid">Kết hợp</option>
              </select>
            </div>
            <div class="col-md-5">
              <label class="sh-label" for="edit-group-schedule">Lịch dự kiến</label>
              <input id="edit-group-schedule" class="sh-input" maxlength="250" value="@Model.Group.MeetingSchedule" />
            </div>
            <div class="col-md-3">
              <label class="sh-label" for="edit-group-max-members">Giới hạn người</label>
              <input id="edit-group-max-members" class="sh-input" type="number" min="@(Math.Max(2, Model.Group.MemberCount))" max="500"
                     value="@(Model.Group.MaxMembers?.ToString() ?? string.Empty)" placeholder="Không giới hạn" />
              <small class="d-block mt-1" style="font-size:9px;color:var(--sh-slate-500);">Xóa giá trị để chuyển nhóm sang không giới hạn.</small>
            </div>
            <div class="col-12">
              <label class="sh-label" for="edit-group-access">Cách tham gia</label>
              <select id="edit-group-access" class="sh-input" data-current-value="@Model.Group.JoinMode">
                <option value="Approval">Công khai · Cần duyệt</option>
                <option value="Open">Công khai · Vào ngay</option>
                <option value="InviteOnly">Riêng tư · Chỉ qua lời mời</option>
              </select>
            </div>
            <div class="col-12">
              <label class="sh-label" for="edit-group-rules">Nội quy nhóm</label>
              <textarea id="edit-group-rules" class="sh-input" rows="3" maxlength="2000">@Model.Group.Rules</textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer px-4 py-3">
          <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
          <button id="save-group-changes-btn" type="button" class="btn-primary-sh"><i class="bi bi-check-lg"></i>Lưu thay đổi</button>
        </div>
      </div>
    </div>
  </div>
}

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@9.0.6/dist/browser/signalr.min.js"></script>
  <script src="~/js/subject-multiselect.js" asp-append-version="true"></script>
