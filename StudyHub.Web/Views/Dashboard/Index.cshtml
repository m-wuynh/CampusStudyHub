@model StudyHub.Web.ViewModels.Dashboard.DashboardIndexViewModel
@{
    ViewData["Title"]        = "Tổng quan - Study Hub";
    ViewData["PageTitle"]    = "Bảng điều khiển học tập";
    ViewData["PageSubtitle"] = "Tổng hợp tiến độ &amp; hoạt động học tập";

    string EventTypeLabel(string? type) => type switch
    {
        "Exam" => "Kiểm tra",
        "Class" => "Lịch học",
        "Other" => "Bài tập",
        _ => "Tự học"
    };
    string EventTypePill(string? type) => type switch
    {
        "Exam" => "is-rose",
        "Class" => "is-emerald",
        "Other" => "is-amber",
        _ => ""
    };

    int weeklyTotal = Model.WeeklyTotalEvents;
    int weeklyCompleted = Model.WeeklyCompletedEvents;
    int weeklyMissed = Model.WeeklyMissedEvents;
    int weeklyPct = weeklyTotal == 0 ? 0 : (weeklyCompleted * 100) / weeklyTotal;
}

<link rel="stylesheet" href="~/css/violet-theme.css" asp-append-version="true" />

<div id="dashboard-view" class="pb-5" style="max-width:1280px; margin:0 auto;">

  <!-- ── 1. Welcome Hero ── -->
  <div id="dashboard-welcome-card" class="welcome-hero sv-hero mb-4">
    <div class="position-relative" style="z-index:2; max-width:640px;">
      <div class="sv-hero-eyebrow">@Model.FormattedDateText</div>
      <h2 class="sv-hero-title">@Model.TimeGreeting</h2>
      <p class="sv-hero-text">
        @if (Model.TodayTasksCount > 0)
        {
          <span>Hôm nay bạn có <strong>@Model.TodayTasksCount lịch học / nhiệm vụ</strong>.</span>
        }
        else
        {
          <span>Chào mừng bạn quay lại! Hãy theo dõi tiến độ và kế hoạch học tập hôm nay.</span>
        }
        @if (Model.NextEvent != null)
        {
          <span> Sự kiện sắp tới: <strong>@Model.NextEvent.Title</strong> vào @Model.NextEvent.DateText.</span>
        }
      </p>
      <a asp-controller="Calendar" asp-action="Index" class="sv-hero-btn">
        Xem lịch học
        <span class="sv-hero-btn-icon"><i class="bi bi-arrow-right"></i></span>
      </a>
    </div>
    <div class="sv-hero-stars d-none d-sm-block" aria-hidden="true">
      <svg viewBox="0 0 100 100" style="width:150px; right:12%; top:14%;"><path d="M50 0 C55 38 62 45 100 50 C62 55 55 62 50 100 C45 62 38 55 0 50 C38 45 45 38 50 0Z"/></svg>
      <svg viewBox="0 0 100 100" style="width:84px; right:2%; top:-6%;"><path d="M50 0 C55 38 62 45 100 50 C62 55 55 62 50 100 C45 62 38 55 0 50 C38 45 45 38 50 0Z"/></svg>
      <svg viewBox="0 0 100 100" style="width:70px; right:30%; bottom:-10%;"><path d="M50 0 C55 38 62 45 100 50 C62 55 55 62 50 100 C45 62 38 55 0 50 C38 45 45 38 50 0Z"/></svg>
      <svg viewBox="0 0 100 100" style="width:96px; right:-2%; bottom:4%;"><path d="M50 0 C55 38 62 45 100 50 C62 55 55 62 50 100 C45 62 38 55 0 50 C38 45 45 38 50 0Z"/></svg>
    </div>
  </div>

  <!-- ── 2. Stats (4 thẻ) ── -->
  <div id="dashboard-overview-stats" class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="sv-stat">
        <span class="sv-stat-icon"><i class="bi bi-calendar3"></i></span>
        <div class="sv-stat-body">
          <p class="sv-stat-label">Nhiệm vụ hôm nay</p>
          <p class="sv-stat-value">@Model.TodayTasksCount lịch học / bài tập</p>
          <p class="sv-stat-sub">@(Model.TodayTasksCount > 0 ? $"Đã xong {Model.TodayCompletedTasksCount}/{Model.TodayTasksCount}" : "Chưa có lịch hôm nay")</p>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="sv-stat">
        <span class="sv-stat-icon"><i class="bi bi-alarm"></i></span>
        <div class="sv-stat-body">
          <p class="sv-stat-label">Sự kiện sắp diễn ra</p>
          <p class="sv-stat-value truncate" title="@(Model.NextEvent?.Title ?? "Chưa có sự kiện")">@(Model.NextEvent?.Title ?? "Chưa có sự kiện")</p>
          @if (Model.NextEvent != null)
          {
            var nextWhen = Model.NextEvent.DaysLeftText switch
            {
              0 => $"Hôm nay, {Model.NextEvent.TimeText}",
              1 => $"Ngày mai, {Model.NextEvent.TimeText}",
              int d => $"Còn {d} ngày ({Model.NextEvent.TimeText})",
              _ => Model.NextEvent.DateText
            };
            var moreCount = Model.UpcomingEvents.Count - 1;
            <p class="sv-stat-sub truncate">@(nextWhen + (moreCount > 0 ? $" · +{moreCount} sự kiện khác" : ""))</p>
          }
          else
          {
            <p class="sv-stat-sub">Không có sự kiện trong 7 ngày tới</p>
          }
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="sv-stat">
        <span class="sv-stat-icon"><i class="bi bi-layers"></i></span>
        <div class="sv-stat-body">
          <p class="sv-stat-label">Thẻ Flashcard</p>
          <p class="sv-stat-value">@Model.FlashcardSummary.TotalCards thẻ (@Model.FlashcardSummary.TotalDecks bộ)</p>
          <p class="sv-stat-sub">Sẵn sàng ôn tập</p>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="sv-stat">
        <span class="sv-stat-icon"><i class="bi bi-graph-up-arrow"></i></span>
        <div class="sv-stat-body">
          <p class="sv-stat-label">ĐTB hiện tại</p>
          <p class="sv-stat-value is-big">@(Model.CurrentAverage10?.ToString("0.0") ?? "—")<span style="font-size:12px; color:var(--sh-slate-400); font-weight:500;"> / 10</span></p>
          @if (!Model.CurrentAverage10.HasValue)
          {
            <p class="sv-stat-sub">Chưa có điểm</p>
          }
        </div>
      </div>
    </div>
  </div>

  <!-- ── 3. Hiệu suất tuần ── -->
  <div class="mb-4">
    <div class="sv-section-head">
      <div>
        <h3 class="sv-section-title">Hiệu suất học tập tuần này</h3>
        <p class="sv-section-sub">Từ Thứ 2 đến Chủ Nhật</p>
      </div>
    </div>
    <div class="row g-3">
      <div class="col-12 col-md-6">
        <div class="sv-stat">
          <span class="sv-stat-icon is-emerald"><i class="bi bi-check-circle-fill"></i></span>
          <div class="sv-stat-body">
            <p class="sv-stat-label">Ca đã hoàn thành</p>
            <p class="sv-stat-value is-big">@weeklyCompleted<span style="font-size:12px; color:var(--sh-slate-400); font-weight:500;"> / @weeklyTotal ca</span></p>
            <div class="d-flex align-items-center gap-2 mt-2">
              <div class="sv-progress flex-grow-1"><span class="is-emerald" style="width:@weeklyPct%;"></span></div>
              <span style="font-size:11px; font-weight:700; color:var(--sh-emerald-600);">@weeklyPct%</span>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6">
        <div class="sv-stat">
          <span class="sv-stat-icon is-rose"><i class="bi bi-exclamation-triangle-fill"></i></span>
          <div class="sv-stat-body">
            <p class="sv-stat-label">Ca học bị bỏ lỡ</p>
            <p class="sv-stat-value is-big" style="color:var(--sh-rose-600);">@weeklyMissed<span style="font-size:12px; color:var(--sh-slate-400); font-weight:500;"> ca học</span></p>
            <p class="sv-stat-sub">Quá thời gian</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 4. Mục tiêu học tập + Lịch hôm nay ── -->
  <div class="row g-4 mb-4">
    <!-- Mục tiêu học tập -->
    <div class="col-12 col-lg-6 d-flex flex-column">
      <div class="sv-section-head">
        <h3 class="sv-section-title">Mục tiêu học tập</h3>
        <a asp-controller="Grades" asp-action="Index" class="sv-link">Xem chi tiết</a>
      </div>
      <div class="sh-card p-4 flex-grow-1 d-flex flex-column">
        @if (Model.ActiveGoalSummary != null)
        {
          <div class="d-flex justify-content-between align-items-end">
            <div>
              <p class="sv-stat-label">ĐTB hiện tại</p>
              <div class="fw-bold" style="font-size:26px; line-height:1.1; color:var(--sv-ink);">
                @(Model.ActiveGoalSummary.CurrentAverage10?.ToString("0.0") ?? "—")
              </div>
            </div>
            <div class="text-end">
              <p class="sv-stat-label">Mục tiêu trung bình</p>
              <div class="fw-bold" style="font-size:26px; line-height:1.1; color:var(--sv-600);">
                @Model.ActiveGoalSummary.TargetAverage.ToString("0.0")
              </div>
            </div>
          </div>
          <div class="mt-3">
            <div class="d-flex justify-content-between mb-1" style="font-size:11px; color:var(--sh-slate-500);">
              <span>Tiến trình hoàn thành</span>
              <span class="fw-bold" style="color:var(--sv-600);">@Model.ActiveGoalSummary.ProgressPercent%</span>
            </div>
            <div class="sv-progress"><span style="width:@Model.ActiveGoalSummary.ProgressPercent%;"></span></div>
          </div>

          @if (Model.ActiveGoalSummary.Goals.Any())
          {
            <div class="mt-4 flex-grow-1">
              @foreach (var g in Model.ActiveGoalSummary.Goals)
              {
                <div class="sv-row d-block">
                  <div class="d-flex justify-content-between align-items-center gap-2">
                    <span class="fw-semibold truncate" style="font-size:13px; color:var(--sh-slate-800);">@g.SubjectName</span>
                    <span class="sv-pill">@(g.CurrentValue?.ToString("0.0") ?? "—") / @g.TargetValue.ToString("0.0")</span>
                  </div>
                  <div class="sv-progress mt-2"><span style="width:@g.ProgressPercent%;"></span></div>
                </div>
              }
            </div>
          }

          <a asp-controller="Grades" asp-action="Index" class="btn-secondary-sh w-100 justify-content-center mt-4">
            Quản lý điểm &amp; mục tiêu
          </a>
        }
        else
        {
          <div class="my-auto text-center py-5">
            <div style="font-size:42px; margin-bottom:12px;">🎯</div>
            <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Hiện tại bạn chưa có mục tiêu học tập.</h4>
            <p class="text-muted mb-3" style="font-size:12px;">Đặt mục tiêu để theo dõi tiến độ học tập của bạn.</p>
            <a asp-controller="Grades" asp-action="Index" class="btn-primary-sh d-inline-flex justify-content-center">
              Đặt mục tiêu
            </a>
          </div>
        }
      </div>
    </div>

    <!-- Lịch học cá nhân hôm nay -->
    <div class="col-12 col-lg-6 d-flex flex-column">
      <div class="sv-section-head">
        <h3 class="sv-section-title">Lịch học hôm nay</h3>
        <a asp-controller="Calendar" asp-action="Index" class="sv-link">Xem thời khóa biểu</a>
      </div>
      <div class="sh-card p-4 flex-grow-1 d-flex flex-column">
        @if (Model.TodaySchedule.Any())
        {
          <div class="flex-grow-1">
            @foreach (var ev in Model.TodaySchedule)
            {
              <div class="sv-row">
                <span class="sv-time-chip">@ev.StartAtLocal.ToString("HH:mm")</span>
                <div class="flex-grow-1 overflow-hidden">
                  <h4 class="mb-0 fw-semibold truncate" style="font-size:13px; color:var(--sv-ink);" title="@ev.Title">@ev.Title</h4>
                  @if (!string.IsNullOrWhiteSpace(ev.Description))
                  {
                    <p class="mb-0 truncate" style="font-size:11px; color:var(--sh-slate-500);">@ev.Description</p>
                  }
                </div>
                <span class="sv-pill @EventTypePill(ev.EventType)">@EventTypeLabel(ev.EventType)</span>
              </div>
            }
          </div>
          <a asp-controller="Calendar" asp-action="Index" class="btn-secondary-sh w-100 justify-content-center mt-4">
            Thêm lịch học
          </a>
        }
        else
        {
          <div class="my-auto text-center py-5">
            <div style="font-size:42px; margin-bottom:12px;">📅</div>
            <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Hiện tại chưa có lịch học nào.</h4>
            <p class="text-muted mb-3" style="font-size:12px;">Hãy tạo lịch học để quản lý thời gian học tập hiệu quả hơn.</p>
            <a asp-controller="Calendar" asp-action="Index" class="btn-primary-sh d-inline-flex justify-content-center">
              Thêm lịch học
            </a>
          </div>
        }
      </div>
    </div>
  </div>

  <!-- ── 5. Bộ thẻ Flashcard (lưới thẻ) ── -->
  <div class="mb-4">
    <div class="sv-section-head">
      <div>
        <h3 class="sv-section-title">Thẻ ghi nhớ (Flashcard)</h3>
        <p class="sv-section-sub">Ôn tập ghi nhớ nhanh chóng</p>
      </div>
      <a asp-controller="Flashcards" asp-action="Index" class="sv-link">Kho thẻ (@Model.FlashcardSummary.TotalDecks)</a>
    </div>

    @if (Model.FlashcardSummary.TotalDecks > 0)
    {
      var deckIndex = 0;
      <div class="row g-3">
        @foreach (var deck in Model.FlashcardSummary.Decks)
        {
          deckIndex++;
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="sv-media-card">
              <div class="sv-media-thumb t@(((deckIndex - 1) % 3) + 1)"><i class="bi bi-layers"></i></div>
              <div class="sv-media-body">
                <div><span class="sv-pill">Bộ thẻ</span></div>
                <h4 class="sv-media-title line-clamp-2" title="@deck.Title">@deck.Title</h4>
                @if (!string.IsNullOrWhiteSpace(deck.Description))
                {
                  <p class="sv-media-desc truncate" title="@deck.Description">@deck.Description</p>
                }
                <div class="sv-media-foot">
                  <span><i class="bi bi-clock me-1"></i>Cập nhật @StudyHub.BLL.Constants.GradeClock.ToLocal(deck.UpdatedAtUtc).ToString("dd/MM/yyyy")</span>
                  <a asp-controller="Flashcards" asp-action="Details" asp-route-deckId="@deck.DeckId" class="sv-action-pill">Học ngay</a>
                </div>
              </div>
            </div>
          </div>
        }
      </div>
    }
    else
    {
      <div class="sh-card text-center py-5 px-3">
        <div style="font-size:42px; margin-bottom:12px;">🎴</div>
        <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Hiện tại chưa có Flashcard nào.</h4>
        <p class="text-muted mb-3" style="font-size:12px;">Tạo Flashcard để bắt đầu ôn tập.</p>
        <a asp-controller="Flashcards" asp-action="Index" class="btn-primary-sh d-inline-flex justify-content-center">
          Tạo Flashcard
        </a>
      </div>
    }
  </div>

  <!-- ── 6. Ghi chú gần đây (NotesV3) – dạng bảng ── -->
  <div>
    <div class="sv-section-head">
      <div>
        <h3 class="sv-section-title">Ghi chú gần đây</h3>
        <p class="sv-section-sub">Các trang ghi chú mới nhất trong sổ tay của bạn</p>
      </div>
      <a asp-controller="NotesV3" asp-action="Index" class="sv-link">Xem tất cả</a>
    </div>

    <div id="dashboard-recent-notes" class="sh-card overflow-hidden">
      @if (Model.RecentNotes is { Count: > 0 } recentNotes)
      {
        <div class="table-responsive">
          <table class="sv-table">
            <thead>
              <tr>
                <th>Tiêu đề</th>
                <th class="d-none d-md-table-cell">Tóm tắt</th>
                <th>Sổ tay</th>
                <th class="text-end">Thao tác</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var note in recentNotes)
              {
                <tr>
                  <td style="max-width:260px;">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                      <span class="sv-stat-icon" style="width:32px; height:32px; min-width:32px; font-size:14px;"><i class="bi bi-journal-text"></i></span>
                      <span class="fw-semibold truncate" title="@note.Title">@note.Title</span>
                    </div>
                  </td>
                  <td class="d-none d-md-table-cell" style="max-width:360px;">
                    <span class="truncate d-block" style="font-size:12px; color:var(--sh-slate-500);" title="@note.Summary">
                      @(string.IsNullOrEmpty(note.Summary) ? "Trang chưa có nội dung." : note.Summary)
                    </span>
                  </td>
                  <td style="max-width:180px;">
                    <span class="sv-pill is-neutral d-inline-block truncate" style="max-width:100%; text-transform:none; letter-spacing:0;" title="@note.NotebookTitle">@note.NotebookTitle</span>
                  </td>
                  <td class="text-end">
                    <a asp-controller="Notebooks" asp-action="Notebook"
                       asp-route-id="@note.NotebookId" asp-route-sectionId="@note.SectionId" asp-route-pageId="@note.PageId"
                       class="sv-action-pill">Mở</a>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
      else if (!Model.NotesAvailable)
      {
        <div class="text-center py-5 px-3">
          <div style="font-size:42px; margin-bottom:12px;">📒</div>
          <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Chưa tải được ghi chú.</h4>
          <p class="text-muted mb-0" style="font-size:12px;">Mô-đun ghi chú hiện chưa sẵn sàng. Vui lòng thử lại sau.</p>
        </div>
      }
      else
      {
        <div class="text-center py-5 px-3">
          <div style="font-size:42px; margin-bottom:12px;">📝</div>
          <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Hiện tại chưa có ghi chú nào.</h4>
          <p class="text-muted mb-3" style="font-size:12px;">Tạo sổ tay và trang ghi chú đầu tiên của bạn.</p>
          <a asp-controller="NotesV3" asp-action="Index" class="btn-primary-sh d-inline-flex justify-content-center">
            Mở Ghi chú
          </a>
        </div>
      }
    </div>
  </div>
</div>
