@model StudyHub.Web.ViewModels.Dashboard.DashboardIndexViewModel
@{
    ViewData["Title"]        = "Tổng quan - Study Hub";
    ViewData["PageTitle"]    = "Bảng điều khiển học tập";
    ViewData["PageSubtitle"] = "Tổng hợp tiến độ &amp; hoạt động học tập";
}

<div id="dashboard-view" class="pb-5" style="max-width:1280px; margin:0 auto;">

  <!-- ── 1. Welcome Hero ── -->
  <div id="dashboard-welcome-card" class="welcome-hero mb-4">
    <div class="position-relative" style="z-index:2; max-width:680px;">
      <div class="welcome-pill">
        <span>📅 @Model.FormattedDateText</span>
      </div>
      <h2 class="fw-black tracking-tight mb-2" style="font-size:clamp(20px,3vw,28px);">
        @Model.TimeGreeting
      </h2>
      <p class="mb-0" style="font-size:13px; color:rgba(255,255,255,0.85); line-height:1.7;">
        @if (Model.TodayTasksCount > 0)
        {
          <span>Hôm nay bạn có <strong style="text-decoration:underline; text-decoration-color:#fbbf24;">@Model.TodayTasksCount lịch học / nhiệm vụ</strong>.</span>
        }
        else
        {
          <span>Chào mừng bạn quay lại! Hãy theo dõi tiến độ và kế hoạch học tập hôm nay.</span>
        }
        @if (Model.NextExam != null)
        {
          <span> Sự kiện sắp tới: <strong>@Model.NextExam.Title</strong> vào @Model.NextExam.DateText.</span>
        }
      </p>
    </div>
    <div class="position-absolute end-0 bottom-0 top-0 d-none d-sm-flex align-items-center"
         style="opacity:.08; pointer-events:none; padding-right:16px;">
      <i class="bi bi-mortarboard-fill" style="font-size:160px; color:#fff;"></i>
    </div>
  </div>

  <!-- ── 2. Stats Grid (4 Cards) ── -->
  <div id="dashboard-overview-stats" class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
          <span style="font-size:11px; font-weight:600; color:var(--sh-slate-500);">Nhiệm vụ hôm nay</span>
          <div class="stat-icon-wrap" style="background:var(--sh-blue-50); color:var(--sh-blue-600);">
            <i class="bi bi-calendar3"></i>
          </div>
        </div>
        <div class="d-flex align-items-baseline gap-2 mt-3">
          <span class="fw-black" style="font-size:24px; color:var(--sh-slate-900);">@Model.TodayTasksCount</span>
          <span style="font-size:11px; color:var(--sh-slate-500); font-weight:500;">lịch học / bài tập</span>
        </div>
        <p class="mb-0 mt-1" style="font-size:11px; color:var(--sh-blue-600); font-weight:500;">
          @(Model.TodayTasksCount > 0 ? "Lịch học hôm nay" : "Chưa có lịch hôm nay")
        </p>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
          <span style="font-size:11px; font-weight:600; color:var(--sh-slate-500);">Kỳ thi sắp tới</span>
          <div class="stat-icon-wrap" style="background:var(--sh-rose-50); color:var(--sh-rose-600);">
            <i class="bi bi-alarm"></i>
          </div>
        </div>
        <div class="mt-3">
          <span class="fw-black truncate d-block" style="font-size:16px; color:var(--sh-slate-900);" title="@(Model.NextExam?.Title ?? "Chưa có sự kiện")">
            @(Model.NextExam?.Title ?? "Chưa có sự kiện")
          </span>
        </div>
        <p class="mb-0 mt-1 d-flex align-items-center gap-1" style="font-size:11px; color:var(--sh-rose-600); font-weight:700;">
          @if (Model.NextExam != null)
          {
            <i class="bi bi-clock-history"></i>
            <span>@(Model.NextExam.DaysLeftText.HasValue ? $"Còn {Model.NextExam.DaysLeftText} ngày ({Model.NextExam.TimeText})" : Model.NextExam.DateText)</span>
          }
          else
          {
            <span>Không có lịch thi gần</span>
          }
        </p>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
          <span style="font-size:11px; font-weight:600; color:var(--sh-slate-500);">Thẻ Flashcard</span>
          <div class="stat-icon-wrap" style="background:var(--sh-emerald-50); color:var(--sh-emerald-600);">
            <i class="bi bi-layers"></i>
          </div>
        </div>
        <div class="d-flex align-items-baseline gap-2 mt-3">
          <span class="fw-black" style="font-size:24px; color:var(--sh-emerald-600);">@Model.FlashcardSummary.TotalCards</span>
          <span style="font-size:11px; color:var(--sh-slate-500); font-weight:500;">thẻ (@Model.FlashcardSummary.TotalDecks bộ)</span>
        </div>
        <p class="mb-0 mt-1" style="font-size:11px; color:var(--sh-emerald-600); font-weight:500;">
          Sẵn sàng ôn tập
        </p>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-center">
          <span style="font-size:11px; font-weight:600; color:var(--sh-slate-500);">ĐTB Hiện tại</span>
          <div class="stat-icon-wrap" style="background:var(--sh-indigo-50); color:var(--sh-indigo-600);">
            <i class="bi bi-graph-up-arrow"></i>
          </div>
        </div>
        <div class="d-flex align-items-baseline gap-2 mt-3">
          <span class="fw-black" style="font-size:24px; color:var(--sh-indigo-600);">
            @(Model.CurrentAverage10?.ToString("0.0") ?? "—")
          </span>
          <span style="font-size:12px; color:var(--sh-slate-400); font-weight:500;">/ 10</span>
        </div>
        <p class="mb-0 mt-1" style="font-size:11px; color:var(--sh-emerald-600); font-weight:700;">
          @(Model.CurrentRankText ?? "Chưa có điểm")
        </p>
      </div>
    </div>
  </div>

  <!-- ── 2.5 Weekly Performance Widget ── -->
  @{
      int weeklyTotal = Model.WeeklyTotalEvents;
      int weeklyCompleted = Model.WeeklyCompletedEvents;
      int weeklyMissed = Model.WeeklyMissedEvents;
      int weeklyPct = weeklyTotal == 0 ? 0 : (weeklyCompleted * 100) / weeklyTotal;
  }
  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="mb-0 fw-bold"
          style="font-size:11px; color:var(--sh-slate-500); text-transform:uppercase; letter-spacing:.07em;">
        Hiệu suất học tập tuần này (Thứ 2 - Chủ Nhật)
      </h3>
    </div>
    <div class="row g-3">
      <div class="col-12 col-md-6">
        <div class="stat-card" style="border-left: 4px solid var(--sh-emerald-500);">
          <div class="d-flex justify-content-between align-items-center">
            <span style="font-size:13px; font-weight:600; color:var(--sh-slate-700);">Ca đã hoàn thành</span>
            <div class="stat-icon-wrap" style="background:var(--sh-emerald-50); color:var(--sh-emerald-600);">
              <i class="bi bi-check-circle-fill"></i>
            </div>
          </div>
          <div class="d-flex align-items-baseline gap-2 mt-3">
            <span class="fw-black" style="font-size:28px; color:var(--sh-emerald-600);">@weeklyCompleted</span>
            <span style="font-size:13px; color:var(--sh-slate-500); font-weight:500;">/ @weeklyTotal ca</span>
          </div>
          <div class="d-flex align-items-center gap-2 mt-2">
            <div class="sh-progress flex-grow-1" style="height:6px; background:var(--sh-slate-100);">
              <div class="sh-progress-bar emerald" style="width:@weeklyPct%;"></div>
            </div>
            <span style="font-size:11px; font-weight:bold; color:var(--sh-emerald-600);">@weeklyPct%</span>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6">
        <div class="stat-card" style="border-left: 4px solid var(--sh-rose-500);">
          <div class="d-flex justify-content-between align-items-center">
            <span style="font-size:13px; font-weight:600; color:var(--sh-slate-700);">Ca học bị bỏ lỡ (Missed)</span>
            <div class="stat-icon-wrap" style="background:var(--sh-rose-50); color:var(--sh-rose-600);">
              <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
          </div>
          <div class="d-flex align-items-baseline gap-2 mt-3">
            <span class="fw-black" style="font-size:28px; color:var(--sh-rose-600);">@weeklyMissed</span>
            <span style="font-size:13px; color:var(--sh-slate-500); font-weight:500;">ca học</span>
          </div>
          <p class="mb-0 mt-2" style="font-size:12px; color:var(--sh-rose-600); font-weight:500;">
            Quá thời gian nhưng chưa được tick hoàn thành
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- ── 3. Quick Actions ── -->
  <div id="dashboard-quick-actions" class="sh-card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="mb-0 fw-bold"
          style="font-size:11px; color:var(--sh-slate-500); text-transform:uppercase; letter-spacing:.07em;">
        THAO TÁC NHANH
      </h3>
    </div>
    <div class="row g-2">
      <div class="col-6 col-sm-3">
        <a asp-controller="Notes" asp-action="Index" class="quick-action-btn indigo text-decoration-none">
          <i class="bi bi-plus-lg"></i><span>Thêm Ghi chú</span>
        </a>
      </div>
      <div class="col-6 col-sm-3">
        <a asp-controller="Flashcards" asp-action="Index" class="quick-action-btn emerald text-decoration-none">
          <i class="bi bi-plus-lg"></i><span>Tạo Flashcard</span>
        </a>
      </div>
      <div class="col-6 col-sm-3">
        <a asp-controller="Calendar" asp-action="Index" class="quick-action-btn amber text-decoration-none">
          <i class="bi bi-plus-lg"></i><span>Thêm Lịch học</span>
        </a>
      </div>
      <div class="col-6 col-sm-3">
        <a asp-controller="Grades" asp-action="Index" class="quick-action-btn rose text-decoration-none">
          <i class="bi bi-plus-lg"></i><span>Nhập Điểm số</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ── 4. Main Section Grid: Academic Goals + Personal Schedule ── -->
  <div class="row g-4 mb-4">
    <!-- Academic Goals (Mục tiêu học tập) -->
    <div class="col-12 col-lg-6">
      <div class="sh-card p-4 p-sm-5 h-100 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center pb-3"
             style="border-bottom:1px solid var(--sh-slate-100);">
          <h3 class="mb-0 fw-bold" style="font-size:15px;color:var(--sh-slate-900);">Mục tiêu học tập</h3>
          <a asp-controller="Grades" asp-action="Index" class="fw-bold text-decoration-none" style="font-size:12px;color:var(--sh-indigo-600);">
            Chi tiết <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        @if (Model.ActiveGoalSummary != null)
        {
          <div class="mt-4 p-3 rounded-3" style="background:var(--sh-slate-50);border:1px solid var(--sh-slate-200);">
            <div class="d-flex justify-content-between">
              <div>
                <span style="font-size:11px;color:var(--sh-slate-500);">ĐTB Hiện tại</span>
                <div class="fw-black" style="font-size:26px;color:var(--sh-slate-900);">
                  @(Model.ActiveGoalSummary.CurrentAverage10?.ToString("0.0") ?? "—")
                </div>
              </div>
              <div class="text-end">
                <span style="font-size:11px;color:var(--sh-slate-500);">Mục tiêu</span>
                <div class="fw-black" style="font-size:26px;color:var(--sh-indigo-600);">
                  @Model.ActiveGoalSummary.TargetAverage.ToString("0.0")
                </div>
              </div>
            </div>
            <div class="mt-3">
              <div class="d-flex justify-content-between mb-1" style="font-size:11px;color:var(--sh-slate-500);">
                <span>Tiến trình hoàn thành</span>
                <span class="fw-bold" style="color:var(--sh-indigo-600);">@Model.ActiveGoalSummary.ProgressPercent%</span>
              </div>
              <div class="sh-progress"><div class="sh-progress-bar indigo" style="width:@Model.ActiveGoalSummary.ProgressPercent%;"></div></div>
            </div>
          </div>

          @if (Model.ActiveGoalSummary.Goals.Any())
          {
            <div class="mt-4 space-y-2 flex-grow-1">
              @foreach (var g in Model.ActiveGoalSummary.Goals)
              {
                <div class="p-2 rounded-3 mb-2" style="border:1px solid var(--sh-slate-100);">
                  <div class="d-flex justify-content-between" style="font-size:11px;">
                    <span class="fw-semibold" style="color:var(--sh-slate-800);">@g.SubjectName</span>
                    <span class="fw-bold font-monospace" style="color:var(--sh-slate-600);">
                      @(g.CurrentValue?.ToString("0.0") ?? "—") / @g.TargetValue.ToString("0.0")
                    </span>
                  </div>
                  <div class="sh-progress mt-2">
                    <div class="sh-progress-bar indigo" style="width:@g.ProgressPercent%;"></div>
                  </div>
                </div>
              }
            </div>
          }

          <a asp-controller="Grades" asp-action="Index" class="btn-secondary-sh w-100 justify-content-center mt-4">
            Quản lý điểm &amp; mục tiêu →
          </a>
        }
        else
        {
          <!-- Empty State Goals -->
          <div class="my-auto text-center py-5">
            <div style="font-size:42px; margin-bottom:12px;">🎯</div>
            <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Hiện tại bạn chưa có mục tiêu học tập.</h4>
            <p class="text-muted mb-3" style="font-size:12px;">Đặt mục tiêu để theo dõi tiến độ học tập của bạn.</p>
            <a asp-controller="Grades" asp-action="Index" class="btn-primary-sh d-inline-flex justify-content-center">
              Đặt mục tiêu →
            </a>
          </div>
        }
      </div>
    </div>

    <!-- Personal Schedule (Lịch học cá nhân hôm nay) -->
    <div class="col-12 col-lg-6">
      <div class="sh-card p-4 p-sm-5 h-100 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center pb-3"
             style="border-bottom:1px solid var(--sh-slate-100);">
          <h3 class="mb-0 fw-bold" style="font-size:15px;color:var(--sh-slate-900);">Lịch học cá nhân hôm nay</h3>
          <a asp-controller="Calendar" asp-action="Index" class="fw-bold text-decoration-none" style="font-size:12px;color:var(--sh-indigo-600);">
            Xem thời khóa biểu <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        @if (Model.TodaySchedule.Any())
        {
          <div class="mt-4 flex-grow-1">
            @foreach (var ev in Model.TodaySchedule)
            {
              <div class="p-3 rounded-3 d-flex align-items-center justify-content-between mb-2"
                   style="background:var(--sh-slate-50);border:1px solid var(--sh-slate-100);">
                <div class="d-flex align-items-center gap-3">
                  <div class="fw-bold text-primary" style="font-size:13px; min-width: 50px;">
                    @ev.StartAtLocal.ToString("HH:mm")
                  </div>
                  <div>
                    <h4 class="mb-0 fw-bold" style="font-size:13px;color:var(--sh-slate-900);">@ev.Title</h4>
                    @if (!string.IsNullOrWhiteSpace(ev.Description))
                    {
                      <p class="mb-0 text-muted" style="font-size:11px;">@ev.Description</p>
                    }
                  </div>
                </div>
                <span class="badge bg-light text-secondary border" style="font-size:10px;">@ev.EventType</span>
              </div>
            }
          </div>
          <a asp-controller="Calendar" asp-action="Index" class="btn-secondary-sh w-100 justify-content-center mt-4">
            Thêm lịch học →
          </a>
        }
        else
        {
          <!-- Empty State Schedule -->
          <div class="my-auto text-center py-5">
            <div style="font-size:42px; margin-bottom:12px;">📅</div>
            <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Hiện tại chưa có lịch học nào.</h4>
            <p class="text-muted mb-3" style="font-size:12px;">Hãy tạo lịch học để quản lý thời gian học tập hiệu quả hơn.</p>
            <a asp-controller="Calendar" asp-action="Index" class="btn-primary-sh d-inline-flex justify-content-center">
              Thêm lịch học →
            </a>
          </div>
        }
      </div>
    </div>
  </div>

  <!-- ── 5. Lower Grid: Upcoming Events + Flashcards ── -->
  <div class="row g-4">
    <!-- Upcoming Events (Sắp diễn ra) -->
    <div class="col-12 col-lg-6">
      <div class="sh-card p-4 p-sm-5 h-100 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start pb-3"
             style="border-bottom:1px solid var(--sh-slate-100);">
          <div>
            <h3 class="mb-0 fw-bold" style="font-size:15px;color:var(--sh-slate-900);">Sắp diễn ra</h3>
            <p class="mb-0 mt-1" style="font-size:11px;color:var(--sh-slate-500);">Bài tập, kỳ thi và sự kiện tuần này</p>
          </div>
          <a asp-controller="Calendar" asp-action="Index" class="fw-bold text-decoration-none flex-shrink-0"
             style="font-size:12px;color:var(--sh-indigo-600);">
            Xem lịch <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        @if (Model.UpcomingEvents.Any())
        {
          <div class="mt-4 flex-grow-1">
            @foreach (var ev in Model.UpcomingEvents)
            {
              <div class="p-3 rounded-3 d-flex align-items-start gap-3 mb-3"
                   style="background:var(--sh-slate-50);border:1px solid var(--sh-slate-100);">
                <div class="p-2 rounded-3 flex-shrink-0" style="background:var(--sh-indigo-50);color:var(--sh-indigo-600);">
                  <i class="bi bi-calendar-event"></i>
                </div>
                <div class="flex-grow-1 overflow-hidden">
                  <h4 class="mb-0 fw-bold truncate" style="font-size:12px;color:var(--sh-slate-900);">@ev.Title</h4>
                  <div class="d-flex gap-2 mt-1" style="font-size:11px;color:var(--sh-slate-500);">
                    <span>📅 @ev.DateText</span>
                    <span>• @ev.TimeText</span>
                  </div>
                </div>
                <span class="cat-badge @ev.BadgeCssClass flex-shrink-0">@ev.EventTypeLabel</span>
              </div>
            }
          </div>
        }
        else
        {
          <!-- Empty State Upcoming -->
          <div class="my-auto text-center py-5">
            <div style="font-size:42px; margin-bottom:12px;">🔔</div>
            <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Hiện tại chưa có sự kiện nào.</h4>
            <p class="text-muted mb-3" style="font-size:12px;">Bạn có thể thêm lịch học hoặc sự kiện mới.</p>
            <a asp-controller="Calendar" asp-action="Index" class="btn-primary-sh d-inline-flex justify-content-center">
              Thêm lịch →
            </a>
          </div>
        }
      </div>
    </div>

    <!-- Flashcards (Thẻ ghi nhớ) -->
    <div class="col-12 col-lg-6">
      <div class="sh-card p-4 p-sm-5 h-100 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start pb-3"
             style="border-bottom:1px solid var(--sh-slate-100);">
          <div>
            <h3 class="mb-0 fw-bold" style="font-size:15px;color:var(--sh-slate-900);">Thẻ ghi nhớ (Flashcard)</h3>
            <p class="mb-0 mt-1" style="font-size:11px;color:var(--sh-slate-500);">Ôn tập ghi nhớ nhanh chóng</p>
          </div>
          <a asp-controller="Flashcards" asp-action="Index" class="fw-bold text-decoration-none"
             style="font-size:12px;color:var(--sh-indigo-600);">
            Kho thẻ (@Model.FlashcardSummary.TotalDecks) <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        @if (Model.FlashcardSummary.TotalDecks > 0)
        {
          <div class="mt-4 flex-grow-1">
            @foreach (var deck in Model.FlashcardSummary.Decks)
            {
              <div class="p-3 rounded-3 d-flex justify-content-between align-items-center gap-3 mb-3"
                   style="border:1px solid var(--sh-slate-200);">
                <div class="overflow-hidden flex-grow-1">
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="subject-badge subject-toan">Bộ thẻ</span>
                  </div>
                  <h4 class="mb-1 fw-bold truncate" style="font-size:12px;color:var(--sh-slate-900);">@deck.Title</h4>
                  @if (!string.IsNullOrWhiteSpace(deck.Description))
                  {
                    <p class="mb-0 text-muted truncate" style="font-size:11px;">@deck.Description</p>
                  }
                </div>
                <a asp-controller="Flashcards" asp-action="Details" asp-route-deckId="@deck.DeckId" class="btn-primary-sh flex-shrink-0" style="font-size:11px;padding:6px 12px;">Học Flashcard →</a>
              </div>
            }
          </div>
        }
        else
        {
          <!-- Empty State Flashcards -->
          <div class="my-auto text-center py-5">
            <div style="font-size:42px; margin-bottom:12px;">🎴</div>
            <h4 class="fw-bold" style="font-size:14px; color:var(--sh-slate-700);">Hiện tại chưa có Flashcard nào.</h4>
