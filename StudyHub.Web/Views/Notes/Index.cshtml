@{
    ViewData["Title"] = "Tài liệu PDF";
    ViewData["PageTitle"] = "Ghi chú & Tài liệu";
    ViewData["PageSubtitle"] = "Thư viện PDF cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="notes-library" class="notes-module" data-api="/api/notes/documents">
    @Html.AntiForgeryToken()
    <div class="notes-library-intro mb-3">
        <div>
            <h2 class="fw-bold mb-1" style="font-size:20px;color:var(--sh-slate-900)">Thư viện tài liệu</h2>
            <p class="mb-0 text-secondary">Đọc PDF, ghi chú và chia sẻ vào nhóm học tập từ một nơi.</p>
        </div>
    </div>
    <div class="notes-library-layout">
    <div class="notes-library-sticky">
    <nav class="notes-library-nav sh-card" aria-label="Các mục thư viện">
        <span class="notes-nav-caption">THƯ VIỆN CỦA TÔI</span>
        <button type="button" class="active" data-filter="all"><i class="bi bi-grid"></i> Tất cả</button>
        <button type="button" data-filter="pdf"><i class="bi bi-file-earmark-pdf"></i> Tài liệu PDF</button>
        <button type="button" data-filter="notes"><i class="bi bi-journal-text"></i> Ghi chú</button>
        <button type="button" data-filter="archived"><i class="bi bi-archive"></i> Đã lưu trữ</button>
    </nav>
    <div class="notes-library-actions">
        <form id="pdf-upload-form" class="notes-upload sh-card" aria-label="Tải PDF lên thư viện">
            <div class="notes-action-icon" aria-hidden="true"><i class="bi bi-file-earmark-pdf"></i></div>
            <div class="notes-upload-fields">
                <strong>Tải PDF lên</strong>
                <span class="small text-secondary">Tài liệu riêng tư; tối đa 25 MB.</span>
                <label class="form-label mt-2 mb-1" for="pdf-title">Tên hiển thị (không bắt buộc)</label>
                <input id="pdf-title" class="form-control" maxlength="200" placeholder="Để trống để dùng tên file">
            </div>
            <div class="notes-upload-buttons">
                <label class="btn btn-outline-primary mb-0" for="pdf-upload-file"><i class="bi bi-folder2-open"></i> Chọn file
                    <input id="pdf-upload-file" type="file" accept="application/pdf,.pdf" hidden>
                </label>
                <button id="pdf-upload-submit" class="btn-primary-sh" type="submit" disabled><i class="bi bi-cloud-arrow-up"></i> Tải lên</button>
            </div>
        </form>
        <div class="notes-create-card sh-card">
            <div class="notes-action-icon" aria-hidden="true"><i class="bi bi-journal-text"></i></div>
            <div><strong>Ghi chú cá nhân</strong><p class="small text-secondary mb-0">Viết bằng Quill và mở cạnh PDF khi cần.</p></div>
            <button id="note-create" class="btn btn-outline-primary" type="button"><i class="bi bi-journal-plus"></i> Tạo ghi chú</button>
        </div>
    </div>
    <progress id="pdf-upload-progress" class="notes-upload-progress d-none" max="100" value="0" aria-label="Tiến độ tải PDF"></progress>
    </div>
    <div class="notes-library-main">

    <div class="sh-card p-3 p-lg-4">
        <div class="notes-library-filters d-flex flex-column flex-lg-row gap-3 justify-content-between mb-3">
            <h3 class="h6 fw-bold mb-0">Tệp và ghi chú</h3>
            <div class="notes-search-sort d-flex gap-2">
                <input id="library-search" class="form-control" type="search" placeholder="Tìm tài liệu..." aria-label="Tìm tài liệu">
                <select id="library-sort" class="form-select" aria-label="Sắp xếp">
                    <option value="recent">Mới cập nhật</option>
                    <option value="title">Tên A–Z</option>
                </select>
            </div>
        </div>
        <p id="library-status" class="small text-secondary mb-3" role="status">Đang tải thư viện…</p>
        <div id="library-empty" class="notes-empty text-center py-5 d-none">
            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
            <h3 class="mt-3">Chưa có PDF nào</h3>
            <p class="mb-0">Chọn một file PDF để thêm vào thư viện.</p>
        </div>
        <div class="table-responsive">
            <table class="table align-middle notes-table mb-0">
                <thead><tr><th>Tài liệu</th><th>Dung lượng</th><th>Cập nhật</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody id="library-rows"></tbody>
            </table>
        </div>
    </div>
    </div>
    </div>
</div>

<div class="modal fade" id="notes-share-modal" tabindex="-1" aria-labelledby="notes-share-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="px-3 pt-3 notes-share-summary">
                <strong id="notes-share-document" class="d-block text-break"></strong>
                <p id="notes-share-impact" class="small text-secondary mt-2 mb-0"></p>
            </div>
            <div class="modal-header"><h2 id="notes-share-title" class="modal-title fs-6 fw-bold">Chia sẻ vào StudyGroup</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body"><label for="notes-share-group" class="form-label">Nhóm bạn đang là thành viên</label><select id="notes-share-group" class="form-select"></select><p id="notes-share-status" class="small text-secondary mt-2 mb-0" role="status"></p></div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button id="notes-share-confirm" type="button" class="btn-primary-sh">Chia sẻ</button></div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/notes-module.css" asp-append-version="true" />
}
@section Scripts {
    <script type="module" src="~/notes/assets/notesLibrary.js" asp-append-version="true"></script>
}
