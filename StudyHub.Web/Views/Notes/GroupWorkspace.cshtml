@model long
@{
    ViewData["Title"] = "Tài nguyên nhóm · Notes";
    ViewData["PageTitle"] = "Notes & PDF · StudyGroup";
    ViewData["PageSubtitle"] = "Tài liệu và ghi chú được thành viên Active chỉnh sửa trực tiếp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main id="group-notes-workspace" class="notes-group-workspace" data-group-id="@Model" data-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
    @Html.AntiForgeryToken()
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <a href="/Groups/@Model" class="btn btn-light"><i class="bi bi-arrow-left"></i> StudyGroup</a>
        <span id="group-notes-status" class="small text-secondary" role="status">Đang kiểm tra quyền thành viên…</span>
    </div>
    <div class="notes-group-layout">
    <nav class="notes-group-nav sh-card" aria-label="Tài nguyên nhóm">
        <span class="notes-group-nav-caption">KHÔNG GIAN NHÓM</span>
        <a href="#group-pdf-section"><i class="bi bi-file-earmark-pdf"></i> PDF được chia sẻ</a>
        <a href="#group-notes-section"><i class="bi bi-journal-text"></i> Ghi chú nhóm</a>
        <a href="#group-recovery-section"><i class="bi bi-clock-history"></i> Đã xóa gần đây</a>
    </nav>
    <div class="notes-group-main">
    <section class="sh-card p-4 mb-4">
        <h2 id="group-notes-title" class="h5 fw-bold mb-1">Tài nguyên nhóm</h2>
        <p class="small text-secondary mb-0">PDF giữ nguyên file gốc. Thành viên Active chỉnh sửa ghi chú và annotation nhóm trực tiếp.</p>
    </section>
    <section id="group-pdf-section" class="sh-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h6 fw-bold mb-0"><i class="bi bi-file-earmark-pdf me-2"></i>PDF được chia sẻ</h2><span id="group-pdf-count" class="badge text-bg-light">0</span></div>
        <div id="group-pdf-list" class="notes-group-grid"></div>
        <p id="group-pdf-empty" class="notes-group-empty" hidden>Nhóm chưa có PDF Notes nào.</p>
    </section>
    <section id="group-notes-section" class="sh-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h6 fw-bold mb-0"><i class="bi bi-journal-text me-2"></i>Group Notes</h2><span id="group-note-count" class="badge text-bg-light">0</span></div>
        <form id="group-note-create" class="notes-group-create mb-4">
            <div class="row g-3"><div class="col-md-4"><label class="form-label small fw-semibold" for="new-group-note-title">Tiêu đề ghi chú</label><input id="new-group-note-title" class="form-control" maxlength="200" required placeholder="Ví dụ: Ôn tập chương 1"></div><div class="col-md-8"><span id="new-group-note-body-label" class="form-label small fw-semibold d-block">Nội dung ghi chú</span><textarea id="new-group-note-body" class="form-control" rows="2" required placeholder="Ghi chú học tập…"></textarea></div></div>
            <div class="d-flex justify-content-end mt-2"><button class="btn-primary-sh" type="submit"><i class="bi bi-send"></i> Tạo ghi chú nhóm</button></div>
        </form>
        <div id="group-note-list" class="notes-group-grid"></div>
        <section id="group-note-history" class="mt-3 border rounded p-3" hidden>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 id="group-note-history-title" class="h6 mb-0">Lịch sử Group Note</h3>
                <button id="group-note-history-close" type="button" class="btn btn-sm btn-outline-secondary">Đóng</button>
            </div>
            <div id="group-note-history-list" class="notes-group-grid"></div>
        </section>
        <p id="group-note-empty" class="notes-group-empty" hidden>Chưa có Group Note. Ghi chú cá nhân có thể được chia sẻ từ thư viện.</p>
    </section>
    <section id="group-recovery-section" class="sh-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h6 fw-bold mb-0">Group Notes đã xóa (30 ngày)</h2><span id="group-deleted-note-count" class="badge text-bg-light">0</span></div>
        <div id="group-deleted-note-list" class="notes-group-grid"></div>
        <p id="group-deleted-note-empty" class="notes-group-empty" hidden>Không có ghi chú nào trong thời hạn khôi phục.</p>
    </section>
    </div>
    </div>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/notes-module.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notes-group.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/notes/assets/notes-quill.css" asp-append-version="true" />
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@9.0.6/dist/browser/signalr.min.js"></script>
    <script type="module" src="~/notes/assets/groupWorkspace.js" asp-append-version="true"></script>
}
