@model FlashcardLearnViewModel

@{
    ViewData["Title"] = $"Learn - {Model.DeckTitle}";
}

<div class="container py-4">

    <a asp-controller="Flashcards"
       asp-action="Index"
       asp-route-deckId="@Model.DeckId"
       class="btn btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left"></i>
        Quay lại Deck
    </a>

    <h2 class="fw-bold mb-2">
        @Model.DeckTitle
    </h2>

    <p class="text-muted mb-4">
        Learn Mode
    </p>

    @if (Model.Session is null)
    {
        <div class="alert alert-warning">
            Không thể bắt đầu phiên học.
            Deck cần ít nhất 2 đáp án khác nhau
            và câu hỏi không được mơ hồ.
        </div>
    }
    else
    {
        <div class="mb-4">
            <p id="sessionProgress"
               class="fw-semibold">
                Đã học: @Model.Session.LearnedCount /
                @Model.Session.TotalCards
                |
                New: @Model.Session.NewCount
                |
                Learning: @Model.Session.LearningCount
            </p>

            <div class="progress"
                 role="progressbar"
                 aria-label="Tiến trình Learn"
                 aria-valuenow="@Model.Session.LearnedCount"
                 aria-valuemin="0"
                 aria-valuemax="@Model.Session.TotalCards">

                <div id="learnProgressBar"
                     class="progress-bar"
                     style="width: @(Model.Session.TotalCards == 0
                         ? 0
                         : 100.0 * Model.Session.LearnedCount
                             / Model.Session.TotalCards)%">
                </div>
            </div>
        </div>

            @if (!Model.Session.IsCompleted)
            {
                <p class="text-muted small mb-3">
                    Trộn thứ tự thẻ:
                    <strong>
                        @(Model.Session.ShuffleEnabled ? "ON" : "OFF")
                    </strong>
                </p>
            }

        @if (Model.Session.IsCompleted)
        {
            if (Model.Result is not null)
            {
                var result = Model.Result;

                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h3 class="text-success mb-4">
                            Hoàn thành phiên học!
                        </h3>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <p>Tổng lượt trả lời:
                                    <strong>@result.TotalAttempts</strong>
                                </p>
                                <p>Đúng:
                                    <strong class="text-success">@result.Correct</strong>
                                </p>
                                <p>Sai:
                                    <strong class="text-danger">@result.Incorrect</strong>
                                </p>
                            </div>

                            <div class="col-md-6">
                                <p>Độ chính xác:
                                    <strong>@result.Accuracy.ToString("0.##")%</strong>
                                </p>
                                <p>Đã học:
                                    <strong>@result.Learned / @result.TotalCards</strong>
                                </p>
                                <p>Còn lại:
                                    <strong>@result.Remaining</strong>
                                </p>
                            </div>
                        </div>

                        <a asp-controller="Flashcards"
                           asp-action="Learn"
                           asp-route-deckId="@Model.DeckId"
                           class="btn btn-primary">
                            Học lại toàn bộ
                        </a>

                        <a asp-controller="Flashcards"
                           asp-action="Details"
                           asp-route-deckId="@Model.DeckId"
                           class="btn btn-outline-secondary ms-2">
                            Quay lại Deck
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    Không thể tải kết quả phiên học.
                </div>
            }
        }
        else if (Model.Question is not null)
        {
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <p class="text-muted small mb-2">
                        CÂU HỎI
                    </p>

                    <h3 class="mb-4">
                        @Model.Question.Question.QuestionText
                    </h3>

                    <form id="learnAnswerForm"
                          asp-controller="Flashcards"
                          asp-action="SubmitLearnAnswer"
                          asp-route-deckId="@Model.DeckId"
                          asp-route-sessionId="@Model.Session.SessionId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="QuestionToken"
                               value="@Model.Question.QuestionToken" />

                        <input type="hidden"
                               name="QuestionCardId"
                               value="@Model.Question.Question.QuestionCardId" />

                        <input type="hidden"
                               id="selectedAnswer"
                               name="SelectedAnswer" />

                        <div id="learnOptions">

                            @foreach (var option in Model.Question.Question.Options)
                            {
                                <button type="button"
                                        class="learn-option btn btn-outline-secondary w-100 text-start p-3 mb-3"
                                        data-answer="@option.Text">

                                    <span class="option-text">
                                        @option.Text
                                    </span>
                                </button>
                            }

                        </div>
                    </form>

                    <div id="feedbackMessage"
                         role="status"
                         aria-live="polite"
                         aria-atomic="true">
                    </div>

                    <div id="learnFeedback"
                         class="d-none mt-3">

                        <button type="button"
                                id="nextQuestionButton"
                                class="btn btn-primary">
                            <span id="nextQuestionButtonText">Câu tiếp theo</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>

                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                Không thể tải câu hỏi hiện tại.
                Hãy quay lại Deck và bắt đầu phiên mới.
            </div>
        }
    }
</div>


@section Scripts {
    <script src="~/js/flashcards/learn.js"
            asp-append-version="true"></script>
}
