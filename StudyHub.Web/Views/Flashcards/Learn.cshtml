@model FlashcardLearnViewModel

@{
    ViewData["Title"] = $"Learn - {Model.DeckTitle}";
}

<div class="container py-4">

    <a asp-controller="Flashcards"
       asp-action="Details"
       asp-route-deckId="@Model.DeckId"
       class="btn btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left"></i>
        Quay lại Deck
    </a>

    <h2 class="fw-bold mb-2">
        @Model.DeckTitle
    </h2>

    <p class="text-muted mb-4">
        Learn Mode
    </p>

    @if (Model.Session is null)
    {
        <div class="alert alert-warning">
            Không thể bắt đầu phiên học.
            Deck cần ít nhất 2 đáp án khác nhau
            và câu hỏi không được mơ hồ.
        </div>
    }
    else
    {
        <div class="mb-4">
            <p id="sessionProgress"
               class="fw-semibold">
                Đã học: @Model.Session.LearnedCount /
                @Model.Session.TotalCards
                |
                New: @Model.Session.NewCount
                |
                Learning: @Model.Session.LearningCount
            </p>

            <div class="progress"
                 role="progressbar"
                 aria-label="Tiến trình Learn"
                 aria-valuenow="@Model.Session.LearnedCount"
                 aria-valuemin="0"
                 aria-valuemax="@Model.Session.TotalCards">

                <div id="learnProgressBar"
                     class="progress-bar"
                     style="width: @(Model.Session.TotalCards == 0
                         ? 0
                         : 100.0 * Model.Session.LearnedCount
                             / Model.Session.TotalCards)%">
                </div>
            </div>
        </div>

        @if (Model.Session.IsCompleted)
        {
            <div class="alert alert-success">
                <h4 class="alert-heading">
                    Hoàn thành phiên học!
                </h4>

                <p>
                    Bạn đã học xong
                    @Model.Session.LearnedCount /
                    @Model.Session.TotalCards
                    flashcards.
                </p>

                <a asp-controller="Flashcards"
                   asp-action="Learn"
                   asp-route-deckId="@Model.DeckId"
                   class="btn btn-primary">
                    Học lại
                </a>
            </div>
        }
        else if (Model.Question is not null)
        {
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <p class="text-muted small mb-2">
                        CÂU HỎI
                    </p>

                    <h3 class="mb-4">
                        @Model.Question.Question.QuestionText
                    </h3>

                    <form id="learnAnswerForm"
                          asp-controller="Flashcards"
                          asp-action="SubmitLearnAnswer"
                          asp-route-deckId="@Model.DeckId"
                          asp-route-sessionId="@Model.Session.SessionId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="QuestionToken"
                               value="@Model.Question.QuestionToken" />

                        <input type="hidden"
                               name="QuestionCardId"
                               value="@Model.Question.Question.QuestionCardId" />

                        <input type="hidden"
                               id="selectedAnswer"
                               name="SelectedAnswer" />

                        <div id="learnOptions">

                            @foreach (var option in Model.Question.Question.Options)
                            {
                                <button type="button"
                                        class="learn-option btn btn-outline-secondary w-100 text-start p-3 mb-3"
                                        data-answer="@option.Text">

                                    <span class="option-text">
                                        @option.Text
                                    </span>
                                </button>
                            }

                        </div>
                    </form>

                    <div id="feedbackMessage"
                         role="status"
                         aria-live="polite"
                         aria-atomic="true">
                    </div>

                    <div id="learnFeedback"
                         class="d-none mt-3">

                        <button type="button"
                                id="nextQuestionButton"
                                class="btn btn-primary">
                            Câu tiếp theo
                            <i class="bi bi-arrow-right"></i>
                        </button>

                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                Không thể tải câu hỏi hiện tại.
                Hãy quay lại Deck và bắt đầu phiên mới.
            </div>
        }
    }
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            const form =
                document.getElementById('learnAnswerForm');

            if (!form) return;

            const buttons = Array.from(
                document.querySelectorAll('.learn-option')
            );

            const selectedAnswerInput =
                document.getElementById('selectedAnswer');

            const feedbackMessage =
                document.getElementById('feedbackMessage');

            const feedbackPanel =
                document.getElementById('learnFeedback');

            const nextButton =
                document.getElementById('nextQuestionButton');

            const progressText =
                document.getElementById('sessionProgress');

            const progressBar =
                document.getElementById('learnProgressBar');

            let submitting = false;

            function markButton(button, cssClass) {
                button.classList.remove(
                    'btn-outline-secondary',
                    'btn-success',
                    'btn-danger'
                );

                button.classList.add(cssClass);
            }

            function showFeedback(message, success) {
                feedbackMessage.className =
                    success
                        ? 'alert alert-success mt-3'
                        : 'alert alert-danger mt-3';

                feedbackMessage.textContent = message;
            }

            function showNextButton(text) {
                nextButton.textContent = text;
                feedbackPanel.classList.remove('d-none');
            }

            function normalize(text) {
                return (text ?? '').trim().toLocaleLowerCase();
            }

            function updateProgress(data) {
                if (progressText) {
                    progressText.textContent =
                        `Đã học: ${data.learnedCount} / ${data.totalCards}` +
                        ` | New: ${data.newCount}` +
                        ` | Learning: ${data.learningCount}`;
                }

                if (progressBar && data.totalCards > 0) {
                    const percent =
                        100 * data.learnedCount / data.totalCards;

                    progressBar.style.width = `${percent}%`;

                    progressBar.parentElement?.setAttribute(
                        'aria-valuenow',
                        String(data.learnedCount)
                    );
                }
            }

            buttons.forEach(button => {
                button.addEventListener('click', async function() {

                    if (submitting) return;

                    const answer = button.dataset.answer;

                    if (!answer) return;

                    submitting = true;

                    selectedAnswerInput.value = answer;

                    buttons.forEach(b => b.disabled = true);

                    feedbackMessage.textContent = '';
                    feedbackMessage.className = '';

                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        let data = {};

                        try {
                            data = await response.json();
                        }
                        catch {
                            // Response có thể không phải JSON.
                        }

                        if (!response.ok) {
                            showFeedback(
                                data.message ??
                                'Không thể xử lý câu trả lời. Hãy tải lại trang.',
                                false
                            );

                            showNextButton('Tải lại phiên học');
                            return;
                        }

                        if (data.isCorrect) {
                            markButton(button, 'btn-success');

                            showFeedback(
                                'Chính xác!',
                                true
                            );
                        }
                        else {
                            markButton(button, 'btn-danger');

                            const correctButton = buttons.find(
                                b => normalize(b.dataset.answer) ===
                                    normalize(data.correctAnswer)
                            );

                            if (correctButton) {
                                markButton(correctButton, 'btn-success');
                            }

                            showFeedback(
                                `Chưa chính xác. Đáp án đúng: ${data.correctAnswer}`,
                                false
                            );
                        }

                        updateProgress(data);

                        showNextButton(
                            data.isCompleted
                                ? 'Xem hoàn thành'
                                : 'Câu tiếp theo'
                        );
                    }
                    catch {
                        showFeedback(
                            'Không xác định được kết quả gửi đáp án. ' +
                            'Hãy tải lại phiên học.',
                            false
                        );

                        showNextButton('Tải lại phiên học');
                    }
                });
            });

            nextButton.addEventListener('click', function() {
                // Đang ở URL có SessionId,
                // nên refresh không tạo session mới.
                window.location.reload();
            });
        });
    </script>
}
