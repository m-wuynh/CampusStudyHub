@model FlashcardsIndexViewModel
@{
    ViewData["Title"]        = "Flashcards";
    ViewData["PageTitle"]    = "Thẻ ghi nhớ (Flashcards)";
    ViewData["PageSubtitle"] = "Ôn tập kiến thức &amp; chia sẻ bộ thẻ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["FlashcardSuccess"] is string successMessage)
{
    <div class="alert alert-success mb-4">
        @successMessage
    </div>
}

@if (TempData["FlashcardError"] is string errorMessage)
{
    <div class="alert alert-danger mb-4">
        @errorMessage
    </div>
}

<div id="flashcards-view" style="max-width:1280px; margin:0 auto;">

  <!-- ── Header Actions ── -->
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
      <h2 class="fw-black mb-0 tracking-tight" style="font-size:20px; color:var(--sh-slate-900);">
        Kho Flashcard của tôi
      </h2>
            <p class="mb-0"
               style="font-size:12px; color:var(--sh-slate-500);">
                @Model.Decks.Count bộ thẻ
            </p>
    </div>
    <div class="d-flex gap-2">
      <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#newSetModal">
        <i class="bi bi-plus-lg"></i><span>Tạo bộ thẻ</span>
      </button>
    </div>
  </div>

  <!-- ── Flashcard Sets Grid ── -->
  <div class="row g-4" id="flashcard-sets-grid">
        @if (Model.Decks.Count == 0)
        {
            <div class="col-12">
                <div class="sh-card p-5 text-center">
                    <i class="bi bi-layers"
                       style="font-size:40px; color:var(--sh-slate-300);"></i>

                    <h3 class="fw-bold mt-3 mb-2"
                        style="font-size:16px;">
                        Chưa có bộ flashcard
                    </h3>

                    <p class="mb-3"
                       style="font-size:12px; color:var(--sh-slate-500);">
                        Hãy tạo bộ flashcard đầu tiên của bạn.
                    </p>

                    <button class="btn-primary-sh"
                            data-bs-toggle="modal"
                            data-bs-target="#newSetModal">
                        <i class="bi bi-plus-lg"></i>
                        Tạo bộ thẻ
                    </button>
                </div>
            </div>
        }
        else
        {
            foreach (var deck in Model.Decks)
            {
                <div class="col-12 col-sm-6 col-xl-4">
                    <div class="sh-card p-4 h-100 d-flex flex-column">

                        <div class="d-flex justify-content-between
                            align-items-start mb-3">

                            <div>
                                <span class="subject-badge subject-toan
                                    mb-2 d-inline-block">
                                    Flashcard
                                </span>

                                <h3 class="fw-bold mb-1"
                                    style="font-size:14px;
                                    color:var(--sh-slate-900);">
                                    @deck.Title
                                </h3>

                                <p class="mb-0"
                                   style="font-size:11px;
                                    color:var(--sh-slate-500);">
                                    @(string.IsNullOrWhiteSpace(deck.Description)
                                        ? "Không có mô tả"
                                        : deck.Description)
                                </p>
                            </div>

                            <div class="dropdown">
                                <button class="btn-icon-sh"
                                        data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>

                                <ul class="dropdown-menu
                                    dropdown-menu-end
                                    shadow border-0 rounded-3"
                                    style="font-size:12px; min-width:160px;">

                                    <li>
                                        <button type="button"
                                                class="dropdown-item
                                            d-flex align-items-center gap-2"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editSetModal"
                                                data-deck-id="@deck.DeckId"
                                                data-title="@deck.Title"
                                                data-description="@deck.Description"
                                                data-subject-id="@deck.UserSubjectId">
                                            <i class="bi bi-pencil text-indigo"></i>
                                            Chỉnh sửa
                                        </button>
                                    </li>

                                    <li>
                                        <button type="button"
                                                class="dropdown-item
                                            d-flex align-items-center gap-2
                                            text-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteSetModal"
                                                data-deck-id="@deck.DeckId"
                                                data-title="@deck.Title">
                                            <i class="bi bi-trash3"></i>
                                            Xóa bộ thẻ
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 mb-3"
                             style="font-size:11px;
                            color:var(--sh-slate-500);">

                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-shield-lock"></i>
                                @deck.Visibility
                            </span>

                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-clock"></i>
                                    @(deck.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy"))
                            </span>
                        </div>

                        <div class="mt-auto d-flex gap-2">

                            <a asp-controller="Flashcards"
                               asp-action="Details"
                               asp-route-deckId="@deck.DeckId"
                               class="btn-secondary-sh">
                                <i class="bi bi-eye"></i>
                                Chi tiết
                            </a>

                            <a asp-controller="Flashcards"
                               asp-action="Study"
                               asp-route-deckId="@deck.DeckId"
                               class="btn-primary-sh
                                flex-grow-1
                                justify-content-center">
                                <i class="bi bi-play-fill"></i>
                                Học ngay
                            </a>

                            <button type="button"
                                    class="btn-secondary-sh"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editSetModal"
                                    data-deck-id="@deck.DeckId"
                                    data-title="@deck.Title"
                                    data-description="@deck.Description"
                                    data-subject-id="@deck.UserSubjectId">
                                <i class="bi bi-pencil"></i>
                            </button>

                        </div>

                    </div>
                </div>
            }
        }

  </div>



  </div>





<!-- ── New/Edit Set Modal ── -->

<!--New-->
<div class="modal fade"
     id="newSetModal"
     tabindex="-1"
     aria-labelledby="newSetModalLabel">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <form asp-controller="Flashcards"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title fw-bold"
                        id="newSetModalLabel"
                        style="font-size:14px;">
                        <i class="bi bi-layers me-2 text-indigo"></i>
                        Tạo bộ Flashcard mới
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="sh-label">
                            Tên bộ thẻ
                        </label>

                        <input name="Title"
                               type="text"
                               maxlength="200"
                               class="sh-input"
                               placeholder="Ví dụ: Database Fundamentals"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="sh-label">
                            Mô tả
                        </label>

                        <textarea name="Description"
                                  maxlength="2000"
                                  class="sh-input"
                                  rows="4"
                                  placeholder="Mô tả ngắn về bộ flashcard...">
                        </textarea>
                    </div>

                    <div class="alert alert-light border mb-0"
                         style="font-size:12px;">
                        Bộ thẻ mới đang được tạo ở chế độ
                        <strong>Private</strong>.
                        Chia sẻ Group/Public sẽ được tích hợp ở phase sau.
                    </div>
                </div>

                <div class="modal-footer gap-2">
                    <button type="button"
                            class="btn-secondary-sh"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit"
                            class="btn-primary-sh">
                        <i class="bi bi-floppy me-1"></i>
                        Lưu bộ thẻ
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!--Edit-->
<div class="modal fade"
     id="editSetModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <form id="editDeckForm"
                  method="post">

                @Html.AntiForgeryToken()
                

                <input type="hidden" id="editDeckSubjectId" name="UserSubjectId"/>

                <div class="modal-header">
                    <h5 class="modal-title fw-bold"
                        style="font-size:14px;">
                        <i class="bi bi-pencil me-2 text-indigo"></i>
                        Chỉnh sửa bộ Flashcard
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="sh-label">
                            Tên bộ thẻ
                        </label>

                        <input id="editDeckTitle"
                               name="Title"
                               type="text"
                               maxlength="200"
                               class="sh-input"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="sh-label">
                            Mô tả
                        </label>

                        <textarea id="editDeckDescription"
                                  name="Description"
                                  maxlength="2000"
                                  class="sh-input"
                                  rows="4">
                        </textarea>
                    </div>

                </div>

                <div class="modal-footer gap-2">
                    <button type="button"
                            class="btn-secondary-sh"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit"
                            class="btn-primary-sh">
                        <i class="bi bi-floppy"></i>
                        Lưu thay đổi
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<!--Delete-->
<div class="modal fade"
     id="deleteSetModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form id="deleteDeckForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        Xóa bộ Flashcard
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Bạn có chắc muốn xóa
                        <strong id="deleteDeckTitle"></strong>?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-secondary-sh"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Xóa
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            const editModal = document.getElementById('editSetModal');

            editModal?.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;

                const deckId = button.getAttribute('data-deck-id');
                const title = button.getAttribute('data-title') ?? '';
                const description =
                    button.getAttribute('data-description') ?? '';
                const subjectId = button.getAttribute('data-subject-id') ?? '';

                const form =
                    document.getElementById('editDeckForm');

                document.getElementById('editDeckSubjectId').value = subjectId;
                document.getElementById('editDeckTitle').value =
                    title;

                document.getElementById('editDeckDescription').value =
                    description;

                form.action =
                    `/Flashcards/${deckId}/Edit`;
            });


            const deleteModal =
                document.getElementById('deleteSetModal');

            deleteModal?.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;

                const deckId =
                    button.getAttribute('data-deck-id');

                const title =
                    button.getAttribute('data-title') ?? '';

                document.getElementById('deleteDeckTitle')
                    .textContent = title;

                document.getElementById('deleteDeckForm')
                    .action = `/Flashcards/${deckId}/Delete`;
            });

        });
    </script>
}
