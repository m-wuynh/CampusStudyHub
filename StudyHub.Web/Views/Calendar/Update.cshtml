@using StudyHub.BLL.DTOs
@using StudyHub.Web.ViewModels.Calendar
@model CalendarUpdateViewModel
@{
    ViewData["Title"] = "Cập nhật sự kiện";
    ViewData["PageTitle"] = "Cập nhật sự kiện";
    ViewData["PageSubtitle"] = "Lên lịch cho học tập, bài tập, và kiểm tra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet" href="~/css/calendar/update.css" asp-append-version="true" />
}

<div class="calendar-form-container">

    <!-- ROW 1: Purple Hero Banner matching Index -->
    <div class="calendar-hero-card calendar-hero-card-sm position-relative overflow-hidden text-white">
        <!-- Decorative 4-point Sparkle Star Watermark -->
        <svg class="hero-watermark-star hero-watermark-star-sm" viewBox="0 0 100 100" fill="currentColor">
            <path d="M50 0 C50 27.6 27.6 50 0 50 C27.6 50 50 72.4 50 100 C50 72.4 72.4 50 100 50 C72.4 50 50 27.6 50 0 Z" />
        </svg>

        <div class="hero-card-z2">
            <a href="/Calendar" class="hero-back-link">
                <i class="bi bi-arrow-left"></i><span>Quay lại Lịch học</span>
            </a>
            <h2 class="hero-heading-title">
                <i class="bi bi-calendar-check"></i><span>Cập nhật sự kiện</span>
            </h2>
            <p class="hero-subtitle-text">
                Chỉnh sửa thông tin thời gian, địa điểm và nhắc nhở cho sự kiện
            </p>
        </div>
    </div>

    <!-- ROW 2: Form Card -->
    <div class="calendar-form-card p-4">
        <input type="hidden" id="event-id" value="@Model.Id" />
        
        <!-- Tên sự kiện -->
        <div class="mb-3">
            <label class="calendar-form-label" for="event-title">
                <i class="bi bi-type"></i><span>Tên sự kiện <span class="text-danger">*</span></span>
            </label>
            <input id="event-title" type="text" class="calendar-form-input" required maxlength="200" placeholder="Ví dụ: Kiểm tra 1 tiết Toán" value="@Model.Title" />
            <div id="event-title-error" class="calendar-field-error text-danger small mt-1 d-none">
                <i class="bi bi-exclamation-circle-fill me-1"></i>Vui lòng nhập tên sự kiện
            </div>
        </div>
        
        <!-- Ngày, Giờ bắt đầu, Giờ kết thúc -->
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="calendar-form-label" for="event-date">
                    <i class="bi bi-calendar-event"></i><span>Ngày <span class="text-danger">*</span></span>
                </label>
                <input id='event-date' type='date' class='calendar-form-input' required value='@Model.Date.ToString("yyyy-MM-dd")' min='@todayStr' />
            </div>
            <div class="col-md-3 col-6">
                <label class="calendar-form-label" for="event-start">
                    <i class="bi bi-clock"></i><span>Bắt đầu <span class="text-danger">*</span></span>
                </label>
                <input id='event-start' type='time' class='calendar-form-input' required value='@Model.StartTime.ToString("HH:mm")' lang="en-US" />
            </div>
            <div class="col-md-3 col-6">
                <label class="calendar-form-label" for="event-end">
                    <i class="bi bi-clock-history"></i><span>Kết thúc <span class="text-danger">*</span></span>
                </label>
                <input id='event-end' type='time' class='calendar-form-input' required value='@Model.EndTime.ToString("HH:mm")' lang="en-US" />
            </div>
        </div>
        
        <!-- Loại sự kiện & Địa điểm -->
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="calendar-form-label" for="event-category">
                    <i class="bi bi-tag"></i><span>Loại sự kiện <span class="text-danger">*</span></span>
                </label>
                <select id="event-category" class="calendar-form-input" required data-initial-type="@Model.EventType">
                    @if (Model.EventType == "Tự học") {
                        <option value="Tự học" selected>Tự học</option>
                    } else {
                        <option value="Tự học">Tự học</option>
                    }
                    @if (Model.EventType == "Bài tập / Nộp bài") {
                        <option value="Bài tập / Nộp bài" selected>Bài tập / Nộp bài</option>
                    } else {
                        <option value="Bài tập / Nộp bài">Bài tập / Nộp bài</option>
                    }
                    @if (Model.EventType == "Kiểm tra / Thi") {
                        <option value="Kiểm tra / Thi" selected>Kiểm tra / Thi</option>
                    } else {
                        <option value="Kiểm tra / Thi">Kiểm tra / Thi</option>
                    }
                    @if (Model.EventType == "Học nhóm") {
                        <option value="Học nhóm" selected>Học nhóm</option>
                    } else {
                        <option value="Học nhóm">Học nhóm</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="calendar-form-label" for="event-location">
                    <i class="bi bi-geo-alt"></i><span>Địa điểm (tùy chọn)</span>
                </label>
                <input id="event-location" type="text" class="calendar-form-input" maxlength="250" placeholder="Phòng học, Google Meet, thư viện..." value="@Model.Location" />
            </div>
        </div>
        
        <!-- Notifications UI -->
        <div class="mb-4">
            <label class="calendar-form-label">
                <i class="bi bi-bell"></i><span>Nhắc nhở & Thông báo</span>
            </label>
            <div id="notifications-container" class="d-flex flex-column gap-2 mb-2">
                <!-- Notification rows will be appended here -->
            </div>
            <button type="button" class="btn-purple-add-notif" onclick="addNotification()">
                <i class="bi bi-plus-circle-fill"></i><span>Thêm thông báo</span>
            </button>
        </div>

        <!-- Mô tả thêm -->
        <div class="mb-4">
            <label class="calendar-form-label" for="event-description">
                <i class="bi bi-text-paragraph"></i><span>Ghi chú thêm</span>
            </label>
            <textarea id="event-description" class="calendar-form-input" rows="4" maxlength="2000"
                      placeholder="Ghi chú chi tiết về tài liệu, nội dung bài học hoặc lưu ý quan trọng...">@Model.Description</textarea>
        </div>
        
        <!-- Action Buttons -->
        <div class="d-flex justify-content-end align-items-center gap-2 pt-2 border-top">
            <a href="/Calendar" class="btn-purple-cancel">Hủy</a>
            <button type="button" class="btn-purple-primary" onclick="submitEvent()">
                <i class="bi bi-calendar-check-fill"></i><span>Cập nhật sự kiện</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    /* ========================================================
       VALIDATE VÀ XỬ LÝ CẬP NHẬT SỰ KIỆN TRỰC TIẾP TRONG VIEW
       ======================================================== */
    document.addEventListener('DOMContentLoaded', function() {
        var eventIdEl = document.getElementById('event-id');
        var eventId = eventIdEl ? eventIdEl.value : window.location.pathname.split('/').pop();
        var sel = document.getElementById('event-category');
        var initialType = sel ? sel.getAttribute('data-initial-type') || sel.value : '';

        // Tải danh sách loại sự kiện từ server
        fetch('/Calendar/GetCategories')
            .then(function(r) { return r.json(); })
            .then(function(cats) {
                if (!cats || !cats.length) return;
                if (!sel) return;
                sel.innerHTML = cats.map(function(c) {
                    var isSel = (c.name === initialType);
                    return '<option value="' + c.name + '"' + (isSel ? ' selected' : '') + '>' + c.name + '</option>';
                }).join('');
            })
            .catch(function(err) {
                console.error('Lỗi khi tải loại sự kiện:', err);
            });

        // Nạp các nhắc nhở đã lưu trước đó của sự kiện
        if (eventId) {
            fetch('/Calendar/GetEventReminders/' + eventId)
                .then(function(r) { return r.json(); })
                .then(function(reminders) {
                    if (!reminders || !reminders.length) return;
                    reminders.forEach(function(item) {
                        var m = typeof item === 'object' ? item.minutes : item;
                        var ch = typeof item === 'object' ? item.channel : 'notification';
                        var unit = 'minutes';
                        var val = m;

                        if (val > 0) {
                            if (val % 10080 === 0) {
                                unit = 'weeks';
                                val /= 10080;
                            } else if (val % 1440 === 0) {
                                unit = 'days';
                                val /= 1440;
                            } else if (val % 60 === 0) {
                                unit = 'hours';
                                val /= 60;
                            }
                        }
                        window.addNotification(val, unit, ch);
                    });
                })
                .catch(function(err) {
                    console.error('Lỗi khi tải thông báo:', err);
                });
        }

        // Tự động tắt viền đỏ cảnh báo khi người dùng gõ tên
        var titleInput = document.getElementById('event-title');
        if (titleInput) {
            titleInput.addEventListener('input', function() {
                var titleError = document.getElementById('event-title-error');
                if (this.value.trim().length > 0) {
                    if (titleError) titleError.classList.add('d-none');
                    this.classList.remove('border-danger');
                }
            });
        }
    });

    // Thêm một dòng nhắc nhở
    window.addNotification = function(val, unit, channel) {
        if (val === undefined) val = 10;
        if (unit === undefined) unit = 'minutes';
        if (channel === undefined) channel = 'notification';

        var container = document.getElementById('notifications-container');
        if (!container) return;

        var row = document.createElement('div');
        row.className = 'notif-row-purple d-flex align-items-center gap-2 flex-wrap mb-1';
        row.innerHTML = '\
            <i class="bi bi-bell-fill notif-bell-icon"></i>\
            <select class="notif-select-purple">\
                <option value="notification"' + (channel === 'notification' ? ' selected' : '') + '>Thông báo hệ thống</option>\
                <option value="email"' + (channel === 'email' ? ' selected' : '') + '>Email</option>\
            </select>\
            <span class="text-muted small">Trước:</span>\
            <input type="number" min="0" class="notif-input-purple" value="' + val + '">\
            <select class="notif-select-purple">\
                <option value="minutes"' + (unit === 'minutes' ? ' selected' : '') + '>phút</option>\
                <option value="hours"' + (unit === 'hours' ? ' selected' : '') + '>giờ</option>\
                <option value="days"' + (unit === 'days' ? ' selected' : '') + '>ngày</option>\
                <option value="weeks"' + (unit === 'weeks' ? ' selected' : '') + '>tuần</option>\
            </select>\
            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-auto" title="Xóa thông báo" onclick="this.closest(\'.notif-row-purple\').remove()">\
                <i class="bi bi-x-circle-fill notif-remove-icon"></i>\
            </button>';
        container.appendChild(row);
    };

    // ========================================================
    // HÀM KIỂM TRA DỮ LIỆU (VALIDATE) VÀ GỬI LÊN SERVER
    // ========================================================
    window.submitEvent = async function() {
        // Bước 1: Lấy các giá trị từ form
        var eventIdEl = document.getElementById('event-id');
        var eventId = eventIdEl ? eventIdEl.value : window.location.pathname.split('/').pop();

        var titleInput = document.getElementById('event-title');
        var titleError = document.getElementById('event-title-error');
        var title = titleInput ? titleInput.value.trim() : '';
        var date = document.getElementById('event-date')?.value;
        var start = document.getElementById('event-start')?.value;
        var end = document.getElementById('event-end')?.value;
        var category = document.getElementById('event-category')?.value;
        var location = document.getElementById('event-location')?.value || '';
        var description = document.getElementById('event-description')?.value || '';

        // Bước 2 (VALIDATE): Kiểm tra Tên sự kiện không được để trống
        if (!title) {
            if (titleError) titleError.classList.remove('d-none');
            if (titleInput) {
                titleInput.classList.add('border-danger');
                titleInput.focus();
            }
            if (window.showToast) window.showToast('Vui lòng nhập tên ca học!', 'error');
            return;
        }

        // Bước 3 (VALIDATE): Kiểm tra đủ ngày giờ và loại sự kiện
        if (!date || !start || !end || !category) {
            if (window.showToast) window.showToast('Vui lòng điền đủ thông tin thời gian và loại sự kiện!', 'error');
            return;
        }

        // Bước 4 (VALIDATE): Kiểm tra Giờ kết thúc phải sau Giờ bắt đầu
        if (end <= start) {
            if (window.showToast) {
                window.showToast('Giờ kết thúc (' + end + ') phải sau giờ bắt đầu (' + start + ') trong cùng ngày!', 'error');
            } else {
                alert('Giờ kết thúc phải sau giờ bắt đầu!');
            }
            return;
        }

        // Bước 5 (VALIDATE): Kiểm tra ngày giờ kết thúc không ở quá khứ
        var selectedEnd = new Date(date + 'T' + end);
        if (selectedEnd < new Date(Date.now() - 60000)) {
            if (window.showToast) {
                window.showToast('Thời gian kết thúc ca học không thể ở trong quá khứ!', 'error');
            } else {
                alert('Thời gian kết thúc ca học không thể ở trong quá khứ!');
            }
            return;
        }

        // Chuẩn hóa giờ sang HH:mm:ss
        if (start.length === 5) start += ":00";
        if (end.length === 5) end += ":00";

        // Thu thập danh sách thông báo nhắc nhở
        var reminders = [];
        document.querySelectorAll('#notifications-container .notif-row-purple').forEach(function(row) {
            var inputs = row.querySelectorAll('input, select');
            if (inputs.length >= 3) {
                var channel = inputs[0].value;
                var val = parseInt(inputs[1].value, 10);
                var unit = inputs[2].value;
                if (!isNaN(val) && val >= 0) {
                    if (val > 0) {
                        if (unit === 'hours') val *= 60;
                        else if (unit === 'days') val *= 1440;
                        else if (unit === 'weeks') val *= 10080;
                    }
                    reminders.push({ Channel: channel, Minutes: val });
                }
            }
        });

        // Bước 6: Đóng gói và gửi lên Server
        var payload = {
            Id: parseInt(eventId, 10),
            Title: title,
            EventType: category,
            Date: date,
            StartTime: start,
            EndTime: end,
            Location: location,
            Description: description,
            Reminders: reminders
        };

        try {
            var response = await fetch('/Calendar/UpdateEvent/' + eventId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                if (window.showToast) window.showToast('Cập nhật ca học thành công!', 'success');
                setTimeout(function() {
                    window.location.href = '/Calendar';
                }, 600);
            } else {
                var errData = await response.json().catch(function() { return {}; });
                var msg = errData.error || 'Có lỗi xảy ra khi cập nhật.';
                if (window.showToast) window.showToast(msg, 'error');
                else alert(msg);
            }
        } catch (ex) {
            if (window.showToast) window.showToast('Lỗi kết nối máy chủ!', 'error');
            else alert('Lỗi kết nối máy chủ!');
        }
    };
</script>
}
