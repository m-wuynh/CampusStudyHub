@model StudyHub.BLL.DTOs.CalendarCategoryDto
@{
    ViewData["Title"] = "Chỉnh sửa loại sự kiện - Study Hub";
}

<link rel="stylesheet" href="~/css/violet-theme.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/calendar/categories.css" asp-append-version="true" />

<div class="calendar-page-container">
    <div class="category-form-container">
        <!-- Header Navigation & Title -->
        <div class="mb-4">
            <a href="/Calendar/Categories" class="category-page-back-link mb-2 text-decoration-none d-inline-flex align-items-center gap-1.5">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại Danh sách Loại sự kiện</span>
            </a>
            <h2 class="category-page-title d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square text-primary"></i>
                <span>Chỉnh sửa loại sự kiện</span>
            </h2>
            <p class="category-page-subtitle">
                Cập nhật tên hoặc mô tả của loại sự kiện. Tên mới sẽ tự động cập nhật trên các ca học liên quan.
            </p>
        </div>

        <!-- Form Card -->
        <div class="sh-card p-4 category-form-card shadow-sm">
            <form id="form-edit-category">
                <input type="hidden" id="edit-category-id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="calendar-form-label" for="edit-category-name">
                        <span>Tên loại sự kiện <span class="text-danger">*</span></span>
                    </label>
                    <input type="text"
                           id="edit-category-name"
                           class="calendar-form-input"
                           value="@Model.Name"
                           required
                           maxlength="100"
                           autofocus
                           autocomplete="off" />
                    <div id="edit-category-name-error" class="category-field-error text-danger d-none">
                        <i class="bi bi-exclamation-circle"></i>
                        <span class="category-error-text"></span>
                    </div>
                    <div class="form-text small text-muted mt-1">
                        Hiện có <strong>@Model.EventCount</strong> ca học đang gắn loại này.
                    </div>
                </div>

                <div class="mb-4">
                    <label class="calendar-form-label" for="edit-category-desc">
                        <span>Mô tả (tùy chọn)</span>
                    </label>
                    <textarea id="edit-category-desc"
                              class="calendar-form-input category-textarea"
                              rows="3"
                              maxlength="500"
                              placeholder="Ghi chú chi tiết về loại sự kiện này...">@Model.Description</textarea>
                    <div id="edit-category-desc-error" class="category-field-error text-danger d-none">
                        <i class="bi bi-exclamation-circle"></i>
                        <span class="category-error-text"></span>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                    <a href="/Calendar/Categories" class="btn btn-light btn-sm px-3 py-2 rounded-3 text-secondary text-decoration-none fw-medium">
                        Hủy
                    </a>
                    <button type="submit" id="btn-save-edit-category" class="btn btn-primary btn-sm px-4 py-2 rounded-3 fw-semibold d-inline-flex align-items-center gap-2">
                        <i class="bi bi-check-lg"></i>
                        <span>Lưu thay đổi</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    /* ========================================================
       VALIDATE VÀ XỬ LÝ SỬA LOẠI SỰ KIỆN TRỰC TIẾP TRONG VIEW
       ======================================================== */
    document.addEventListener('DOMContentLoaded', function() {
        var form = document.getElementById('form-edit-category');
        var nameInput = document.getElementById('edit-category-name');
        var descInput = document.getElementById('edit-category-desc');
        var nameError = document.getElementById('edit-category-name-error');
        var categoryId = document.getElementById('edit-category-id')?.value;

        // Tắt thông báo lỗi đỏ khi người dùng gõ
        if (nameInput) {
            nameInput.addEventListener('input', function() {
                nameInput.classList.remove('is-invalid');
                if (nameError) nameError.classList.add('d-none');
            });
        }

        if (form) {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();

                // Bước 1: Lấy dữ liệu
                var nameVal = nameInput ? nameInput.value.trim() : '';
                var descVal = descInput ? descInput.value.trim() : '';

                // Bước 2 (VALIDATE): Tên loại sự kiện bắt buộc nhập
                if (!nameVal) {
                    nameInput.classList.add('is-invalid');
                    var span = nameError.querySelector('.category-error-text');
                    if (span) span.textContent = 'Vui lòng nhập tên loại sự kiện!';
                    nameError.classList.remove('d-none');
                    nameInput.focus();
                    return;
                }

                // Bước 3 (VALIDATE): Giới hạn độ dài tối đa 100 ký tự
                if (nameVal.length > 100) {
                    nameInput.classList.add('is-invalid');
                    var span = nameError.querySelector('.category-error-text');
                    if (span) span.textContent = 'Tên loại sự kiện không được vượt quá 100 ký tự!';
                    nameError.classList.remove('d-none');
                    nameInput.focus();
                    return;
                }

                // Bước 4: Gửi dữ liệu cập nhật lên Server
                var btn = document.getElementById('btn-save-edit-category');
                if (btn) btn.disabled = true;

                try {
                    var res = await fetch('/Calendar/Categories/Update/' + categoryId, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Name: nameVal, Description: descVal })
                    });

                    if (res.ok) {
                        if (window.showToast) window.showToast('Cập nhật loại sự kiện thành công!', 'success');
                        setTimeout(function() {
                            window.location.href = '/Calendar/Categories';
                        }, 500);
                    } else {
                        var errData = await res.json().catch(function() { return {}; });
                        var msg = errData.error || 'Có lỗi xảy ra khi cập nhật.';
                        if (window.showToast) window.showToast(msg, 'error');
                        else alert(msg);
                    }
                } catch (err) {
                    if (window.showToast) window.showToast('Lỗi kết nối máy chủ!', 'error');
                    else alert('Lỗi kết nối máy chủ!');
                } finally {
                    if (btn) btn.disabled = false;
                }
            });
        }
    });
</script>
}
