@using StudyHub.BLL.DTOs
@{
    ViewData["Title"] = "Thêm sự kiện";
    ViewData["PageTitle"] = "Thêm sự kiện mới";
    ViewData["PageSubtitle"] = "Lên lịch cho học tập, bài tập, và kiểm tra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
    var nowTimeStr = DateTime.Now.ToString("HH:mm");
    var nowPlusOneHourStr = DateTime.Now.AddHours(1).ToString("HH:mm");
}

@section Styles {
    <link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" />
}

<div style="max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px;">

    <!-- ROW 1: Purple Hero Banner matching Index -->
    <div class="calendar-hero-card position-relative overflow-hidden text-white" style="padding: 24px 28px;">
        <!-- Decorative 4-point Sparkle Star Watermark -->
        <svg class="hero-watermark-star" viewBox="0 0 100 100" fill="currentColor" style="width: 140px; height: 140px; right: 24px;">
            <path d="M50 0 C50 27.6 27.6 50 0 50 C27.6 50 50 72.4 50 100 C50 72.4 72.4 50 100 50 C72.4 50 50 27.6 50 0 Z" />
        </svg>

        <div class="position-relative" style="z-index: 2;">
            <a href="/Calendar" class="text-white text-decoration-none d-inline-flex align-items-center gap-1 opacity-75 mb-2" style="font-size: 13px;">
                <i class="bi bi-arrow-left"></i><span>Quay lại Lịch học</span>
            </a>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2" style="font-size: 22px; color: #ffffff;">
                <i class="bi bi-calendar-plus"></i><span>Thêm sự kiện mới</span>
            </h2>
            <p class="mb-0 text-white-50" style="font-size: 13.5px;">
                Lên lịch cho buổi tự học, bài tập, kỳ thi và nhắc nhở
            </p>
        </div>
    </div>

    <!-- ROW 2: Form Card -->
    <div class="calendar-form-card p-4">
        
        <!-- Tên sự kiện -->
        <div class="mb-3">
            <label class="calendar-form-label" for="event-title">
                <i class="bi bi-type"></i><span>Tên sự kiện <span class="text-danger">*</span></span>
            </label>
            <input id="event-title" type="text" class="calendar-form-input" placeholder="Ví dụ: Kiểm tra 1 tiết Toán, Học nhóm giải tích..." />
        </div>
        
        <!-- Ngày, Giờ bắt đầu, Giờ kết thúc -->
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="calendar-form-label" for="event-date">
                    <i class="bi bi-calendar-event"></i><span>Ngày <span class="text-danger">*</span></span>
                </label>
                <input id="event-date" type="date" class="calendar-form-input" value="@todayStr" min="@todayStr" />
            </div>
            <div class="col-md-3 col-6">
                <label class="calendar-form-label" for="event-start">
                    <i class="bi bi-clock"></i><span>Bắt đầu <span class="text-danger">*</span></span>
                </label>
                <input id="event-start" type="time" class="calendar-form-input" value="@nowTimeStr" lang="en-US" />
            </div>
            <div class="col-md-3 col-6">
                <label class="calendar-form-label" for="event-end">
                    <i class="bi bi-clock-history"></i><span>Kết thúc <span class="text-danger">*</span></span>
                </label>
                <input id="event-end" type="time" class="calendar-form-input" value="@nowPlusOneHourStr" lang="en-US" />
            </div>
        </div>
        
        <!-- Loại sự kiện & Địa điểm -->
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="calendar-form-label" for="event-category">
                    <i class="bi bi-tag"></i><span>Loại sự kiện <span class="text-danger">*</span></span>
                </label>
                <select id="event-category" class="calendar-form-input" style="cursor: pointer;">
                    <option value="SelfStudy">📘 Tự học</option>
                    <option value="Other">📝 Bài tập / Nộp bài</option>
                    <option value="Exam">⏰ Kiểm tra / Thi</option>
                    <option value="Class">👥 Học nhóm</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="calendar-form-label" for="event-location">
                    <i class="bi bi-geo-alt"></i><span>Địa điểm (tùy chọn)</span>
                </label>
                <input id="event-location" type="text" class="calendar-form-input" placeholder="Phòng học, Google Meet, thư viện..." />
            </div>
        </div>
        
        <!-- Notifications / Nhắc nhở -->
        <div class="mb-4">
            <label class="calendar-form-label">
                <i class="bi bi-bell"></i><span>Nhắc nhở & Thông báo</span>
            </label>
            <div id="notifications-container" class="d-flex flex-column gap-2 mb-2">
                <!-- Notification rows will be appended here -->
            </div>
            <button type="button" class="btn-purple-add-notif" onclick="addNotification()">
                <i class="bi bi-plus-circle-fill"></i><span>Thêm thông báo</span>
            </button>
        </div>

        <!-- Mô tả thêm -->
        <div class="mb-4">
            <label class="calendar-form-label" for="event-description">
                <i class="bi bi-text-paragraph"></i><span>Ghi chú thêm</span>
            </label>
            <textarea id="event-description" class="calendar-form-input" rows="4"
                      placeholder="Ghi chú chi tiết về tài liệu, nội dung bài học hoặc lưu ý quan trọng..."></textarea>
        </div>
        
        <!-- Action Buttons -->
        <div class="d-flex justify-content-end align-items-center gap-2 pt-2 border-top">
            <a href="/Calendar" class="btn-purple-cancel">Hủy</a>
            <button type="button" class="btn-purple-primary" onclick="submitEvent()">
                <i class="bi bi-calendar-check-fill"></i><span>Lưu sự kiện</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addNotification() {
            const container = document.getElementById('notifications-container');
            const row = document.createElement('div');
            row.className = 'notif-row-purple d-flex align-items-center gap-2 flex-wrap';
            row.innerHTML = `
                <i class="bi bi-bell-fill" style="color: #7c3aed; font-size: 1.05rem;"></i>
                <select class="notif-select-purple">
                    <option value="notification">Thông báo hệ thống</option>
                    <option value="email">Email</option>
                </select>
                <span class="text-muted small">Trước:</span>
                <input type="number" min="0" class="notif-input-purple" value="10">
                <select class="notif-select-purple">
                    <option value="minutes">phút</option>
                    <option value="hours">giờ</option>
                    <option value="days">ngày</option>
                    <option value="weeks">tuần</option>
                </select>
                <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-auto" title="Xóa thông báo" onclick="this.closest('.notif-row-purple').remove()">
                    <i class="bi bi-x-circle-fill" style="font-size: 1.1rem;"></i>
                </button>
            `;
            container.appendChild(row);
        }

        async function submitEvent() {
            const title = document.getElementById('event-title').value;
            const date = document.getElementById('event-date').value;
            let start = document.getElementById('event-start').value;
            let end = document.getElementById('event-end').value;
            const category = document.getElementById('event-category').value;
            const loc = document.getElementById('event-location').value;
            const desc = document.getElementById('event-description').value;

            if (!title || !title.trim() || !date || !start || !end || !category) {
                showToast('Vui lòng điền đủ thông tin bắt buộc', 'error');
                return;
            }

            if (end <= start) {
				showToast('Giờ không hợp lệ , Vui lòng đặt lại', 'error');
                return;
            }

            const selectedStart = new Date(`${date}T${start}`);
            if (selectedStart < new Date(Date.now() - 60000)) {
                showToast('Thời gian bắt đầu không thể ở trong quá khứ', 'error');
                return;
            }

            if (start.length === 5) start += ":00";
            if (end.length === 5) end += ":00";

            // Extract reminders
            const reminders = [];
            document.querySelectorAll('#notifications-container .d-flex').forEach(row => {
                const inputs = row.querySelectorAll('input, select');
                if (inputs.length >= 3) {
                    const channel = inputs[0].value;
                    let val = parseInt(inputs[1].value);
                    const unit = inputs[2].value;
                    if (!isNaN(val) && val >= 0) {
                        if (val > 0) {
                            if (unit === 'hours') val *= 60;
                            else if (unit === 'days') val *= 1440;
                            else if (unit === 'weeks') val *= 10080;
                        }
                        reminders.push({ Channel: channel, Minutes: val });
                    }
                }
            });

            const data = {
                Title: title.trim(),
                Date: date,
                StartTime: start,
                EndTime: end,
                EventType: category,
                Location: loc,
                Description: desc,
                Reminders: reminders
            };

            try {
                const res = await fetch('/Calendar/CreateEvent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                if (res.ok) {
                    showToast('Đã thêm sự kiện vào lịch!', 'success');
                    setTimeout(() => window.location.href = '/Calendar', 1000);
                } else {
                    const errData = await res.json().catch(() => null);
                    const msg = (errData && errData.error) ? errData.error : 'Lỗi khi thêm sự kiện';
                    showToast(msg, 'error');
                }
            } catch (err) {
                console.error('Lỗi mạng:', err);
                showToast('Lỗi mạng', 'error');
            }
        }
    </script>
}
