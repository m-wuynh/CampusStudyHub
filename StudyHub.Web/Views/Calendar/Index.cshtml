@using StudyHub.BLL.Services.Calendar
@model CalendarIndexViewModel
@{
    ViewData["Title"]        = "Lịch học";
    ViewData["PageTitle"]    = "Thời khóa biểu & Kế hoạch";
    ViewData["PageSubtitle"] = "Theo dõi lịch học, bài tập và kỳ thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/calendar/index.css" asp-append-version="true" />
}

<div id="calendar-view" class="calendar-view-container">

  <!-- ROW 1: Search Bar & Add Event Button -->
  <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
    <!-- Search Bar -->
    <div class="calendar-search-wrapper calendar-search-max position-relative flex-grow-1">
      <div class="calendar-search-input-group d-flex align-items-center">
        <i class="bi bi-search search-icon"></i>
        <input type="text"
               id="calendar-search-input"
               class="calendar-search-input"
               placeholder="Tìm sự kiện (tiêu đề, địa điểm...)"
               autocomplete="off"
               spellcheck="false" />
        <button type="button"
                id="calendar-search-clear"
                class="btn btn-sm btn-link text-muted p-0 border-0 calendar-search-clear d-none"
                title="Xóa tìm kiếm">
          <i class="bi bi-x-circle-fill"></i>
        </button>
      </div>

      <!-- Dropdown Search Results -->
      <div id="calendar-search-dropdown" class="calendar-search-dropdown shadow-lg d-none">
        <div class="search-dropdown-header d-flex justify-content-between align-items-center px-3 py-2 border-bottom bg-light">
          <span class="small fw-semibold text-muted" id="search-results-count">Kết quả tìm kiếm</span>
          <span class="badge bg-secondary-subtle text-secondary search-esc-badge">ESC để đóng</span>
        </div>
        <div id="calendar-search-results-list" class="calendar-search-results-list"></div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex align-items-center gap-2">
      <a href="/Calendar/Reports" class="btn-manage-categories text-decoration-none shadow-sm d-inline-flex align-items-center gap-1.5" title="Báo cáo & Thống kê học tập">
        <i class="bi bi-bar-chart-line text-primary"></i>
        <span>Báo cáo</span>
      </a>
      <a href="/Calendar/Categories" class="btn-manage-categories text-decoration-none shadow-sm d-inline-flex align-items-center gap-1.5" title="Quản lý Loại sự kiện">
        <i class="bi bi-tags"></i>
        <span>Loại sự kiện</span>
      </a>
      <a href="/Calendar/Create" class="btn-hero-add text-decoration-none shadow-sm d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i>
        <span>Thêm sự kiện</span>
      </a>
    </div>
  </div>

  <!-- ROW 2: Hero Progress Banner (Purple Card) -->
  <div class="calendar-hero-card position-relative overflow-hidden text-white">
    <!-- Decorative 4-point Sparkle Star Watermark -->
    <svg class="hero-watermark-star" viewBox="0 0 100 100" fill="currentColor">
      <path d="M50 0 C50 27.6 27.6 50 0 50 C27.6 50 50 72.4 50 100 C50 72.4 72.4 50 100 50 C72.4 50 50 27.6 50 0 Z" />
    </svg>

    <div class="hero-card-z2">
      <!-- Title -->
      <div class="hero-card-title mb-1.5" id="calendar-progress-title">
        <i class="bi bi-calendar-check me-1"></i>Hãy bắt tay vào học ngay để biến mục tiêu thành hiện thực!
      </div>

      <!-- Percentage Big Text -->
      <div class="hero-card-percent fw-bold mb-3" id="calendar-progress-percent">
        @(Model.WeeklyProgress?.CompletionPct ?? 0)% (@(Model.WeeklyProgress?.CompletedEvents ?? 0)/@(Model.WeeklyProgress?.TotalEvents ?? 0) ca)
      </div>

      <!-- Progress Track & Bar -->
      <div class="hero-progress-track mb-3">
        <div id="calendar-progress-bar" class="hero-progress-fill" style="width: @(Model.WeeklyProgress?.CompletionPct ?? 0)%;"></div>
      </div>

      <!-- 3 Pill Badges -->
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="hero-stat-pill" id="stat-completed-badge">
          <i class="bi bi-check2 me-1 fs-6"></i><span>@(Model.WeeklyProgress?.CompletedEvents ?? 0) hoàn thành</span>
        </div>
        <div class="hero-stat-pill" id="stat-pending-badge">
          <i class="bi bi-clock me-1"></i><span>@(Model.WeeklyProgress?.UpcomingEvents ?? 0) sắp tới</span>
        </div>
        <div class="hero-stat-pill" id="stat-missed-badge">
          <i class="bi bi-exclamation-triangle me-1"></i><span>@(Model.WeeklyProgress?.MissedEvents ?? 0) quá hạn</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ROW 2.5: Filter Chips Bar (Bộ nút lọc nhanh theo Loại sự kiện) -->
  <div class="calendar-filter-bar mb-3 d-flex align-items-center gap-2 flex-wrap">
    <span class="filter-bar-label fw-semibold text-muted small"><i class="bi bi-funnel me-1"></i>Lọc theo loại:</span>
    <div class="d-flex align-items-center gap-1.5 flex-wrap" id="calendar-filter-chips">
      <button type="button" class="btn-filter-chip is-active" data-type="all">Tất cả</button>
    </div>
  </div>

  <!-- ROW 3: Calendar Container Card -->
  <div class="sh-card p-0 overflow-hidden calendar-main-card">
    <div id="calendar" class="calendar-grid-container"></div>

    <!-- Event Popover (Hidden by default) -->
    <div id="event-popover" class="event-popover-card d-none">
      <div class="d-flex justify-content-end mb-1 gap-1 align-items-center">
        <button class="btn btn-sm btn-outline-secondary border py-1 px-2 d-flex align-items-center gap-1 me-auto btn-popover-complete" id="btn-toggle-complete">
          <i class="bi bi-circle" id="popover-complete-icon"></i>
          <span id="popover-complete-text">Chưa hoàn thành</span>
        </button>
        <button class="btn btn-sm btn-light border-0 rounded-circle btn-popover-icon" id="btn-edit-event"><i class="bi bi-pencil"></i></button>
        <button class="btn btn-sm btn-light border-0 rounded-circle btn-popover-icon" id="btn-delete-event"><i class="bi bi-trash"></i></button>
        <button class="btn btn-sm btn-light border-0 rounded-circle btn-popover-icon ms-1" onclick="document.getElementById('event-popover').classList.add('d-none')"><i class="bi bi-x-lg"></i></button>
      </div>

      <div class="px-3 pb-3">
        <div class="d-flex gap-3 mb-2">
          <div class="popover-color-box" id="popover-color"></div>
          <div>
            <h4 class="mb-1 popover-title-text" id="popover-title"></h4>
            <p class="mb-0 text-muted popover-time-text" id="popover-time"></p>
          </div>
        </div>

        <div class="d-flex flex-column gap-2 ms-1 popover-body-details">

          <!-- Description -->
          <div id="popover-desc-row" class="d-flex align-items-start gap-3 text-muted popover-row-hidden">
            <i class="bi bi-text-left fs-5 flex-shrink-0"></i>
            <span id="popover-desc" class="popover-desc-text"></span>
          </div>

          <!-- Location -->
          <div id="popover-location-row" class="d-flex align-items-center gap-3 text-muted popover-row-hidden">
            <i class="bi bi-geo-alt fs-5 flex-shrink-0"></i>
            <span id="popover-location" class="popover-text-dark"></span>
          </div>

          <!-- Event Type -->
          <div class="d-flex align-items-center gap-3 text-muted">
            <i class="bi bi-tag fs-5 flex-shrink-0"></i>
            <span id="popover-type" class="popover-text-dark"></span>
          </div>

          <!-- Reminders -->
          <div id="popover-reminders-row" class="d-flex align-items-start gap-3 text-muted popover-row-hidden">
            <i class="bi bi-bell fs-5 flex-shrink-0"></i>
            <div id="popover-reminders-list" class="d-flex flex-column popover-text-dark"></div>
          </div>

        </div>
      </div>
      
      <!-- Completion Checkbox -->
      <div class="px-3 pb-3" id="popover-completion-row">
        <div class="pt-2 border-top">
          <div class="form-check mb-0">
            <input class="form-check-input popover-check-input" type="checkbox" id="popover-is-completed">
            <label class="form-check-label popover-check-label" for="popover-is-completed">
              Đánh dấu hoàn thành
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@fullcalendar/core@6.1.15/locales/vi.global.min.js"></script>
    <script src="~/js/calendar/index.js" asp-append-version="true"></script>
}
