@page "/login"
@inject IConfiguration Config
@inject IWebHostEnvironment Environment
<PageTitle>Đăng nhập — Campus Study Hub</PageTitle>
<section class="login-card card"><span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span><h1>Một nơi cho<br />mọi việc học.</h1><p>Đăng nhập để mở không gian học tập của bạn.</p>
@if (Error is not null) { <p class="notice error" role="alert">Đăng nhập chưa thành công. Kiểm tra cấu hình Google, tên miền email hoặc trạng thái tài khoản.</p> }
@if (!string.IsNullOrWhiteSpace(Config["Authentication:Google:ClientId"])) { <a href="/auth/google" class="button">Tiếp tục với Google</a> }
else { <p class="notice">Google OAuth chưa được cấu hình. Xem README để thiết lập Client ID và Client Secret.</p> }
@if (Environment.IsDevelopment() && Config.GetValue<bool>("Demo:Enabled"))
{
    <hr /><p><b>Chế độ phát triển</b> · Dữ liệu demo được lưu riêng theo tài khoản.</p>
    <form method="post" action="/auth/demo" data-enhance="false"><AntiforgeryToken /><label>Tài khoản demo<select name="role"><option value="student">Sinh viên Nguyễn An</option><option value="peer">Sinh viên Minh Anh</option><option value="admin">Quản trị viên</option></select></label><button type="submit">Vào bản demo →</button></form>
}
<p class="small">Khi tiếp tục, bạn đồng ý với <a href="/terms">điều khoản</a> và <a href="/privacy">chính sách riêng tư</a>.</p></section>
@code { [SupplyParameterFromQuery] public string? Error { get; set; } }
