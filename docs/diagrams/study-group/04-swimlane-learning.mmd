flowchart LR
    subgraph Manager["LÀN 1 — OWNER / MODERATOR"]
      direction TB
      A([Bắt đầu]) --> B["Tạo buổi học, mục tiêu<br/>và nội dung chuẩn bị"]
      C["Giao bài cho cả nhóm<br/>hoặc người được chọn"]
      D["Điểm danh sau giờ bắt đầu<br/>Kết thúc buổi học và ghi tổng kết"]
      E["Đọc bài nộp mới nhất<br/>Chọn Hoàn thành hoặc Cần sửa"]
    end
    subgraph Member["LÀN 2 — THÀNH VIÊN ACTIVE"]
      direction TB
      F["Xem lịch, đăng ký trước giờ học<br/>Đọc tài nguyên và tham gia buổi học"]
      G["Người được giao làm bài<br/>Nộp nội dung hoặc liên kết"]
      H["Đọc nhận xét<br/>Sửa và nộp phiên bản mới"]
      I["Xem kết quả và tiến độ tuần"] --> Z([Kết thúc])
      Error["Nhận thông báo lỗi<br/>hoặc yêu cầu tải lại dữ liệu"]
    end
    subgraph System["LÀN 3 — HỆ THỐNG STUDY HUB"]
      direction TB
      J["Kiểm tra quyền, thời gian<br/>và dữ liệu buổi học / bài tập"]
      V["Kiểm tra Active, được giao bài,<br/>bài đang mở, hạn nộp và phiên bản"]
      K{"Được phép nộp?"}
      L["Kiểm tra người nhận xét có quyền<br/>và đây là bài nộp mới nhất"]
      M{"Kết quả đánh giá?"}
      N["Tính tiến độ khi tải tab:<br/>buổi Completed + bài nộp mới nhất<br/>Tuần theo giờ Việt Nam"]
    end
    subgraph Data["LÀN 4 — DATABASE"]
      direction TB
      O["Lưu buổi học và bài tập<br/>Chốt danh sách người được giao"]
      Q["Lưu đăng ký, điểm danh<br/>và tổng kết buổi học"]
      R["Tạo bài nộp phiên bản mới<br/>Giữ lịch sử các lần trước"]
      S["Lưu NeedsRevision<br/>và nhận xét bắt buộc"]
      T["Lưu Completed<br/>và thông tin người đánh giá"]
    end
    B --> C --> J --> O --> F
    F --> D --> Q
    F --> G --> V --> K
    K -->|Không| Error
    K -->|Có| R --> E --> L --> M
    M -->|Cần sửa| S --> H --> V
    M -->|Hoàn thành| T --> N --> I
    Q -. "Dữ liệu dùng để tính tiến độ" .-> N
    Error -. "Sửa dữ liệu / tải lại / chờ quản lý xử lý" .-> G
    style Manager fill:#fff7ed,stroke:#fb923c
    style Member fill:#eff6ff,stroke:#60a5fa
    style System fill:#f5f3ff,stroke:#a78bfa
    style Data fill:#f0fdf4,stroke:#4ade80
