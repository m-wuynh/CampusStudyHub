flowchart LR
    User["👤 Người dùng đã đăng nhập"]:::actor
    Member["👤 Thành viên Active"]:::actor
    Manager["👤 Người quản lý<br/>(Owner hoặc Moderator)"]:::actor
    Owner["👤 Owner"]:::actor

    subgraph System["STUDY HUB — STUDY GROUP"]
      direction TB
      subgraph Access["Khám phá và tư cách thành viên"]
        U1(["Tìm kiếm / xem trước nhóm"])
        U2(["Tạo nhóm"])
        U3(["Tham gia / gửi yêu cầu<br/>hoặc chấp nhận lời mời"])
        U4(["Rút yêu cầu / xin gỡ cấm"])
      end
      subgraph Learning["Hoạt động của thành viên"]
        M1(["Xem nội dung và thành viên nhóm"])
        M2(["Chat và đọc thông báo"])
        M3(["Xem buổi học<br/>đăng ký / hủy đăng ký"])
        M4(["Xem bài tập / nộp bài<br/>xem lịch sử và phản hồi"])
        M5(["Đọc tài nguyên chung<br/>chia sẻ / gỡ tài nguyên của mình"])
        M6(["Tìm / đặt câu hỏi / trả lời<br/>chọn lời giải cho câu hỏi của mình"])
        M7(["Xem tiến độ nhóm và cá nhân"])
        M8(["Rời nhóm<br/>(trừ Owner)"])
      end
      subgraph Management["Quản lý nhóm"]
        G1(["Duyệt / từ chối yêu cầu<br/>kick / ban / gỡ cấm có điều kiện"])
        G2(["Tạo và sao chép lời mời"])
        G3(["Đăng / ghim thông báo"])
        G4(["Tạo / sửa / hủy buổi học<br/>điểm danh / kết thúc / tổng kết"])
        G5(["Giao / sửa / đóng bài tập<br/>phản hồi bài nộp mới nhất"])
        G6(["Gỡ tài nguyên khỏi nhóm<br/>chọn lời giải trong hỏi đáp"])
        G7(["Đặt mục tiêu tuần<br/>xem tiến độ từng thành viên"])
      end
      subgraph Ownership["Quyền riêng của Owner"]
        O1(["Sửa thông tin và cấu hình nhóm"])
        O2(["Bổ nhiệm / hạ Moderator"])
      end
    end

    User --- U1 & U2 & U3 & U4
    Member --- M1 & M2 & M3 & M4 & M5 & M6 & M7 & M8
    Manager --- G1 & G2 & G3 & G4 & G5 & G6 & G7
    Owner --- O1 & O2
    Member -. "có các quyền chung của" .-> User
    Manager -. "có các quyền của" .-> Member
    Owner -. "có các quyền quản lý của" .-> Manager

    classDef actor fill:#e0e7ff,stroke:#4f46e5,stroke-width:2px,color:#1e1b4b
    style System fill:#f8fafc,stroke:#334155,stroke-width:2px
    style Access fill:#eff6ff,stroke:#93c5fd
    style Learning fill:#f0fdf4,stroke:#86efac
    style Management fill:#fff7ed,stroke:#fdba74
    style Ownership fill:#f5f3ff,stroke:#c4b5fd
