@page
@model CalendarModel
@{
    ViewData["Title"]        = "Lịch học";
    ViewData["PageTitle"]    = "Thời khóa biểu &amp; Kế hoạch";
    ViewData["PageSubtitle"] = "Theo dõi lịch học, bài tập và kỳ thi";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div id="calendar-view" style="max-width:1280px; margin:0 auto;">

  <!-- ── Header ── -->
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
      <button id="cal-prev-btn" class="btn-icon-sh" title="Tháng trước"><i class="bi bi-chevron-left"></i></button>
      <h2 class="fw-black mb-0" style="font-size:20px; color:var(--sh-slate-900);">Tháng 9, 2026</h2>
      <button id="cal-next-btn" class="btn-icon-sh" title="Tháng sau"><i class="bi bi-chevron-right"></i></button>
    </div>
    <div class="d-flex gap-2">
      <!-- Legend -->
      <div class="d-none d-md-flex align-items-center gap-3 sh-card px-3 py-2" style="font-size:11px;">
        <span class="d-flex align-items-center gap-1"><span style="width:8px;height:8px;background:var(--sh-blue-600);border-radius:50%;display:inline-block;"></span>Tự học</span>
        <span class="d-flex align-items-center gap-1"><span style="width:8px;height:8px;background:var(--sh-violet-600);border-radius:50%;display:inline-block;"></span>Bài tập</span>
        <span class="d-flex align-items-center gap-1"><span style="width:8px;height:8px;background:var(--sh-rose-600);border-radius:50%;display:inline-block;"></span>Kiểm tra</span>
        <span class="d-flex align-items-center gap-1"><span style="width:8px;height:8px;background:var(--sh-emerald-600);border-radius:50%;display:inline-block;"></span>Học nhóm</span>
      </div>
      <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#eventModal">
        <i class="bi bi-plus-lg"></i>Thêm sự kiện
      </button>
    </div>
  </div>

  <div class="row g-4">
    <!-- Calendar Grid (col-lg-8) -->
    <div class="col-12 col-lg-8">
      <div class="sh-card overflow-hidden">
        <!-- Day headers -->
        <div class="d-grid" style="grid-template-columns:repeat(7,1fr); border-bottom:1px solid var(--sh-slate-200);">
          @foreach (var day in new[] {"T2","T3","T4","T5","T6","T7","CN"})
          {
            <div class="text-center py-2" style="font-size:11px; font-weight:700; color:var(--sh-slate-500); background:var(--sh-slate-50);">@day</div>
          }
        </div>

        <!-- Calendar cells grid -->
        <div class="calendar-grid">
          @* Week 1 - Aug days (prev month) *@
          @foreach (var d in new[] {31})
          {
            <div class="calendar-cell other-month"><span style="font-size:12px; color:var(--sh-slate-300); font-weight:600;">@d</span></div>
          }

          @* Sep 1 - Sep 7 *@
          @for (int d = 1; d <= 6; d++)
          {
            <div class="calendar-cell">
              <span style="font-size:12px; font-weight:700; color:var(--sh-slate-900);">@d</span>
              @if (d == 3) {
                <div class="mt-1 px-1 py-0 rounded" style="background:var(--sh-violet-100); color:var(--sh-violet-700); font-size:9px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">Bài tập Toán</div>
              }
              @if (d == 5) {
                <div class="mt-1 px-1 py-0 rounded" style="background:var(--sh-blue-100); color:var(--sh-blue-700); font-size:9px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">Ôn Lý thuyết</div>
              }
            </div>
          }

          @* Sep 7 (CN) *@
          <div class="calendar-cell">
            <span style="font-size:12px; font-weight:700; color:var(--sh-slate-400);">7</span>
          </div>

          @* Week 2: Sep 8-14 *@
          <div class="calendar-cell">
            <span style="font-size:12px; font-weight:700; color:var(--sh-slate-900);">8</span>
            <div class="mt-1 px-1 py-0 rounded" style="background:var(--sh-emerald-100); color:var(--sh-emerald-700); font-size:9px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Nhóm Hóa</div>
          </div>

          @* TODAY = Sep 9 *@
          <div class="calendar-cell today" style="border:2px solid var(--sh-indigo-400);">
            <span class="d-inline-flex align-items-center justify-content-center"
                  style="width:22px;height:22px;background:var(--sh-indigo-600);border-radius:50%;font-size:11px;font-weight:800;color:#fff;">9</span>
            <div class="mt-1 px-1 py-0 rounded" style="background:var(--sh-blue-100); color:var(--sh-blue-700); font-size:9px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Ôn Toán</div>
            <div class="mt-0.5 px-1 py-0 rounded" style="background:var(--sh-violet-100); color:var(--sh-violet-700); font-size:9px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px;">BT Vật lý</div>
          </div>

          @for (int d = 10; d <= 14; d++)
          {
            <div class="calendar-cell">
              <span style="font-size:12px; font-weight:700; color:var(--sh-slate-900);">@d</span>
              @if (d == 11) {
                <div class="mt-1 px-1 py-0 rounded" style="background:var(--sh-rose-100); color:var(--sh-rose-700); font-size:9px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">⚡ KT 15p Lý</div>
              }
              @if (d == 13) {
                <div class="mt-1 px-1 py-0 rounded" style="background:var(--sh-emerald-100); color:var(--sh-emerald-700); font-size:9px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Nhóm Toán</div>
              }
            </div>
          }

          @* Sep 14 (CN) *@
          <div class="calendar-cell">
            <span style="font-size:12px; font-weight:700; color:var(--sh-slate-400);">14</span>
          </div>

          @* Week 3: Sep 15-21 *@
          @for (int d = 15; d <= 21; d++)
          {
            <div class="calendar-cell @(d == 21 ? "other-month" : "")">
              <span style="font-size:12px; font-weight:700; color:@(d == 21 ? "var(--sh-slate-300)" : "var(--sh-slate-900)");">@d</span>
              @if (d == 16) {
                <div class="mt-1 px-1 py-0 rounded" style="background:var(--sh-violet-100); color:var(--sh-violet-700); font-size:9px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Nộp Hóa</div>
              }
              @if (d == 19) {
                <div class="mt-1 px-1 py-0 rounded" style="background:var(--sh-rose-100); color:var(--sh-rose-700); font-size:9px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">⚡ Giữa kỳ</div>
              }
            </div>
          }

          @* Week 4: Sep 22-28 *@
          @for (int d = 22; d <= 28; d++)
          {
            <div class="calendar-cell @(d == 28 ? "other-month" : "")">
              <span style="font-size:12px; font-weight:700; color:@(d == 28 ? "var(--sh-slate-300)" : "var(--sh-slate-900)");">@d</span>
            </div>
          }

          @* Last partial week *@
          @for (int d = 29; d <= 30; d++)
          {
            <div class="calendar-cell">
              <span style="font-size:12px; font-weight:700; color:var(--sh-slate-900);">@d</span>
            </div>
          }
          @foreach (var d in new[] {1,2,3,4,5})
          {
            <div class="calendar-cell other-month"><span style="font-size:12px; color:var(--sh-slate-300); font-weight:600;">@d</span></div>
          }
        </div>
      </div>
    </div><!-- /calendar grid -->

    <!-- Sidebar: Event List (col-lg-4) -->
    <div class="col-12 col-lg-4">

      <!-- Today's Schedule -->
      <div class="sh-card p-4 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="mb-0 fw-bold" style="font-size:14px; color:var(--sh-slate-900);">
            📅 Hôm nay – Thứ Tư, 09/09
          </h3>
          <span class="px-2 py-0 rounded-full fw-bold"
                style="font-size:10px; background:var(--sh-indigo-100); color:var(--sh-indigo-700);">
            4 sự kiện
          </span>
        </div>

        <div class="space-y-2">
          <div class="event-item completed">
            <div class="d-flex align-items-center gap-3 overflow-hidden flex-grow-1">
              <button type="button" class="event-check-toggle border-0 bg-transparent p-0 flex-shrink-0">
                <i class="bi bi-check-square-fill text-success" style="font-size:18px;"></i>
              </button>
              <div class="overflow-hidden">
                <p class="mb-0 fw-semibold text-decoration-line-through" style="font-size:12px; color:var(--sh-slate-400);">Ôn Toán – Hàm số</p>
                <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500);">07:00 – 08:30</p>
              </div>
            </div>
            <span class="cat-badge study flex-shrink-0">Tự học</span>
          </div>

          <div class="event-item">
            <div class="d-flex align-items-center gap-3 overflow-hidden flex-grow-1">
              <button type="button" class="event-check-toggle border-0 bg-transparent p-0 flex-shrink-0">
                <i class="bi bi-square" style="font-size:18px; color:var(--sh-slate-400);"></i>
              </button>
              <div class="overflow-hidden">
                <p class="mb-0 fw-semibold truncate" style="font-size:12px; color:var(--sh-slate-900);">Bài tập Vật lý Chương 2</p>
                <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500);">09:00 – 10:30 • Thư viện</p>
              </div>
            </div>
            <span class="cat-badge homework flex-shrink-0">Bài tập</span>
          </div>

          <div class="event-item">
            <div class="d-flex align-items-center gap-3 overflow-hidden flex-grow-1">
              <button type="button" class="event-check-toggle border-0 bg-transparent p-0 flex-shrink-0">
                <i class="bi bi-square" style="font-size:18px; color:var(--sh-slate-400);"></i>
              </button>
              <div class="overflow-hidden">
                <p class="mb-0 fw-semibold truncate" style="font-size:12px; color:var(--sh-slate-900);">Học nhóm Hóa – Hữu cơ</p>
                <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500);">14:00 – 16:00 • Phòng B3</p>
              </div>
            </div>
            <span class="cat-badge group flex-shrink-0">Học nhóm</span>
          </div>

          <div class="event-item">
            <div class="d-flex align-items-center gap-3 overflow-hidden flex-grow-1">
              <button type="button" class="event-check-toggle border-0 bg-transparent p-0 flex-shrink-0">
                <i class="bi bi-square" style="font-size:18px; color:var(--sh-slate-400);"></i>
              </button>
              <div class="overflow-hidden">
                <p class="mb-0 fw-semibold truncate" style="font-size:12px; color:var(--sh-slate-900);">Tiếng Anh – Speaking practice</p>
                <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500);">20:00 – 21:00</p>
              </div>
            </div>
            <span class="cat-badge study flex-shrink-0">Tự học</span>
          </div>
        </div>
      </div>

      <!-- Upcoming -->
      <div class="sh-card p-4">
        <h3 class="fw-bold mb-3" style="font-size:14px; color:var(--sh-slate-900);">Sắp diễn ra</h3>
        <div class="space-y-2">
          <div class="p-3 rounded-3 d-flex align-items-center gap-3"
               style="background:var(--sh-rose-50); border:1px solid var(--sh-rose-200);">
            <div style="width:36px; text-align:center; flex-shrink:0;">
              <p class="mb-0 fw-black" style="font-size:16px; color:var(--sh-rose-700);">11</p>
              <p class="mb-0" style="font-size:9px; color:var(--sh-rose-600); font-weight:600;">T6</p>
            </div>
            <div class="flex-grow-1 overflow-hidden">
              <p class="mb-0 fw-bold truncate" style="font-size:12px; color:var(--sh-rose-800);">⚡ KT 15p Vật lý</p>
              <p class="mb-0" style="font-size:11px; color:var(--sh-rose-600);">08:45 – 09:00</p>
            </div>
            <span class="cat-badge exam flex-shrink-0">Kiểm tra</span>
          </div>

          <div class="p-3 rounded-3 d-flex align-items-center gap-3"
               style="background:var(--sh-violet-50); border:1px solid var(--sh-violet-200);">
            <div style="width:36px; text-align:center; flex-shrink:0;">
              <p class="mb-0 fw-black" style="font-size:16px; color:var(--sh-violet-700);">12</p>
              <p class="mb-0" style="font-size:9px; color:var(--sh-violet-600); font-weight:600;">T7</p>
            </div>
            <div class="flex-grow-1 overflow-hidden">
              <p class="mb-0 fw-bold truncate" style="font-size:12px; color:var(--sh-violet-800);">Nộp bài tập Hóa học</p>
              <p class="mb-0" style="font-size:11px; color:var(--sh-violet-600);">07:30 – 08:45</p>
            </div>
            <span class="cat-badge homework flex-shrink-0">Bài tập</span>
          </div>

          <div class="p-3 rounded-3 d-flex align-items-center gap-3"
               style="background:var(--sh-emerald-50); border:1px solid var(--sh-emerald-200);">
            <div style="width:36px; text-align:center; flex-shrink:0;">
              <p class="mb-0 fw-black" style="font-size:16px; color:var(--sh-emerald-700);">13</p>
              <p class="mb-0" style="font-size:9px; color:var(--sh-emerald-600); font-weight:600;">CN</p>
            </div>
            <div class="flex-grow-1 overflow-hidden">
              <p class="mb-0 fw-bold truncate" style="font-size:12px; color:var(--sh-emerald-800);">Họp nhóm Toán 11A1</p>
              <p class="mb-0" style="font-size:11px; color:var(--sh-emerald-600);">14:00 – 17:00</p>
            </div>
            <span class="cat-badge group flex-shrink-0">Học nhóm</span>
          </div>
        </div>
      </div>

    </div><!-- /sidebar -->
  </div><!-- /row -->
</div>

<!-- ── Add Event Modal ── -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="eventModalLabel" style="font-size:14px;">
          <i class="bi bi-calendar-plus me-2 text-indigo"></i>Thêm sự kiện học tập
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="sh-label" for="event-title">Tên sự kiện</label>
          <input id="event-title" type="text" class="sh-input" placeholder="Ví dụ: Kiểm tra 1 tiết Toán" />
        </div>
        <div class="row g-2 mb-3">
          <div class="col-6">
            <label class="sh-label" for="event-date">Ngày</label>
            <input id="event-date" type="date" class="sh-input" value="2026-09-09" />
          </div>
          <div class="col-3">
            <label class="sh-label" for="event-start">Bắt đầu</label>
            <input id="event-start" type="time" class="sh-input" value="08:00" />
          </div>
          <div class="col-3">
            <label class="sh-label" for="event-end">Kết thúc</label>
            <input id="event-end" type="time" class="sh-input" value="09:30" />
          </div>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-6">
            <label class="sh-label" for="event-category">Loại sự kiện</label>
            <select id="event-category" class="sh-input">
              <option value="study">Tự học</option>
              <option value="homework">Bài tập / Nộp bài</option>
              <option value="exam">Kiểm tra / Thi</option>
              <option value="group">Học nhóm</option>
            </select>
          </div>
          <div class="col-6">
            <label class="sh-label" for="event-location">Địa điểm (tùy chọn)</label>
            <input id="event-location" type="text" class="sh-input" placeholder="Phòng học, thư viện..." />
          </div>
        </div>
        <div>
          <label class="sh-label" for="event-description">Mô tả thêm</label>
          <textarea id="event-description" class="sh-input" rows="3"
                    placeholder="Ghi chú thêm về sự kiện này..."></textarea>
        </div>
      </div>
      <div class="modal-footer gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn-primary-sh"
                data-bs-dismiss="modal"
                onclick="showToast('Đã thêm sự kiện vào lịch!', 'success')">
          <i class="bi bi-calendar-check me-1"></i>Lưu sự kiện
        </button>
      </div>
    </div>
  </div>
</div>
