@page
@model GradesModel
@{
    ViewData["Title"]        = "Điểm số &amp; Mục tiêu";
    ViewData["PageTitle"]    = "Điểm số &amp; Mục tiêu học tập";
    ViewData["PageSubtitle"] = "Theo dõi điểm trung bình và biểu đồ tiến bộ";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div id="grades-view" style="max-width:1280px; margin:0 auto;">

  <!-- ── Stats Row ── -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-indigo-600);">8.4</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">ĐTB Chung HK1</p>
        <span class="mt-1 d-inline-block px-2 py-0 rounded-full fw-bold"
              style="font-size:10px; background:var(--sh-emerald-100); color:var(--sh-emerald-700);">Học sinh Giỏi</span>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-emerald-600);">9.0</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Điểm cao nhất</p>
        <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-slate-400);">Toán (HK1)</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-amber-600);">7.5</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Điểm thấp nhất</p>
        <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-slate-400);">Lịch sử (HK1)</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <div class="fw-black" style="font-size:32px; color:var(--sh-rose-600);">3</div>
        <p class="mb-0" style="font-size:11px; color:var(--sh-slate-500); font-weight:600;">Môn dưới mục tiêu</p>
        <p class="mb-0 mt-1" style="font-size:10px; color:var(--sh-rose-600);">Cần cải thiện</p>
      </div>
    </div>
  </div>

  <!-- ── Tabs ── -->
  <ul class="nav nav-tabs mb-4" style="border-bottom:2px solid var(--sh-slate-200);">
    <li class="nav-item">
      <button class="nav-link active fw-bold px-4"
              style="font-size:12px; color:var(--sh-indigo-600); border-bottom:2px solid var(--sh-indigo-600); border-top:0; border-left:0; border-right:0; background:transparent;"
              onclick="gradeTab(this,'grades-tab')">
        📊 Bảng điểm
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link fw-semibold px-4"
              style="font-size:12px; color:var(--sh-slate-500); border:0; background:transparent;"
              onclick="gradeTab(this,'goals-tab')">
        🎯 Mục tiêu học tập
      </button>
    </li>
  </ul>

  <!-- ═══ GRADES TAB ═══ -->
  <div id="grades-tab">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
      <h3 class="fw-bold mb-0" style="font-size:15px; color:var(--sh-slate-900);">Bảng điểm Học kỳ 1, 2026</h3>
      <div class="d-flex gap-2">
        <select class="sh-input" style="font-size:12px; width:auto; padding:6px 12px;">
          <option>Học kỳ 1</option>
          <option>Học kỳ 2</option>
        </select>
        <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addGradeModal">
          <i class="bi bi-plus-lg"></i>Nhập điểm
        </button>
      </div>
    </div>

    <div class="sh-card overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover mb-0 grade-table">
          <thead>
            <tr>
              <th class="ps-4">Môn học</th>
              <th>Miệng</th>
              <th>15p</th>
              <th>1 tiết</th>
              <th>Giữa kỳ</th>
              <th>Cuối kỳ</th>
              <th>ĐTB Môn</th>
              <th class="pe-4">Tiến độ</th>
            </tr>
          </thead>
          <tbody>
            @{
              var subjects = new[]
              {
                new { name="Toán",       oral="9.0", q15="8.5,9.0", q1p="9.0", mid="8.5", fin="9.0", avg=9.0, target=9.0 },
                new { name="Vật lý",     oral="8.0", q15="7.5,8.0", q1p="8.0", mid="7.8", fin="8.5", avg=8.1, target=8.5 },
                new { name="Hóa học",    oral="8.5", q15="8.0,8.5", q1p="8.5", mid="8.0", fin="8.5", avg=8.4, target=8.0 },
                new { name="Ngữ văn",    oral="8.0", q15="7.5,8.0", q1p="7.5", mid="7.8", fin="8.0", avg=7.8, target=8.0 },
                new { name="Tiếng Anh",  oral="9.0", q15="8.5,9.0", q1p="8.5", mid="8.8", fin="9.0", avg=8.9, target=8.5 },
                new { name="Sinh học",   oral="8.0", q15="7.8,8.0", q1p="8.2", mid="7.9", fin="8.0", avg=8.0, target=8.0 },
                new { name="Lịch sử",    oral="7.5", q15="7.5,7.0", q1p="7.5", mid="7.0", fin="7.5", avg=7.5, target=8.0 },
                new { name="Địa lý",     oral="8.0", q15="8.0,8.5", q1p="8.0", mid="8.0", fin="8.0", avg=8.1, target=8.0 },
                new { name="Tin học",    oral="9.0", q15="9.0,9.5", q1p="9.0", mid="9.0", fin="9.5", avg=9.1, target=9.0 },
              };
            }
            @foreach (var s in subjects)
            {
              var pct = Math.Min(100, (int)((s.avg / s.target) * 100));
              var color = s.avg >= s.target ? "var(--sh-emerald-600)" : s.avg >= s.target - 0.5 ? "var(--sh-amber-600)" : "var(--sh-rose-600)";
              <tr>
                <td class="ps-4 fw-semibold" style="font-size:12px; color:var(--sh-slate-900);">@s.name</td>
                <td style="font-size:12px;">@s.oral</td>
                <td style="font-size:12px;">@s.q15</td>
                <td style="font-size:12px;">@s.q1p</td>
                <td style="font-size:12px;">@s.mid</td>
                <td style="font-size:12px;">@s.fin</td>
                <td class="fw-black" style="font-size:14px; color:@color;">@s.avg.ToString("0.0")</td>
                <td class="pe-4">
                  <div class="d-flex align-items-center gap-2">
                    <div class="sh-progress flex-grow-1" style="height:5px;">
                      <div class="sh-progress-bar" style="width:@pct%; background:@color;"></div>
                    </div>
                    <span style="font-size:10px; font-weight:700; color:@color; white-space:nowrap;">@pct%</span>
                  </div>
                </td>
              </tr>
            }
          </tbody>
          <tfoot>
            <tr style="border-top:2px solid var(--sh-slate-200);">
              <td class="ps-4 fw-black" style="font-size:12px; color:var(--sh-slate-900);" colspan="6">
                Điểm trung bình chung
              </td>
              <td class="fw-black" style="font-size:16px; color:var(--sh-indigo-600);">8.4</td>
              <td class="pe-4">
                <span class="px-2 py-0 rounded-full fw-bold"
                      style="font-size:10px; background:var(--sh-emerald-100); color:var(--sh-emerald-700);">
                  Học sinh Giỏi
                </span>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <!-- ═══ GOALS TAB ═══ -->
  <div id="goals-tab" style="display:none;">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
      <h3 class="fw-bold mb-0" style="font-size:15px; color:var(--sh-slate-900);">Mục tiêu học tập của tôi</h3>
      <button class="btn-primary-sh" data-bs-toggle="modal" data-bs-target="#addGoalModal">
        <i class="bi bi-plus-lg"></i>Thêm mục tiêu
      </button>
    </div>

    <div class="row g-3">
      @{
        var goals = new[]
        {
          new { title="Đạt 9.0 môn Toán HK1", subject="Toán", current=8.4, target=9.0, deadline="30/12/2026", status="In progress", color="indigo" },
          new { title="Cải thiện Vật lý lên 8.5", subject="Vật lý", current=8.1, target=8.5, deadline="30/12/2026", status="In progress", color="indigo" },
          new { title="Lịch sử đạt 8.0", subject="Lịch sử", current=7.5, target=8.0, deadline="30/12/2026", status="In progress", color="amber" },
          new { title="Tiếng Anh – Duy trì 9.0", subject="Tiếng Anh", current=9.0, target=9.0, deadline="30/12/2026", status="Completed", color="emerald" },
          new { title="ĐTB chung đạt 8.8", subject="Toán", current=8.4, target=8.8, deadline="30/12/2026", status="In progress", color="indigo" },
        };
      }
      @foreach (var g in goals)
      {
        var pct = (int)Math.Min(100, (g.current / g.target) * 100);
        var isDone = g.status == "Completed";
        var barColor = isDone ? "var(--sh-emerald-500)" : "var(--sh-indigo-600)";
        <div class="col-12 col-md-6">
          <div class="sh-card p-4 @(isDone ? "border-success" : "")">
            <div class="d-flex justify-content-between align-items-start gap-3">
              <div class="flex-grow-1 overflow-hidden">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <h4 class="fw-bold mb-0 truncate" style="font-size:13px; color:var(--sh-slate-900);">@g.title</h4>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3" style="font-size:11px; color:var(--sh-slate-500);">
                  <span class="subject-badge subject-@(g.subject.ToLower().Replace(" ", "").Replace("ị","i").Replace("é","e"))">@g.subject</span>
                  <span><i class="bi bi-calendar3 me-1"></i>Hạn: @g.deadline</span>
                </div>
                <!-- Score comparison -->
                <div class="d-flex align-items-center gap-3 mb-2">
                  <div class="text-center">
                    <div class="fw-black" style="font-size:20px; color:var(--sh-slate-900);">@g.current</div>
                    <div style="font-size:10px; color:var(--sh-slate-500);">Hiện tại</div>
                  </div>
                  <i class="bi bi-arrow-right" style="color:var(--sh-slate-400);"></i>
                  <div class="text-center">
                    <div class="fw-black" style="font-size:20px; color:var(--sh-indigo-600);">@g.target</div>
                    <div style="font-size:10px; color:var(--sh-slate-500);">Mục tiêu</div>
                  </div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between mb-1" style="font-size:10px; color:var(--sh-slate-500);">
                      <span>Tiến trình</span>
                      <span class="fw-bold" style="color:@barColor;">@pct%</span>
                    </div>
                    <div class="sh-progress">
                      <div class="sh-progress-bar" style="width:@pct%; background:@barColor;"></div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="d-flex flex-column align-items-end gap-2 flex-shrink-0">
                <span class="px-2 py-0 rounded-full fw-bold"
                      style="font-size:10px; background:@(isDone ? "var(--sh-emerald-100)" : "var(--sh-indigo-100)"); color:@(isDone ? "var(--sh-emerald-700)" : "var(--sh-indigo-700)");">
                  @(isDone ? "✅ Hoàn thành" : "⏳ Đang thực hiện")
                </span>
                <div class="d-flex gap-1">
                  <button class="btn-icon-sh" title="Chỉnh sửa"><i class="bi bi-pencil"></i></button>
                  <button class="btn-icon-sh danger"
                          onclick="confirmDelete('@g.title')"
                          title="Xóa mục tiêu"><i class="bi bi-trash3"></i></button>
                </div>
              </div>
            </div>
          </div>
        </div>
      }
    </div>
  </div>

</div>

<!-- ── Add Grade Modal ── -->
<div class="modal fade" id="addGradeModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" style="font-size:14px;"><i class="bi bi-journal-plus me-2"></i>Nhập điểm mới</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-6">
            <label class="sh-label">Môn học</label>
            <select class="sh-input">
              <option>Toán</option><option>Vật lý</option><option>Hóa học</option>
              <option>Ngữ văn</option><option>Tiếng Anh</option><option>Sinh học</option>
              <option>Lịch sử</option><option>Địa lý</option><option>Tin học</option>
            </select>
          </div>
          <div class="col-6">
            <label class="sh-label">Loại kiểm tra</label>
            <select class="sh-input">
              <option>Miệng / 15 phút</option>
              <option>1 tiết</option>
              <option>Giữa kỳ</option>
              <option>Cuối kỳ</option>
            </select>
          </div>
          <div class="col-6">
            <label class="sh-label" for="grade-score">Điểm số (0 – 10)</label>
            <input id="grade-score" type="number" min="0" max="10" step="0.25"
                   class="sh-input grade-score-input" placeholder="8.5" />
          </div>
          <div class="col-6">
            <label class="sh-label">Học kỳ</label>
            <select class="sh-input">
              <option>Học kỳ 1</option>
              <option>Học kỳ 2</option>
            </select>
          </div>
          <div class="col-12">
            <label class="sh-label">Ngày kiểm tra</label>
            <input type="date" class="sh-input" value="2026-09-09" />
          </div>
        </div>
      </div>
      <div class="modal-footer gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn-primary-sh"
                data-bs-dismiss="modal"
                onclick="showToast('Đã lưu điểm thành công!', 'success')">
          <i class="bi bi-floppy me-1"></i>Lưu điểm
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Add Goal Modal ── -->
<div class="modal fade" id="addGoalModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" style="font-size:14px;"><i class="bi bi-trophy me-2"></i>Thêm mục tiêu học tập</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="sh-label" for="goal-title">Tên mục tiêu</label>
          <input id="goal-title" type="text" class="sh-input" placeholder="Ví dụ: Đạt 9.0 môn Toán HK1" />
        </div>
        <div class="row g-3 mb-3">
          <div class="col-6">
            <label class="sh-label">Môn học</label>
            <select class="sh-input">
              <option>Toán</option><option>Vật lý</option><option>Hóa học</option>
              <option>Ngữ văn</option><option>Tiếng Anh</option><option>Sinh học</option>
            </select>
          </div>
          <div class="col-3">
            <label class="sh-label" for="goal-current">Điểm hiện tại</label>
            <input id="goal-current" type="number" min="0" max="10" step="0.1" class="sh-input" placeholder="8.4" />
          </div>
          <div class="col-3">
            <label class="sh-label" for="goal-target">Điểm mục tiêu</label>
            <input id="goal-target" type="number" min="0" max="10" step="0.1" class="sh-input" placeholder="9.0" />
          </div>
        </div>
        <div>
          <label class="sh-label" for="goal-deadline">Hạn hoàn thành</label>
          <input id="goal-deadline" type="date" class="sh-input" value="2026-12-30" />
        </div>
      </div>
      <div class="modal-footer gap-2">
        <button type="button" class="btn-secondary-sh" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn-primary-sh"
                data-bs-dismiss="modal"
                onclick="showToast('Đã thêm mục tiêu học tập!', 'success')">
          <i class="bi bi-trophy me-1"></i>Lưu mục tiêu
        </button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
function gradeTab(btn, tabId) {
  document.querySelectorAll('.nav-link').forEach(b => {
    b.style.cssText = 'font-size:12px;color:var(--sh-slate-500);border:0;background:transparent;padding:8px 16px;font-weight:600;';
    b.classList.remove('active');
  });
  btn.style.cssText = 'font-size:12px;font-weight:700;color:var(--sh-indigo-600);border-bottom:2px solid var(--sh-indigo-600);border-top:0;border-left:0;border-right:0;background:transparent;padding:8px 16px;';
  document.getElementById('grades-tab').style.display = tabId === 'grades-tab' ? 'block' : 'none';
  document.getElementById('goals-tab').style.display = tabId === 'goals-tab' ? 'block' : 'none';
}
</script>
}
